
exampleFunction :: returnType(x : int)
	#mod returnType = int;
{
	return x;
}

otherFunction :: int(x : int){
	return x;
}

#import Builtin.Print;

main ::(){
	// Uses default mod-values if none passed
	y = exampleFunction(5);
	printl(w); // prints: 5
	// When passing mod-values, you must specify their name (they are unordered)
	z = exampleFunction<returnType=char>('w');
	printl(z); // prints: w


	// Redefining function, then setting back to original
	exampleFunction = otherFunction;
	// revert to original body:
	exampleFunction = origin(exampleFunction);
	// or
	exampleFunction = exampleFunction.origin;

	// The mod-values stay with the original function body
	z = exampleFunction('w'); // returnType was set to char already when last used
	printl(z); // prints: w

	// You can set mod-values like member variables:
	exampleFunction.returnType = int;
}
