
#import Rendering.Raylib;

main :: () {
	InitWindow(800, 450, "Hello, raylib from ASA!");
	SetTargetFPS(60);

	while (WindowShouldClose() == false) {
		BeginDrawing();
			ClearBackground(BLACK);
			DrawText("Hello, World!", 190, 200, 30, WHITE);
			DrawFPS(10, 10);
		EndDrawing();
	}

	CloseWindow();
}


