
#import Builtin.*;

#import Builtin.List;

csv :: struct{
    columns : list<string> = list<string>();
    rowData : list<string> = list<string>();

    load :: bool(path : const string){
        f : File = File(path, "r");

        if(f.isOpen){
            printl(f"File path: {f.path}");
        }
    }
}

main :: (){
    c : csv = csv("sample.csv");
}


