
#use Builtin.*;

local :: module{
    DEF :: 182;
}

i32 :: int32;
someAlias :: "aliased string";

ABC :: 40;

TEST_MACRO_1 :: {printl("Macro works!");};

TEST_MACRO_2 :: (){ printl("Macro 2 works!") };

// Completely rename TEST_MACRO_1 to RENAMED_MACRO, undefining its previous name
RENAMED_MACRO ::> TEST_MACRO_1; 

#use Rendering.Raylib;


main :: (){

    GHI :: 12;

    TEST_MACRO_1; // This is equivalent to:
    // {
    //     printl("Macro works!");
    // }

    TEST_MACRO_2(); // This is literally just a function

    // i32 is an alias for int32
    i : int32 = 6;
    j : i32 = 8;

    variantVar<T : type> : T;

    printl(j);

    printl(ABC);

    printl(GHI);

    printl(local.DEF);

    printl(someAlias);

    PRINTALIAS :: printl;

    PRINTALIAS("print alias works!");

    someArray : array<int, 5> = array<int, 5>();

    //for(i in 0..5)
    //someArray[i] = i;

    //printl(someArray[0]);

    //printl(#nameof(someArray) + " : " + #typeof(someArray));

    someList : list<int> = list<int>();

    someList.append(5);
    someList.append(3);
    someList.append(0);
    someList.append(0);
    someList.append(10);

    //if 2 printl("This should absolutely not print"); 

    if(2){
        printl("This should print");
    }

    printl("listvals:");
    for(i in 0..5)
        printl(someList[i]);

    //r : range = 0..5;

    //for(i in r){
    //  printl(i);
    //}

    return;
}




