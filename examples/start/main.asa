#import "Basic/Print";
#import "Rendering/Window";

#file "function_redefine.asa";

/*
You can import the full library like:
#import "Rendering";

Or individual components:
#import "Rendering/Window";
*/

customObject :: struct {
	a :: int = 5;
	b :: int = 1;
}

main :: (){
	print("Hello World!");
	
	for (i : 0..100){  // for(<range>){} automatically iterates through range type
		print("%\n", i);
	}
	for (i : 0..(100+i)){  // for(<range>){} automatically iterates through range type
		print("%\n", i);
		i += 1;
	}
	i = ((1.1+5.2)*1+2)-9;
	while(i < 4){
		for(j : 0..6){
			if(j == 3){
				break 1;
			}
		}
		i++;
	}


	if(true){
		print("Hello, again!");
	}

	w = window_create("New window", 512, 512);

	// Test the functionality of redefining a function at runtime.
	testRedefineFunction();
}

multiply :: int (int x, int y){
	return x * y;
}


#run build();








