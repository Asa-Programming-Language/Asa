create::string() #inline; #replaceable; {
	return *(#new string);
}
create::string(c : *char) #inline; {
	s : string = string();
	puts("Creating new string from *char\n");

	s.tS.x = 5;
	
	len : uint32 = 0;
	for(i : 0..4_294_967_296){
		//if(c[i] == '\0')
		//	break;
		len++;
	}
	s.address = malloc(len);
	for(i : 0..len){
		s.address[i] = 'A';
		//s.address[i] = c[i];
	}
	puts("Done!\n");
	s.length = len;
}

operator|| :: bool(a : bool, b : bool) #inline; #hideast {
	if(a){
		return true;
	}
	else if(b){
		return true;
	}
	return false;
}

