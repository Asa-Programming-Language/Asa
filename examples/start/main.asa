printint:: (n : uint64) {
	putchar(48+n);
}

modifyReference::(n : ref int){
	n = 4;
}
modifyReference::(n : ref float){
	n = 4;
}

operator[] :: (x : int, y : int){
	puts("Bracket overload works!\n");
}

newline::(){
	putchar(10);
}

