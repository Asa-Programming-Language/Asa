/*
You can import the full library like:
#import Rendering;

Or individual components:
#import Rendering.Window;
*/

string :: struct {
	c : int;
}
string::string(){
	return *(#new string);
}

operator|| :: bool(a : bool, b : bool) #inline {
	if(a){
		return true;
	}
	else if(b){
		return true;
	}
	return false;
}

