
#import Builtin.Print;
#import Builtin.Math;
#import Rendering.Raylib;
#import Builtin.String;


@version(1):
gameObject :: struct{
	position : Vector3;
	rotation : Vector3;
	scale    : Vector3;
	pivot    : Vector3;
	velocity : Vector3;
}

isColliding :: bool(a : gameObject, b : gameObject){
	return (abs(a.position.x - b.position.x) < a.scale.x/2 + b.scale.x/2 && abs(a.position.y - b.position.y) < a.scale.y/2 + b.scale.y/2);
}

player : gameObject = gameObject();

moveSpeed : float = 500;
turnSpeed : float = 20;

distances : *float; // List of distances from camera to collision, left of screen to right

SCREEN_W = 800;
SCREEN_H = 450;

FONT_SCALE = 90;

LEVEL = "\
###################
#.................#
#....#......#.....#
#....#......#.....#
#...........###.###
#....#......#.....#
#....#............#
###################
";

main:: (){
	InitWindow(SCREEN_W, SCREEN_H, "ASA 3D Raycaster");
	SetTargetFPS(60);
	printl(LEVEL);

	distances = malloc(SCREEN_W*#sizeof(float));

	player.pivot = Vector3(0.5, 0.5, 0.5);
	player.scale = Vector3(15, 100);
	player.position = Vector3(10, SCREEN_H/2);

	while (WindowShouldClose() == false) {
		BeginDrawing();
			ClearBackground(BLACK);
			DrawFPS(0,0);

			update(GetFrameTime());
		EndDrawing();
	}

	CloseWindow();
}

getLevelValue :: char(x : int, y : int, level : ref string){
	// Find row width by scanning to first newline
	width : int = 0;
	for (i : 0..int(level.length)) {
		if (level[i] == '\n') {
			width = i;
			break;
		}
	}
	if (width == 0) { return char(0); }

	idx : int = y * (width + 1) + x;
	if (idx < 0 || idx >= int(level.length)) { return char(0); }

	return level[idx];
}


update :: (dT : float){
	
	// For each column, send out 1 ray
	for(i : 0..SCREEN_W){
		// Rotate by player.rotation.y, radians
		directionOriginal = Vector3(0, 0, 1); // Vector pointing forward
		directionNew = Vector3();

		directionNew.x = directionOriginal.x * cos(player.rotation.y) - directionOriginal.z * sin(player.rotation.y);
		directionNew.y = directionOriginal.x * sin(player.rotation.y) + directionOriginal.z * cos(player.rotation.y);

		for(j : 0..1000){
			offset = j/4.0;
			testPos = offset * directionNew;
			v = getLevelValue(testPos.x, testPos.y, LEVEL);

			if(v == '.'){
				continue;
			}
			else if(v == 0){
				distances[i] = 1000;
				break;
			}
			else if(v == '#'){
				distances[i] = offset;
				break;
			}
		}
	}

	for(i : 0..SCREEN_W){
		wallHeight = SCREEN_H/(distances[i] + 1);
		DrawLine(i, SCREEN_H/2-wallHeight/2, i, SCREEN_H/2+wallHeight/2, WHITE);
	}
	

	//// Left paddle input
	//if(IsKeyDown(KEY_W) && paddle_0.position.y-paddle_0.scale.y*paddle_0.pivot.y > 0)
	//	paddle_0.position.y += -moveSpeed * dT;
	//else if(IsKeyDown(KEY_S) && paddle_0.position.y+paddle_0.scale.y*paddle_0.pivot.y < SCREEN_H)
	//	paddle_0.position.y += moveSpeed * dT;

	// Arrow key turning
	if(IsKeyDown(KEY_RIGHT))
		player.rotation.y += turnSpeed * dT;
	else if(IsKeyDown(KEY_LEFT))
		player.rotation.y += -turnSpeed * dT;
	
	//// Ball move
	//ball.position += ball.velocity * dT;

	//// Ball bounce
	//if(ball.position.y + ball.scale.y/2 >= SCREEN_H || ball.position.y - ball.scale.y/2 <= 0){
	//	ball.velocity.y *= -1;
	//	ball.position += ball.velocity * dT;
	//}

	//// Ball hit/goals
	//if(isColliding(ball, paddle_0)){
	//	ball.velocity.x = -ball.velocity.x;
	//	ball.position.x = paddle_0.position.x + paddle_0.scale.x/2 + ball.scale.x/2;
	//}
	//else if(isColliding(ball, paddle_1)){
	//	ball.velocity.x = -ball.velocity.x;
	//	ball.position.x = paddle_1.position.x - paddle_1.scale.x/2 - ball.scale.x/2;
	//}
	//else if(ball.position.x - ball.scale.x/2 <= 0){
	//	ball.position = Vector3(SCREEN_W/2, SCREEN_H/2);
	//	score_1 += 1;
	//}
	//else if(ball.position.x + ball.scale.x/2 >= SCREEN_W){
	//	ball.position = Vector3(SCREEN_W/2, SCREEN_H/2);
	//	score_0 += 1;
	//}

	//drawPaddle(paddle_0);
	//drawPaddle(paddle_1);
	//drawBall();

	//DrawText(string(score_0), SCREEN_W/4-FONT_SCALE/2, 10, FONT_SCALE, WHITE);
	//DrawText(string(score_1), 3*SCREEN_W/4-FONT_SCALE/2, 10, FONT_SCALE, WHITE);

	//drawNet();
}
