levelWidth  : int = 0;
levelHeight : int = 0;
getLevelWidthHeight :: (){
	for (i : 0..int(LEVEL.length)) {
		if (LEVEL[i] == '\n') {
			if (levelWidth == 0) { levelWidth = i; }
			levelHeight += 1;
		}
	}
}

drawMinimap :: () {
	if (levelWidth == 0) { return; }

	cellSize : const uint = int(6.0 * mapScale);
	padding  : const uint = int(4.0 * mapScale);
	mapW     : const uint = levelWidth  * cellSize;
	mapH     : const uint = levelHeight * cellSize;
	offX     : const uint = SCREEN_W - mapW - padding;
	offY     : const uint = padding;

	DrawRectangle(offX, offY, mapW, mapH, Color32(10, 10, 10));

	for (row : 0..levelHeight) {
		for (col : 0..levelWidth) {
			c = checkLevelValue(col, row);
			if (c == '#') {
				DrawRectangle(offX + col*cellSize, offY + row*cellSize, cellSize-1, cellSize-1, Color32(180, 180, 180));
			}
			else if (c == 'D') {
				DrawRectangle(offX + col*cellSize, offY + row*cellSize, cellSize-1, cellSize-1, Color32(200, 140, 60));
			}
		}
	}

	px : int = offX + int(player.position.x * float(cellSize));
	pz : int = offY + int(player.position.z * float(cellSize));
	dx : int = int(-sin(player.rotation.y) * 8.0 * mapScale);
	dz : int = int(cos(player.rotation.y) * 8.0 * mapScale);
	DrawLine(px, pz, px + dx, pz + dz, Color32(255, 220, 0));
	DrawCircle(px, pz, 2.5 * mapScale, Color32(255, 220, 0));
}

// Try to move by (dx, dz), resolving X and Z axes independently so the player slides along walls
tryMove :: (dx : const float, dz : const float) {
	r : float = playerRadius;
	newX : float = player.position.x + dx;
	newZ : float = player.position.z + dz;

	marginX : float = r;
	if (dx < 0.0) { marginX = -r; }
	lvl = checkLevelValue(int(newX + marginX), int(player.position.z));
	if (lvl == '.' || lvl == 'O') {
		player.position.x = newX;
	}

	marginZ : float = r;
	if (dz < 0.0) { marginZ = -r; }
	lvl = checkLevelValue(int(player.position.x), int(newZ + marginZ));
	if (lvl == '.' || lvl == 'O') {
		player.position.z = newZ;
	}
}

update :: (dT : const float){
	// Flat Wolfenstein-style ceiling and floor
	DrawRectangle(0, 0,          SCREEN_W, SCREEN_H/2, Color32(74, 74, 74));
	DrawRectangle(0, SCREEN_H/2, SCREEN_W, SCREEN_H/2, Color32(45, 45, 45));

	// Projection plane distance: makes 1-unit walls appear square
	projDist : const float = float(SCREEN_W) * 0.5 / tanf(float(FOV) * 0.5);

	// Cast one ray per screen column
	for(i : 0..SCREEN_W){
		player.rotation.y = wrap(player.rotation.y, -2.0*PI, 2.0*PI);
		subRayAngle = wrap((float(i)/float(SCREEN_W) - 0.5) * FOV, -2.0*PI, 2.0*PI);
		rayAngle    = wrap(player.rotation.y + subRayAngle, -2.0*PI, 2.0*PI);

		directionNew = Vector3(0, 0, 0);
		directionNew.x = -sin(rayAngle);
		directionNew.z = cos(rayAngle);
		directionNew.normalize();

		distances[i] = 9999.0;

		rdx : float = directionNew.x;
		rdz : float = directionNew.z;

		deltaDistX : float = 0.0;
		deltaDistZ : float = 0.0;
		if (abs(rdx) > 0.000001) { deltaDistX = abs(1.0 / rdx); } else { deltaDistX = 9999999.0; }
		if (abs(rdz) > 0.000001) { deltaDistZ = abs(1.0 / rdz); } else { deltaDistZ = 9999999.0; }

		mapX : float = floorf(player.position.x);
		mapZ : float = floorf(player.position.z);

		fracX : float = player.position.x - mapX;
		fracZ : float = player.position.z - mapZ;

		stepX : int = 0;
		stepZ : int = 0;
		sideDistX : float = 0.0;
		sideDistZ : float = 0.0;

		if (rdx < 0.0) {
			stepX = -1;
			sideDistX = fracX * deltaDistX;
		} else {
			stepX = 1;
			sideDistX = (1.0 - fracX) * deltaDistX;
		}
		if (rdz < 0.0) {
			stepZ = -1;
			sideDistZ = fracZ * deltaDistZ;
		} else {
			stepZ = 1;
			sideDistZ = (1.0 - fracZ) * deltaDistZ;
		}

		hitWall : *Wall = void;
		hitChar : char = char(0);
		side : uint8 = 0;
		hitDoorFrame : bool = false;
		hitInnerFrame : bool = false;
		doorHitCoord : float = 0.0;
		hasDoorHitCoord : bool = false;


		for (j : 0..100) {
			currentWall : *Wall = getLevelValue(mapX, mapZ);
			if(currentWall != void){
				if(currentWall.style == 2){
					// If the ray is already inside a door cell, crossing a boundary perpendicular
					// to the door panel should hit the doorway threshold immediately.
					exitsThroughThreshold : bool = (currentWall.rotation == 0 && sideDistX < sideDistZ) || (currentWall.rotation == 1 && sideDistZ <= sideDistX);
					if(exitsThroughThreshold){
						hitWall = currentWall;
						hitDoorFrame = true;
						if(currentWall.rotation == 0){
							side = 1;
							doorHitCoord = player.position.z + sideDistX * rdz;
							hasDoorHitCoord = true;
							sideDistX += deltaDistX;
						} else {
							side = 0;
							doorHitCoord = player.position.x + sideDistZ * rdx;
							hasDoorHitCoord = true;
							sideDistZ += deltaDistZ;
						}
						break;
					}
				}
			}

			if (sideDistX < sideDistZ) {
				sideDistX += deltaDistX;
				mapX += stepX;
				side = 1;
			} else {
				sideDistZ += deltaDistZ;
				mapZ += stepZ;
				side = 0;
			}
			hitWall = getLevelValue(mapX, mapZ);

			if(hitWall != void){
				if(hitWall.style == 2){
					// rotation=0: door panel faces N/S (hit via Z-step, side=0)
					// rotation=1: door panel faces E/W (hit via X-step, side=1)
					isDoorFace : bool = (hitWall.rotation == 0 && side == 0) || (hitWall.rotation == 1 && side == 1);
					if(isDoorFace){
						// Advance ray to the near face of the door panel.
						// With thickness T, the near face is (0.5 - T/2) past the entry boundary.
							panelThick : float = 0.1;
							panelFaceOffset : float = 0.5 - panelThick * 0.5;
							if(side == 0){
								panelFaceDist : float = (sideDistZ - deltaDistZ) + deltaDistZ * panelFaceOffset;
								if(sideDistX < panelFaceDist){
									// The ray leaves the door cell through the left/right jamb before
									// reaching the centered door plane, so draw the threshold wall.
									side = 1;
									sideDistX += deltaDistX;
									hitDoorFrame = true;
								} else {
									sideDistZ += deltaDistZ * panelFaceOffset;
									hitDoorFrame = false;
								}
							}
							else{
								panelFaceDist : float = (sideDistX - deltaDistX) + deltaDistX * panelFaceOffset;
								if(sideDistZ < panelFaceDist){
									side = 0;
									sideDistZ += deltaDistZ;
									hitDoorFrame = true;
								} else {
									sideDistX += deltaDistX * panelFaceOffset;
									hitDoorFrame = false;
								}
							}
					} else {
						// Ray entered from perpendicular side -> outer frame face
						// Check if ray hits the panel edge (gives door apparent thickness)
						panelHalfWidth : float = 0.05;
						perpEntryDist : float = 0.0;
						perpEntryHit  : float = 0.0;
						if(side == 0){
							perpEntryDist = sideDistZ - deltaDistZ;
							perpEntryHit  = player.position.x + perpEntryDist * rdx;
						} else {
							perpEntryDist = sideDistX - deltaDistX;
							perpEntryHit  = player.position.z + perpEntryDist * rdz;
						}
						perpEntryHit = perpEntryHit - floorf(perpEntryHit);
						if(perpEntryHit < 0.0) perpEntryHit += 1.0;
						if(abs(perpEntryHit - 0.5) < panelHalfWidth){
							hitDoorFrame = false; // panel edge: show door.png
						} else {
							hitDoorFrame = true;  // doorside.png
						}
					}
					break;
				}
				else
					break;
			}
			//hitChar = checkLevelValue(mapX, mapZ);
			//if (hitChar != '.') { break; }
		}

		if (side == 1 || side == 3) {
			distances[i] = sideDistX - deltaDistX;
		} else {
			distances[i] = sideDistZ - deltaDistZ;
		}

			if (hitWall != void) {
				wallHeight : int = int(projDist / distances[i]);
				wallTop    : int = SCREEN_H/2 - wallHeight/2;

				// Compute texture U: fractional position where ray hit the wall face
				wallHit : float = 0.0;
				if(side == 1 || side == 3) wallHit = player.position.z + distances[i] * rdz;
				else                       wallHit = player.position.x + distances[i] * rdx;
				wallHit = wallHit - floorf(wallHit);
				// Mirror so texture doesn't flip with ray direction
				if ((side == 1 || side == 3) && rdx > 0.0) { wallHit = 1.0 - wallHit; } // E/W
				if ((side == 0 || side == 2) && rdz < 0.0) { wallHit = 1.0 - wallHit; } // N/S

			// Pick texture and tint (darken N/S walls for depth cue)
			srcTexPtr : *Texture2D = hitWall.a;
			if(hitDoorFrame){ srcTexPtr = hitWall.b; }
			srcTex : Texture2D = *srcTexPtr;
			tint : Color32 = WHITE;
			if(side == 0 || side == 2) tint = Color32(128, 128, 128); // N/S walls get depth cue 

			// Draw the wall column as a single GPU texture strip
			srcX : float = wallHit * srcTex.width;
			DrawTexturePro(srcTex,
				Rect(srcX, 0.0, 1.0, srcTex.height),
				Rect(i, wallTop, 1.0, wallHeight),
				Vector2(0.0, 0.0), 0.0, tint);
		}
	}

	// WASD movement with wall collision
	spd : float = dT * moveSpeed;
	if(IsKeyDown(KEY_W))
		tryMove(-sinf(player.rotation.y) * spd,  cosf(player.rotation.y) * spd);
	if(IsKeyDown(KEY_S))
		tryMove( sinf(player.rotation.y) * spd, -cosf(player.rotation.y) * spd);
	if(IsKeyDown(KEY_A))
		tryMove( cosf(player.rotation.y) * spd,  sinf(player.rotation.y) * spd);
	if(IsKeyDown(KEY_D))
		tryMove(-cosf(player.rotation.y) * spd, -sinf(player.rotation.y) * spd);

	// Arrow key turning
	if(IsKeyDown(KEY_RIGHT))
		player.rotation.y += turnSpeed * dT;
	else if(IsKeyDown(KEY_LEFT))
		player.rotation.y += -turnSpeed * dT;

}
