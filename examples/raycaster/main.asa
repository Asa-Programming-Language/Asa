
#import Builtin.Print;
#import Builtin.Math;
#import Rendering.Raylib;
#import Builtin.String;


@version(1):
gameObject :: struct{
	position : Vector3;
	rotation : Vector3;
	scale    : Vector3;
	pivot    : Vector3;
	velocity : Vector3;
}

isColliding :: bool(a : gameObject, b : gameObject){
	return (abs(a.position.x - b.position.x) < a.scale.x/2 + b.scale.x/2 && abs(a.position.y - b.position.y) < a.scale.y/2 + b.scale.y/2);
}

player : gameObject = gameObject();

moveSpeed : float = 3.5;
turnSpeed : float = 2.5;

distances : *float = void; // Perpendicular wall distances, one per screen column

TEX_SIZE   : int = 128;
wallImage : Image = Image();
doorImage : Image = Image();

SCREEN_W : int = 800;
SCREEN_H : int = 450;

FOV = 1.0;

LEVEL = "###################
#....#............#
#....#......#.....#
#....#......#.....#
D...........###.###
#....#......#.....#
#.................#
#.................#
#.................#
#....#............#
#....#............#
#....#............#
#.................#
#.................#
#.................#
#.................#
#.................#
#.................#
########D##########
";

generateTextures :: () {
	wallImage = LoadImage("stone.png");
	doorImage = LoadImage("door.png");
}

main:: (){
	InitWindow(SCREEN_W, SCREEN_H, "ASA Wolfenstein");
	SetTargetFPS(60);

	distances = malloc(SCREEN_W * #sizeof(float));
	generateTextures();

	player.pivot    = Vector3(0.5, 0.5, 0.5);
	player.scale    = Vector3(15, 100);
	player.position = Vector3(9, 0, 5);
	player.rotation = Vector3(0, float(PI), 0); // face north

	while (WindowShouldClose() == false) {
		BeginDrawing();
			ClearBackground(BLACK);
			update(GetFrameTime());
			DrawFPS(0, 0);
		EndDrawing();
	}

	CloseWindow();
}

getLevelValue :: char(x : int, y : int, level : ref string){
	width : int = 0;
	for (i : 0..int(level.length)) {
		if (level[i] == '\n') {
			width = i;
			break;
		}
	}
	if (width == 0) { return char(0); }

	if (x < 0 || x >= width || y < 0 || y >= width) { return 0; }

	idx : int = y * (width + 1) + x;
	if (idx < 0 || idx >= int(level.length)) { return char(0); }

	return level[idx];
}


@hideast:
drawMinimap :: () {
	levelWidth  : int = 0;
	levelHeight : int = 0;
	for (i : 0..int(LEVEL.length)) {
		if (LEVEL[i] == '\n') {
			if (levelWidth == 0) { levelWidth = i; }
			levelHeight += 1;
		}
	}
	if (levelWidth == 0) { return; }

	cellSize : int = 6;
	padding  : int = 4;
	mapW : int = levelWidth  * cellSize;
	mapH : int = levelHeight * cellSize;
	offX : int = SCREEN_W - mapW - padding;
	offY : int = padding;

	DrawRectangle(offX, offY, mapW, mapH, Color32(10, 10, 10));

	for (row : 0..levelHeight) {
		for (col : 0..levelWidth) {
			c = getLevelValue(col, row, LEVEL);
			if (c == '#') {
				DrawRectangle(offX + col*cellSize, offY + row*cellSize, cellSize-1, cellSize-1, Color32(180, 180, 180));
			}
			else if (c == 'D') {
				DrawRectangle(offX + col*cellSize, offY + row*cellSize, cellSize-1, cellSize-1, Color32(200, 140, 60));
			}
		}
	}

	px : int = offX + int(player.position.x * float(cellSize));
	pz : int = offY + int(player.position.z * float(cellSize));
	dx : int = int(-sin(player.rotation.y) * 8.0);
	dz : int = int(cos(player.rotation.y) * 8.0);
	DrawLine(px, pz, px + dx, pz + dz, Color32(255, 220, 0));
	DrawCircle(px, pz, 2.5, Color32(255, 220, 0));
}

update :: (dT : float){
	// Flat Wolfenstein-style ceiling and floor
	DrawRectangle(0, 0,          SCREEN_W, SCREEN_H/2, Color32(74, 74, 74));
	DrawRectangle(0, SCREEN_H/2, SCREEN_W, SCREEN_H/2, Color32(45, 45, 45));

	// Cast one ray per screen column
	for(i : 0..SCREEN_W){
		player.rotation.y = wrap(player.rotation.y, -2.0*PI, 2.0*PI);
		subRayAngle = wrap((float(i)/float(SCREEN_W) - 0.5) * FOV, -2.0*PI, 2.0*PI);
		rayAngle    = wrap(player.rotation.y + subRayAngle, -2.0*PI, 2.0*PI);

		directionNew = Vector3(0, 0, 0);
		directionNew.x = -sin(rayAngle);
		directionNew.z = cos(rayAngle);
		directionNew.normalize();

		distances[i] = 9999.0;

		rdx : float = directionNew.x;
		rdz : float = directionNew.z;

		deltaDistX : float = 0.0;
		deltaDistZ : float = 0.0;
		if (abs(rdx) > 0.0001) { deltaDistX = abs(1.0 / rdx); } else { deltaDistX = 9999999.0; }
		if (abs(rdz) > 0.0001) { deltaDistZ = abs(1.0 / rdz); } else { deltaDistZ = 9999999.0; }

		mapX : float = floorf(player.position.x);
		mapZ : float = floorf(player.position.z);

		fracX : float = player.position.x - mapX;
		fracZ : float = player.position.z - mapZ;

		stepX : int = 0;
		stepZ : int = 0;
		sideDistX : float = 0.0;
		sideDistZ : float = 0.0;

		if (rdx < 0.0) {
			stepX = -1;
			sideDistX = fracX * deltaDistX;
		} else {
			stepX = 1;
			sideDistX = (1.0 - fracX) * deltaDistX;
		}
		if (rdz < 0.0) {
			stepZ = -1;
			sideDistZ = fracZ * deltaDistZ;
		} else {
			stepZ = 1;
			sideDistZ = (1.0 - fracZ) * deltaDistZ;
		}

		if (sideDistX < 0.0001) { sideDistX = deltaDistX; }
		if (sideDistZ < 0.0001) { sideDistZ = deltaDistZ; }

		hitChar : char = char(0);
		side : int = 0;
		for (j : 0..200) {
			if (sideDistX < sideDistZ) {
				sideDistX += deltaDistX;
				mapX += stepX;
				side = 0;
			} else {
				sideDistZ += deltaDistZ;
				mapZ += stepZ;
				side = 1;
			}
			hitChar = getLevelValue(mapX, mapZ, LEVEL);
			if (hitChar != '.') { break; }
		}

		if (side == 0) {
			distances[i] = sideDistX - deltaDistX;
		} else {
			distances[i] = sideDistZ - deltaDistZ;
		}

		if (hitChar == '#' || hitChar == 'D') {
			wallHeight : int = int(float(SCREEN_H) / distances[i]);
			wallTop    : int = SCREEN_H/2 - wallHeight/2;
			wallBottom : int = SCREEN_H/2 + wallHeight/2;

			//printl(wallHeight);

			// Compute texture U: fractional position where ray hit the wall face
			wallHit : float = 0.0;
			if (side == 0) {
				wallHit = player.position.z + distances[i] * rdz;
			} else {
				wallHit = player.position.x + distances[i] * rdx;
			}
			wallHit = wallHit - floorf(wallHit);
			// Mirror so texture doesn't flip with ray direction
			if (side == 0 && rdx > 0.0) { wallHit = 1.0 - wallHit; }
			if (side == 1 && rdz < 0.0) { wallHit = 1.0 - wallHit; }
			texU : int = int(wallHit * float(TEX_SIZE));
			if (texU >= TEX_SIZE) { texU = TEX_SIZE - 1; }

			// Render wall column pixel by pixel with texture
			for (y : wallTop..wallBottom) {
				if (y < 0 || y >= SCREEN_H) continue;


				texV : int = int(float(y - wallTop) * float(TEX_SIZE) / float(wallHeight));
				texV = clamp(texV, 0, TEX_SIZE);
				texU = clamp(texU, 0, TEX_SIZE);
				srcImg = wallImage;
				if (hitChar == 'D') { srcImg = doorImage; }
				srcX : int = texU * srcImg.width  / TEX_SIZE;
				srcY : int = texV * srcImg.height / TEX_SIZE;
				c : Color32 = GetImageColor(srcImg, srcX, srcY);
				tr : uint8 = c.r;
				tg : uint8 = c.g;
				tb : uint8 = c.b;

				// Darken N/S-facing walls for depth cue
				if (side == 1) { tr = tr / 2; tg = tg / 2; tb = tb / 2; }
				color = Color32(tr, tg, tb);
				//printl("rgb: " + int(color.r) + ", " + int(color.g) + ", " + int(color.b) + ", " + int(color.a));
				//printl("rgb: " + color.r + ", " + color.g + ", " + color.b + ", " + color.a);
				DrawPixel(clamp(i, 0, SCREEN_W), clamp(y, 0, SCREEN_H), color);
			}
		}
	}

	// WASD movement
	if(IsKeyDown(KEY_W))
		player.position += Vector3(-sin(player.rotation.y), 0, cos(player.rotation.y)) * (dT * moveSpeed);
	if(IsKeyDown(KEY_S))
		player.position -= Vector3(-sin(player.rotation.y), 0, cos(player.rotation.y)) * (dT * moveSpeed);
	if(IsKeyDown(KEY_A))
		player.position += Vector3(cos(player.rotation.y), 0, sin(player.rotation.y)) * (dT * moveSpeed);
	if(IsKeyDown(KEY_D))
		player.position -= Vector3(cos(player.rotation.y), 0, sin(player.rotation.y)) * (dT * moveSpeed);

	// Arrow key turning
	if(IsKeyDown(KEY_RIGHT))
		player.rotation.y += turnSpeed * dT;
	else if(IsKeyDown(KEY_LEFT))
		player.rotation.y += -turnSpeed * dT;

	drawMinimap();
}
