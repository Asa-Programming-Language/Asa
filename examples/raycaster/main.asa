
#import Builtin.Print;
#import Builtin.Math;
#import Rendering.Raylib;
#import Builtin.String;


@version(2):
GameObject :: struct{
	position : Vector3;
	rotation : Vector3;
	scale    : Vector3;
	pivot    : Vector3;
	velocity : Vector3;
}

NamedTexture :: struct{
	name : string;
	texture : Texture2D;
}

create :: NamedTexture(name : string, texture : Texture2D){
	n = NamedTexture();
	n.name = name;
	n.texture = texture;

	return n;
}

loadNamedTexture :: *NamedTexture(name : string){
	for(i : 0..loadedTexturesCount){
		if(allTextures[i].name == name){
			//printl("loading image, reusing cached \"" + name + "\"");
			return &(allTextures[i]);
		}
	}
	// If it doesnt exist yet, load it and add to allTextures
	printl("loading image for the first time \"" + name + "\"");
	img : Image = LoadImage(name);
	imgPtr : *Image = &img;

	// Set any pixels that match TRANSPARENT_KEY color to transparent
	for(x : 0..img.width)
	for(y : 0..img.height)
		if(GetImageColor(img, x, y) == TRANSPARENT_KEY) // TODO: I tried having img being a *Image, then doing GetImageColor(*img, x, y), but it gave a compiler error
			ImageDrawPixel(imgPtr, x, y, Color32(0, 0, 0, 0));

	allTextures[loadedTexturesCount] = NamedTexture(name, LoadTextureFromImage(img));
	loadedTexturesCount += 1;
	return &allTextures[loadedTexturesCount-1];
}

Wall :: struct{
	a : *Texture2D;
	b : *Texture2D;
	c : *Texture2D;
	d : *Texture2D;
	position : Vector3I;
	rotation : uint8; // 0 -> a,b,c,d is north,east,south,west,  1 -> a,b,c,d is east,south,west,north,   etc.
	style : uint8; // 0=abcd visible full cell,  1=bd visible ac invisible,  2=abcd visible with ac offset to middle for door,  3=abcd visible offset to center
	symbol : char;
}

create :: Wall(symbol : char, a : string, b : string,  c : string,  d : string, position : Vector3I, rotation : uint8, style : uint8){
	w : Wall = Wall();
	w.symbol = symbol;
	w.a = &(loadNamedTexture(a).texture);
	w.b = &(loadNamedTexture(b).texture);
	w.c = &(loadNamedTexture(c).texture);
	w.d = &(loadNamedTexture(d).texture);
	w.position = position;
	w.rotation = rotation;
	w.style = style;
	return w;
}

Entity :: struct{
	a : *Texture2D;
	b : *Texture2D;
	c : *Texture2D;
	d : *Texture2D;
	position : Vector3;
	rotation : uint8; // 0 -> a,b,c,d is north,east,south,west,  1 -> a,b,c,d is east,south,west,north,   etc.
	symbol : char;
}

create :: Entity(symbol : char, a : string, b : string,  c : string,  d : string, position : Vector3, rotation : uint8){
	w : Entity = Entity();
	w.symbol = symbol;
	w.a = &(loadNamedTexture(a).texture);
	w.b = &(loadNamedTexture(b).texture);
	w.c = &(loadNamedTexture(c).texture);
	w.d = &(loadNamedTexture(d).texture);
	w.position = position;
	w.rotation = rotation;
	return w;
}

isColliding :: bool(a : const ref GameObject, b : const ref GameObject){
	return (abs(a.position.x - b.position.x) < a.scale.x/2 + b.scale.x/2 && abs(a.position.y - b.position.y) < a.scale.y/2 + b.scale.y/2);
}

player : GameObject = GameObject();

moveSpeed    : const float = 2.5;
turnSpeed    : const float = 1.5;
playerRadius : const float = 0.5;
mapScale     : const float = 0.5;

distances : *float = void; // Perpendicular wall distances, one per screen column

allTextures : *NamedTexture = void;
loadedTexturesCount = 0;

SCREEN_W  : const int = 320;
SCREEN_H  : const int = 200;
WINDOW_W  : const int = 800;
WINDOW_H  : const int = 450;


TRANSPARENT_KEY  : Color32 = Color32(153, 0, 153);

renderTarget : RenderTexture2D = RenderTexture2D();

FOV : const float = 1.0;

levelObjects : *Wall = void;  // Stores static gameObjects
levelObjectCount = 0;

entities : *Entity = void;  // Stores moving billboarded game objects
entityCount = 0;

LEVEL : const string =
"#########D#########
#....#............#
#....#......#.....#
#....#......#.....#
D...........###.###
#....#......#.....#
#.................#
#.................#
#...........D.....#
#....#............#
#....#...W........#
#....#............#
#.................#
#.................#
#.................#
#.................#
#.................#
#.................#
########D##########
";


loadLevel :: (levelString : const ref string){
	//if(#cast(levelObjects, int) != 0)
	//	free(#cast(levelObjects, *int));
	levelObjects = malloc(levelString.length * 2 * #sizeof(Wall));
	entities = malloc(levelString.length * 0.5 * #sizeof(Wall));

	levelObjectCount = 0;
	x = 0;
	y = 0;
	for (i : 0..int(levelString.length)) {
		levelVal = levelString[i];
		if (levelVal == '\n') {
			x = 0;
			y++;
			continue;
		}
		else if(levelVal == '#'){ // Stone wall
			levelObjects[levelObjectCount++] = Wall(levelVal, "stone.png", "stone.png", "stone.png", "stone.png", Vector3I(x, 0, y), 0, 0);
		}
		else if(levelVal == 'D'){ // Closed door
			direction : uint8 = 0;
			// If left and right neighbors (same row) are walls, door panel faces N/S (rotation=0)
			// Otherwise, door panel faces E/W (rotation=1)
			if(i > 0 && i+1 < int(levelString.length)){
				if(levelString[i-1] == '#' && levelString[i+1] == '#'){
					direction = 0; // E/W neighbors are walls -> panel faces N/S
				}
				else
					direction = 1; // no E/W walls -> panel faces E/W
			}
			levelObjects[levelObjectCount++] = Wall(levelVal, "door.png", "doorside.png", "door.png", "doorside.png", Vector3I(x, 0, y), direction, 2);
		}
		else if(levelVal == 'W'){ // Well object
			entities[entityCount++] = Entity(levelVal, "well.png", "well.png", "well.png", "well.png", Vector3(x, 0, y), 0);
		}

		x++;
	}

}
unloadLevel :: (){
	for (i : 0..int(loadedTexturesCount)) {
		UnloadTexture(allTextures[i].texture);
	}
}

main:: (){
	InitWindow(WINDOW_W, WINDOW_H, "ASA Wolfenstein");
	//SetTargetFPS(60);

	renderTarget = LoadRenderTexture(SCREEN_W, SCREEN_H);
	mapTarget = LoadRenderTexture(SCREEN_W, SCREEN_H);
	distances = malloc(SCREEN_W * #sizeof(float));
	allTextures = malloc(128 * #sizeof(NamedTexture));

	loadLevel(LEVEL);

	getLevelWidthHeight();

	player.pivot    = Vector3(0.5, 0.5, 0.5);
	player.scale    = Vector3(15, 100);
	player.position = Vector3(9, 0, 5);
	player.rotation = Vector3(0, float(PI), 0); // face north

	while (WindowShouldClose() == false) {
		BeginTextureMode(renderTarget);
			ClearBackground(BLACK);
			update(GetFrameTime());
		EndTextureMode();

		BeginTextureMode(mapTarget);
			ClearBackground(Color32(0, 0, 0, 0));
			drawMinimap();
		EndTextureMode();

		BeginDrawing();
			ClearBackground(BLACK);

			DrawTexturePro(renderTarget.texture,
				Rect(0.0, 0.0, float(SCREEN_W), float(-SCREEN_H)),
				Rect(0.0, 0.0, float(WINDOW_W), float(WINDOW_H)),
				Vector2(0.0, 0.0), 0.0, WHITE);

			DrawTexturePro(mapTarget.texture,
				Rect(0.0, 0.0, float(SCREEN_W), float(-SCREEN_H)),
				Rect(0.0, 0.0, float(WINDOW_W), float(WINDOW_H)),
				Vector2(0.0, 0.0), 0.0, WHITE);

			DrawFPS(0, 0);

			DrawText(string(Vector3I(player.position)), 0, WINDOW_H-20, 20, RED);
		EndDrawing();
	}

	UnloadRenderTexture(renderTarget);
	UnloadRenderTexture(mapTarget);
	unloadLevel();
	CloseWindow();
}


checkLevelValue :: char(x : const int, y : const int){
	if(x < 0 || y < 0 || x > levelWidth || y > levelHeight) return 0;
	for (i : 0..levelObjectCount) {
		//if((levelObjects[i]).position.x == x && (levelObjects[i]).position.y == y){ // This way errored, so I'm using the following for now:
		if((levelObjects[i]).position == Vector3I(x, 0, y)){
			// If position matches search position, return it
			return (levelObjects[i]).symbol;
		}
	}
	return '.';
}
getLevelValue :: *Wall(x : const int, y : const int){
	if(x < 0 || y < 0 || x > levelWidth || y > levelHeight) return void;
	for (i : 0..levelObjectCount) {
		if(levelObjects[i].position.x == x && levelObjects[i].position.z == y){
		//if(levelObjects[i].position == Vector3I(x, 0, y)){
			// If position matches search position, return it
			return &(levelObjects[i]);
		}
	}
	return void;
}
