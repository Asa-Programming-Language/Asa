
#use Rendering.Raylib;

@version(1):
gameObject :: struct{
    position : Vector3;
    rotation : Vector3;
    scale    : Vector3;
    pivot    : Vector3;
    velocity : Vector3;
}

@inline:
drawPaddle :: (g : const ref gameObject){
    DrawRectangle(g.position.x - g.scale.x * g.pivot.x, g.position.y - g.scale.y * g.pivot.y, g.scale.x, g.scale.y, WHITE);
}

@inline:
drawBall ::(){
    DrawCircle(ball.position.x, ball.position.y, ball.scale.x/2, WHITE);
}

@inline:
drawNet :: (){
    for(i in 0..SCREEN_H){
        if(i/10 % 2 == 0){
            for(w in -1..2){
                DrawPixel(SCREEN_W/2+w, i, WHITE);
            }
        }
    }
}

@inline:
isColliding :: bool(a : const ref gameObject, b : const ref gameObject){
    return (abs(a.position.x - b.position.x) < a.scale.x/2 + b.scale.x/2 && abs(a.position.y - b.position.y) < a.scale.y/2 + b.scale.y/2);
}

paddle_0 : gameObject = gameObject();
paddle_1 : gameObject = gameObject();
ball : gameObject = gameObject();

score_0 : uint8 = 0;
score_1 : uint8 = 0;

MOVE_SPEED :: 500;
SCREEN_W   :: 800;
SCREEN_H   :: 450;
FONT_SCALE :: 90;

main:: (){
    InitWindow(SCREEN_W, SCREEN_H, "Asa Pong");
    //SetTargetFPS(60);

    paddle_0.pivot = Vector3(0.5, 0.5, 0.5);
    paddle_0.scale = Vector3(15, 100);
    paddle_0.position = Vector3(10, SCREEN_H/2);

    paddle_1.pivot = paddle_0.pivot;
    paddle_1.scale = paddle_0.scale;
    paddle_1.position = Vector3(SCREEN_W-10, SCREEN_H/2);

    ball.position = Vector3(SCREEN_W/2, SCREEN_H/2);
    ball.scale = Vector3(20, 20);
    ball.velocity = Vector3(400, 400);

    while (WindowShouldClose() == false) {
        BeginDrawing();
            ClearBackground(BLACK);
            DrawFPS(0,0);

            update(GetFrameTime());
        EndDrawing();
    }

    CloseWindow();
}


update :: (dT : const float){

    // Left paddle input
    if(IsKeyDown(KEY_W) && paddle_0.position.y-paddle_0.scale.y*paddle_0.pivot.y > 0)
        paddle_0.position.y += -MOVE_SPEED * dT;
    else if(IsKeyDown(KEY_S) && paddle_0.position.y+paddle_0.scale.y*paddle_0.pivot.y < SCREEN_H)
        paddle_0.position.y += MOVE_SPEED * dT;

    // Right paddle input
    if(IsKeyDown(KEY_UP) && paddle_1.position.y-paddle_1.scale.y*paddle_1.pivot.y > 0)
        paddle_1.position.y += -MOVE_SPEED * dT;
    else if(IsKeyDown(KEY_DOWN) && paddle_1.position.y+paddle_1.scale.y*paddle_1.pivot.y < SCREEN_H)
        paddle_1.position.y += MOVE_SPEED * dT;
    
    // Ball move
    ball.position += ball.velocity * dT;

    // Ball bounce
    if(ball.position.y + ball.scale.y/2 >= SCREEN_H || ball.position.y - ball.scale.y/2 <= 0){
        ball.velocity.y *= -1;
        ball.position += ball.velocity * dT;
    }

    // Ball hit/goals
    if(isColliding(ball, paddle_0)){
        ball.velocity.x = -ball.velocity.x;
        ball.position.x = paddle_0.position.x + paddle_0.scale.x/2 + ball.scale.x/2;
    }
    else if(isColliding(ball, paddle_1)){
        ball.velocity.x = -ball.velocity.x;
        ball.position.x = paddle_1.position.x - paddle_1.scale.x/2 - ball.scale.x/2;
    }
    else if(ball.position.x - ball.scale.x/2 <= 0){
        ball.position = Vector3(SCREEN_W/2, SCREEN_H/2);
        score_1 += 1;
    }
    else if(ball.position.x + ball.scale.x/2 >= SCREEN_W){
        ball.position = Vector3(SCREEN_W/2, SCREEN_H/2);
        score_0 += 1;
    }

    drawPaddle(paddle_0);
    drawPaddle(paddle_1);
    drawBall();

    DrawText(string(score_0), SCREEN_W/4-FONT_SCALE/2, 10, FONT_SCALE, WHITE);
    DrawText(string(score_1), 3*SCREEN_W/4-FONT_SCALE/2, 10, FONT_SCALE, WHITE);

    drawNet();
}
