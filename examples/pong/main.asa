
#import Rendering:Window;
#import Rendering:Image;
#import Math:Vectors;
#import Input:Keyboard;


gameObject :: struct{
	position : vector3;
	rotation : vector3;
}

vector2 :: struct{
	x = 0;
	y = 0;

	create:: (){
		return this;
	}
	create:: (xNew, yNew){
		x = xNew;
		y = yNew;
		return this;
	}
	cast:: vector2(vector3 v3){
		x = v3.x;
		y = v3.y;
	}
}

sprite2d :: struct{
	image : image2d = void;
	scale : vector2 = vector2(1, 1);
	position : vector2 = void;
	rotation : float = void;

	create:: (path : string){
		image = create_image2d(path);
	}
	create:: (path : string, s : vector2){
		scale = s;
		image = create_image2d(path);
	}

	draw:: (){
		draw_image(image, position, rotation, scale);
	}
}

paddle :: gameObject :: struct{
	moveSpeed = 1;
	minMax = vector2(0, screen_height);
	sprite = sprite2d("./square.png", vector2(0.2, 1));

	move:: (dT : float){
		nextPosition = position.y + moveSpeed * dT;
		if((nextPosition > position.y && nextPosition<minMax.y) || 
		(nextPosition < position.y && nextPosition>minMax.x))
			position.y = nextPosition;
	}
	draw:: (){
		sprite.position = vector2(position);
		sprite.rotation = rotation.z;
		sprite.draw();
	}
}

ball:: gameObject :: struct{
	moveSpeed = 1;
	minMax = vector2(0, screen_height);
	sprite = sprite2d("./ball.png");

	move :: (dT : float){
		nextPosition = position.y + moveSpeed * dT;
		if((nextPosition > position.y && nextPosition<minMax.y) || 
		(nextPosition < position.y && nextPosition>minMax.x))
			position.y = nextPosition;
	}
	draw :: (){
		sprite.position = vector2(position);
		sprite.rotation = rotation.z;
		sprite.draw();
	}
}

paddles : paddle[] = {paddle(), paddle()};
ball = ball();

main:: (){
	w = window_create("Pong", 512, 512);

	paddles[0].position = vector3(10,              screen_height/2, 0);
	paddles[1].position = vector3(screen_width-10, screen_height/2, 0);

	draw_window(w);
}

// Function called by draw_window method
update:: (dT : float ){
	if(key_down("W"))
		paddles[0].move(dT);
	else if(key_down("S"))
		paddles[0].move(-dT);
	if(key_down(UP_ARROW))
		paddles[1].move(dT);
	else if(key_down(DOWN_ARROW))
		paddles[1].move(-dT);

	paddles[0].draw();
	paddles[1].draw();
}
