#use Rendering.Raylib;

main :: () {
    // Initialize window
    InitWindow(800, 600, "Flappy Bird - Asa Edition");
    SetTargetFPS(60);
    
    // Game variables
    birdY     : float = 0.0;
    birdVelY  : float = 0.0;
    score     : int = 0;
    gameState : int = 0; // 0 = start, 1 = playing, 2 = game over
    
    // Pipe variables
    pipeX     : float = 800.0;
    pipeTopHeight : int = 200;
    pipeBottomY : int = 350; // 150 gap
    pipePassed : bool = false;
    
    // Main game loop
    while (WindowShouldClose() == false) {
        if (gameState == 0) { // Start screen
            if (IsKeyPressed(KEY_SPACE)) {
                gameState = 1;
            }
        } else if (gameState == 1) { // Playing
            // Apply gravity
            birdVelY = birdVelY + 9.81 * 0.016;
            birdY = birdY + birdVelY;
            
            // Bird jump
            if (IsKeyPressed(KEY_SPACE)) {
                birdVelY = -5.0;
            }
            
            // Move pipe
            pipeX = pipeX - 3.0;
            
            // Check if pipe is off screen, reset it
            if (pipeX < -50) {
                pipeX = 800.0;
                pipeTopHeight = GetRandomValue(100, 400);
                pipeBottomY = pipeTopHeight + 150;
                pipePassed = false;
            }
            
            // Simple collision detection
            if (100 + 30 > pipeX && 100 < pipeX + 50) {
                if (birdY < pipeTopHeight || birdY + 30 > pipeBottomY) {
                    gameState = 2;
                }
            }
            
            // Score when passing pipe
            if (pipeX + 50 < 100 && !pipePassed) {
                score = score + 1;
                pipePassed = true;
            }
            
            // Check ground collision
            if (birdY > 570) {
                gameState = 2;
            }
        } else if (gameState == 2) { // Game over
            if (IsKeyPressed(KEY_SPACE)) {
                // Reset game
                birdY = 0.0;
                birdVelY = 0.0;
                score = 0;
                gameState = 0;
                pipeX = 800.0;
                pipeTopHeight = 200;
                pipeBottomY = 350;
                pipePassed = false;
            }
        }
        
        // Draw everything
        BeginDrawing();
        ClearBackground(SKYBLUE);
        
        if (gameState == 0) {
            DrawText("Press SPACE to Start", 250, 250, 20, WHITE);
        } else if (gameState == 1 || gameState == 2) {
            // Draw bird
            DrawRectangle(100, birdY, 30, 30, YELLOW);
            
            // Draw pipes
            DrawRectangle(pipeX, 0, 50, pipeTopHeight, GREEN);
            DrawRectangle(pipeX, pipeBottomY, 50, 600 - pipeBottomY, GREEN);
            
            // Draw ground
            DrawRectangle(0, 570, 800, 30, DARKGREEN);
            
            // Draw score
            DrawText("Score: " + score, 10, 10, 20, WHITE);
        }
        
        if (gameState == 2) {
            DrawText("Game Over! Press SPACE to restart", 200, 250, 20, WHITE);
        }
        
        EndDrawing();
    }
    
    CloseWindow();
}
