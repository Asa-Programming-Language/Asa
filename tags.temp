llvm	src/include/llvm/ADT/AddressRanges.h	/^namespace llvm {$/;"	n
AddressRange	src/include/llvm/ADT/AddressRanges.h	/^class AddressRange {$/;"	c	namespace:llvm
AddressRange	src/include/llvm/ADT/AddressRanges.h	/^  AddressRange() {}$/;"	f	class:llvm::AddressRange
AddressRange	src/include/llvm/ADT/AddressRanges.h	/^  AddressRange(uint64_t S, uint64_t E) : Start(S), End(E) {$/;"	f	class:llvm::AddressRange
start	src/include/llvm/ADT/AddressRanges.h	/^  uint64_t start() const { return Start; }$/;"	f	class:llvm::AddressRange	typeref:typename:uint64_t
end	src/include/llvm/ADT/AddressRanges.h	/^  uint64_t end() const { return End; }$/;"	f	class:llvm::AddressRange	typeref:typename:uint64_t
