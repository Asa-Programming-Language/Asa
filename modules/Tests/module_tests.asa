
// ModuleTests
// Tests for module variable access and nested module access.

@public:
ModuleTests :: module {

	#import Tests.Testing;
	#import_qualified Tests.CompilerImportTest;

	@public:
	NumConsts :: module {
		@public: zero : int = 0;
		@public: one  : int = 1;
		@public: ten  : int = 10;
		@public: neg  : int = -7;
	}

	@public:
	Nested :: module {
		@public:
		Inner :: module {
			@public: val : int = 42;
		}
	}

	// Module-scope variables initialized via function calls
	makeInt :: int() { return 99; }
	Pair :: struct { x : int; y : int; }
	makePair :: Pair() {
		p : Pair = Pair();
		p.x = 10;
		p.y = 20;
		return p;
	}
	@public: funcInitVar  : int  = makeInt();
	@public: ctorInitVar  : Pair = makePair();

	// Untyped module-scope variable declarations (type inferred from rhs)
	@public: untypedInt   = 42;
	@public: untypedFloat = 3.14;
	@public: untypedNeg   = -5;

	// runModuleTests()
	// Runs all module variable access tests.

	@public:
	runModuleTests :: () {
		beginSection("Modules");

		test(NumConsts.zero == 0,       "NumConsts.zero should be 0");
		test(NumConsts.one  == 1,       "NumConsts.one should be 1");
		test(NumConsts.ten  == 10,      "NumConsts.ten should be 10");
		test(NumConsts.neg  == -7,      "NumConsts.neg should be -7");

		test(NumConsts.one + NumConsts.ten == 11,   "one + ten should be 11");
		test(NumConsts.ten * NumConsts.ten == 100,  "ten * ten should be 100");
		test(NumConsts.ten > NumConsts.one,          "ten should be greater than one");

		test(Nested.Inner.val == 42, "Nested.Inner.val should be 42");
		test(CompilerImportTest.x() == 1, "#import_qualified requires module-qualified access");

		test(funcInitVar == 99,         "module var initialized from function call");
		test(ctorInitVar.x == 10,       "module var initialized from constructor (x)");
		test(ctorInitVar.y == 20,       "module var initialized from constructor (y)");

		// Untyped declarations
		test(untypedInt   == 42,        "untyped int global == 42");
		test(untypedFloat == 3.14,      "untyped float global == 3.14");
		test(untypedNeg   == -5,        "untyped negative global == -5");
	}
}
