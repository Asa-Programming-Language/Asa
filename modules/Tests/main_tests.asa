@public:
main :: () {
    runSyntaxTests();
    runArithmeticTests();
    runComparisonTests();
    runBooleanTests();
    runControlFlowTests();
    runIfChainTests();
    runStringTests();
    runReferenceTests();
    runPrintTests();
    runModuleTests();
    runDirectiveTests();
    runAttributeTests();
    runFileTests();
    runExternTests();
    runDefaultParamTests();
    runVariadicTests();
    runMathTests();
    runAccessTests();
    runBitcastTests();
    runCastTests();
    runColor32Tests();
    runStructTests();
    runAddressOfTests();
    runIncrementTests();
    runPointerTests();
    runScopingTests();
    runResultTests();
    runPipeTests();
    runLabeledLoopTests();
    runTypeAliasTests();
    runCompilerDefineTests();
    runEnumTests();
    runVariantTests();
    runArrayTests();
    runBitwiseTests();
    runLoopEdgeCaseTests();
    runIntegerBehaviorTests();
    printSummary();
    return;
}
