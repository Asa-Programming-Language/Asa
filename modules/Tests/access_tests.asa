
// AccessTests
// Tests for the [] access operator on *char buffers, *int buffers, and strings.

@public:
AccessTests :: module {

	#use Tests.Testing;
	#use Builtin.Memory;
	#use Builtin.Casts;
	#use Builtin.String;

	// Module level pointer variables
	g_intbuf  : *int = void;
	g_sentinel : int = 0xABCD;   // adjacent global; must survive writes through g_intbuf
	g_charbuf : *char = void;

	@public:
	runAccessTests :: () {
		beginSection("Access Operator");

		///////////////////////
		// *char buffer       //
		///////////////////////

		buf : *char = malloc(8);
		buf[0] = 'A';
		buf[1] = 'B';
		buf[2] = 'C';
		test(buf[0] == 'A',                   "*char: write and read index 0");
		test(buf[1] == 'B',                   "*char: write and read index 1");
		test(buf[2] == 'C',                   "*char: write and read index 2");

		buf[1] = 'Z';
		test(buf[1] == 'Z',                   "*char: overwrite index 1");
		test(buf[0] == 'A',                   "*char: index 0 unchanged after overwrite");
		test(buf[2] == 'C',                   "*char: index 2 unchanged after overwrite");

		///////////////////////
		// *int buffer        //
		///////////////////////

		ibuf : *int = malloc(40);
		ibuf[0] = 100;
		ibuf[1] = 200;
		ibuf[2] = 300;
		ibuf[3] = -50;
		test(ibuf[0] == 100,                  "*int: write and read index 0");
		test(ibuf[1] == 200,                  "*int: write and read index 1");
		test(ibuf[2] == 300,                  "*int: write and read index 2");
		test(ibuf[3] == -50,                  "*int: write and read negative value");

		ibuf[2] = 999;
		test(ibuf[2] == 999,                  "*int: overwrite index 2");
		test(ibuf[1] == 200,                  "*int: index 1 unchanged after overwrite");

		///////////////////////
		// Sequential fill    //
		///////////////////////

		sbuf : *int = malloc(40);
		for (i in 0..10) {
			sbuf[i] = i * 2;
		}
		test(sbuf[0] == 0,                    "sequential fill: index 0 is 0");
		test(sbuf[5] == 10,                   "sequential fill: index 5 is 10");
		test(sbuf[9] == 18,                   "sequential fill: index 9 is 18");

		sum : int = 0;
		for (i in 0..10) {
			sum += sbuf[i];
		}
		test(sum == 90,                       "sequential fill: sum of 0,2,...,18 is 90");

		///////////////////////
		// Squares via []     //
		///////////////////////

		sqbuf : *int = malloc(20);
		for (i in 0..5) {
			sqbuf[i] = i * i;
		}
		test(sqbuf[0] == 0,                   "squares: index 0 is 0");
		test(sqbuf[1] == 1,                   "squares: index 1 is 1");
		test(sqbuf[2] == 4,                   "squares: index 2 is 4");
		test(sqbuf[3] == 9,                   "squares: index 3 is 9");
		test(sqbuf[4] == 16,                  "squares: index 4 is 16");

		///////////////////////
		// String char access //
		///////////////////////

		s : string = "hello";
		test(s[0] == 'h',                     "string: index 0 is 'h'");
		test(s[1] == 'e',                     "string: index 1 is 'e'");
		test(s[2] == 'l',                     "string: index 2 is 'l'");
		test(s[3] == 'l',                     "string: index 3 is 'l'");
		test(s[4] == 'o',                     "string: index 4 is 'o'");

		t : string = "world";
		test(t[0] == 'w',                     "string: 'world' index 0 is 'w'");
		test(t[4] == 'd',                     "string: 'world' index 4 is 'd'");

		// Count matching characters via string indexing
		vowels : int = 0;
		str : string = "language";
		for (i in 0..int(str.length)) {
			c : char = str[i];
			if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
				vowels += 1;
			}
		}
		test(vowels == 4,                     "string: count vowels in 'language' is 4");

		///////////////////////
		// *char null byte    //
		///////////////////////

		nbuf : *char = malloc(4);
		nbuf[0] = char(72);
		nbuf[1] = char(105);
		nbuf[2] = char(0);
		test(nbuf[0] == char(72),             "*char: value 72 roundtrips via char()");
		test(nbuf[2] == char(0),              "*char: null byte written and read back");

		///////////////////////
		// ref *char buffer   //
		///////////////////////

		cbuf : *char = malloc(8);
		cbuf[0] = 'H';
		cbuf[1] = 'e';
		cbuf[2] = 'l';
		cbuf[3] = 'l';
		cbuf[4] = 'o';
		test(refCharRead(cbuf, 0) == 'H',         "ref *char: read index 0");
		test(refCharRead(cbuf, 4) == 'o',         "ref *char: read index 4");
		test(refCharRead(cbuf, 0) == cbuf[0],     "ref *char: matches direct access at 0");
		test(refCharRead(cbuf, 2) == cbuf[2],     "ref *char: matches direct access at 2");
		refCharWrite(cbuf, 1, 'a');
		test(cbuf[1] == 'a',                      "ref *char: write via ref changes value");
		test(refCharRead(cbuf, 0) == 'H',         "ref *char: other indices unchanged after write");
		test(refCharCount(cbuf, 5, 'l') == 2,     "ref *char: count finds both 'l's");

		///////////////////////
		// ref *int buffer    //
		///////////////////////

		rbuf : *int = malloc(40);
		for (i in 0..5) {
			rbuf[i] = (i + 1) * 10;
		}
		test(refIntRead(rbuf, 0) == 10,           "ref *int: read index 0 is 10");
		test(refIntRead(rbuf, 2) == 30,           "ref *int: read index 2 is 30");
		test(refIntRead(rbuf, 4) == 50,           "ref *int: read index 4 is 50");
		test(refIntRead(rbuf, 0) == rbuf[0],      "ref *int: matches direct access at 0");
		test(refIntRead(rbuf, 3) == rbuf[3],      "ref *int: matches direct access at 3");
		refIntWrite(rbuf, 2, 300);
		test(rbuf[2] == 300,                      "ref *int: write via ref changes value");
		test(refIntRead(rbuf, 2) == 300,          "ref *int: read back written value");
		test(refIntRead(rbuf, 1) == 20,           "ref *int: other indices unchanged after write");
		rbuf[2] = 30;
		test(refIntSum(rbuf, 5) == 150,           "ref *int: sum 10+20+30+40+50 is 150");

		// Compare ref and direct access across a fill
		for (i in 0..5) { rbuf[i] = i * i; }
		allMatch : bool = true;
		for (i in 0..5) {
			if (refIntRead(rbuf, i) != rbuf[i]) { allMatch = false; }
		}
		test(allMatch,                            "ref *int: ref read matches direct read for all indices");

		///////////////////////
		// ref string access  //
		///////////////////////

		hello : string = "hello";
		test(indexRef(hello, 0) == 'h',           "ref string: index 0 via ref param");
		test(indexRef(hello, 4) == 'o',           "ref string: index 4 via ref param");

		world : string = "world";
		test(firstChar(world) == 'w',             "ref string: first char via ref param");
		test(lastChar(world) == 'd',              "ref string: last char via ref param");

		// ref string .length via ref param
		test(refLength(hello) == 5,               "ref string: length of 'hello' is 5");
		test(refLength(world) == 5,               "ref string: length of 'world' is 5");
		empty : string = "";
		test(refLength(empty) == 0,               "ref string: length of '' is 0");
		longer : string = "language";
		test(refLength(longer) == 8,              "ref string: length of 'language' is 8");

		// ref string used in a scan
		test(countChar(hello, 'l') == 2,          "ref string: count 'l' in hello is 2");
		test(countChar(world, 'o') == 1,          "ref string: count 'o' in world is 1");

		///////////////////////
		// global *int        //
		///////////////////////

		g_intbuf = malloc(40);
		for (i in 0..5) {
			g_intbuf[i] = (i + 1) * 100;
		}
		test(g_intbuf[0] == int(100),             "global *int: index 0 is 100");
		test(g_intbuf[1] == int(200),             "global *int: index 1 is 200");
		test(g_intbuf[2] == int(300),             "global *int: index 2 is 300");
		test(g_intbuf[4] == int(500),             "global *int: index 4 is 500");
		g_intbuf[2] = 999;
		test(g_intbuf[2] == int(999),             "global *int: overwrite index 2");
		test(g_intbuf[1] == int(200),             "global *int: adjacent index unaffected");
		// Sentinel must not have been overwritten by any of the above
		test(g_sentinel == 0xABCD,                "global *int: adjacent global not corrupted");

		///////////////////////
		// global *char       //
		///////////////////////

		g_charbuf = malloc(8);
		g_charbuf[0] = 'A';
		g_charbuf[1] = 'B';
		g_charbuf[2] = 'C';
		test(g_charbuf[0] == 'A',                 "global *char: index 0 is 'A'");
		test(g_charbuf[1] == 'B',                 "global *char: index 1 is 'B'");
		test(g_charbuf[2] == 'C',                 "global *char: index 2 is 'C'");
		g_charbuf[1] = 'Z';
		test(g_charbuf[1] == 'Z',                 "global *char: overwrite index 1");
		test(g_charbuf[0] == 'A',                 "global *char: index 0 unchanged after overwrite");
		test(g_sentinel == 0xABCD,                "global *char: adjacent global not corrupted");

		///////////////////////////////
		// Expression index (local)  //
		///////////////////////////////

		// Index with binary expression: buf[i * 2 + j]
		STRIDE : int = 4;
		ROWS   : int = 3;
		ebuf   : *int = malloc(ROWS * STRIDE * 40);
		for (row in 0..ROWS) {
			for (col in 0..STRIDE) {
				ebuf[row * STRIDE + col] = row * 10 + col;
			}
		}
		test(ebuf[0 * STRIDE + 0] == 0,          "expr index: [0*STRIDE+0] == 0");
		test(ebuf[0 * STRIDE + 3] == 3,          "expr index: [0*STRIDE+3] == 3");
		test(ebuf[1 * STRIDE + 0] == 10,         "expr index: [1*STRIDE+0] == 10");
		test(ebuf[1 * STRIDE + 2] == 12,         "expr index: [1*STRIDE+2] == 12");
		test(ebuf[2 * STRIDE + 3] == 23,         "expr index: [2*STRIDE+3] == 23");

		// Overwrite via expression index
		ebuf[1 * STRIDE + 1] = 999;
		test(ebuf[1 * STRIDE + 1] == 999,        "expr index: overwrite [1*STRIDE+1] == 999");
		test(ebuf[1 * STRIDE + 0] == 10,         "expr index: adjacent [1*STRIDE+0] unchanged");
		test(ebuf[1 * STRIDE + 2] == 12,         "expr index: adjacent [1*STRIDE+2] unchanged");

		// Index using sum of two variables
		a : int = 2;
		b : int = 5;
		ebuf[a + b] = 777;
		test(ebuf[a + b] == 777,                 "expr index: [a+b] write and read back");
		test(ebuf[7]     == 777,                 "expr index: [a+b] == [7] same slot");

		///////////////////////////////
		// const ref index           //
		///////////////////////////////

		cibuf : *int = malloc(40);
		for (i in 0..5) { cibuf[i] = (i + 1) * 7; }
		ci0 : int = 0;
		ci2 : int = 2;
		ci4 : int = 4;
		test(constRefIntRead(cibuf, ci0) == 7,          "const ref index: read at 0 is 7");
		test(constRefIntRead(cibuf, ci2) == 21,         "const ref index: read at 2 is 21");
		test(constRefIntRead(cibuf, ci4) == 35,         "const ref index: read at 4 is 35");
		test(constRefIntRead(cibuf, ci0) == cibuf[ci0], "const ref index: matches direct read at 0");
		test(constRefIntRead(cibuf, ci2) == cibuf[ci2], "const ref index: matches direct read at 2");

		cicbuf : *char = malloc(8);
		cicbuf[0] = 'A';
		cicbuf[1] = 'B';
		cicbuf[2] = 'C';
		test(constRefCharRead(cicbuf, ci0) == 'A',      "const ref index: *char read at 0");
		test(constRefCharRead(cicbuf, ci2) == 'C',      "const ref index: *char read at 2");

		// const ref *int buffer (read-only buffer param)
		crbuf : *int = malloc(40);
		for (i in 0..5) { crbuf[i] = i * 3; }
		test(constRefBufRead(crbuf, 0) == 0,            "ref buf: read at 0 is 0");
		test(constRefBufRead(crbuf, 3) == 9,            "ref buf: read at 3 is 9");
		test(constRefBufRead(crbuf, 4) == 12,           "ref buf: read at 4 is 12");
		test(constRefBufSum(crbuf, 5) == 30,            "ref buf: sum 0+3+6+9+12 is 30");

		// const ref string char access
		cs : string = "hello";
		csi0 : int = 0;
		csi4 : int = 4;
		test(constRefStrIndex(cs, csi0) == 'h',         "const ref string: index 0 via const ref");
		test(constRefStrIndex(cs, csi4) == 'o',         "const ref string: index 4 via const ref");

		///////////////////////////////
		// Expression index (global) //
		///////////////////////////////

		g_intbuf = malloc(20 * 40);
		GSTRIDE : int = 5;
		for (row in 0..4) {
			for (col in 0..GSTRIDE) {
				g_intbuf[row * GSTRIDE + col] = row * 100 + col;
			}
		}
		test(g_intbuf[0 * GSTRIDE + 0] == 0,    "global expr index: [0*GSTRIDE+0] == 0");
		test(g_intbuf[1 * GSTRIDE + 2] == 102,  "global expr index: [1*GSTRIDE+2] == 102");
		test(g_intbuf[3 * GSTRIDE + 4] == 304,  "global expr index: [3*GSTRIDE+4] == 304");

		g_intbuf[2 * GSTRIDE + 3] = 12345;
		test(g_intbuf[2 * GSTRIDE + 3] == 12345, "global expr index: overwrite [2*GSTRIDE+3]");
		test(g_intbuf[2 * GSTRIDE + 2] == 202,   "global expr index: adjacent slot unchanged");
	}

	constRefIntRead :: int(buf : *int, i : const ref int) {
		return buf[i];
	}

	constRefCharRead :: char(buf : *char, i : const ref int) {
		return buf[i];
	}

	constRefBufRead :: int(buf : ref *int, i : int) {
		return buf[i];
	}

	constRefBufSum :: int(buf : ref *int, n : int) {
		sum : int = 0;
		for (i in 0..n) { sum += buf[i]; }
		return sum;
	}

	constRefStrIndex :: char(s : const ref string, i : const ref int) {
		return s[i];
	}

	refCharRead :: char(buf : ref *char, i : int) {
		return buf[i];
	}

	refCharWrite :: (buf : ref *char, i : int, val : char) {
		buf[i] = val;
	}

	refCharCount :: int(buf : ref *char, n : int, target : char) {
		count : int = 0;
		for (i in 0..n) {
			if (buf[i] == target) { count += 1; }
		}
		return count;
	}

	refIntRead :: int(buf : ref *int, i : int) {
		return buf[i];
	}

	refIntWrite :: (buf : ref *int, i : int, val : int) {
		buf[i] = val;
	}

	refIntSum :: int(buf : ref *int, n : int) {
		sum : int = 0;
		for (i in 0..n) { sum += buf[i]; }
		return sum;
	}

	indexRef :: char(s : ref string, i : int) {
		return s[i];
	}

	firstChar :: char(s : ref string) {
		return s[0];
	}

	lastChar :: char(s : ref string) {
		idx : int = int(s.length) - 1;
		return s[idx];
	}

	refLength :: uint(s : ref string) {
		return s.length;
	}

	countChar :: int(s : ref string, c : char) {
		count : int = 0;
		for (i in 0..int(s.length)) {
			if (s[i] == c) { count += 1; }
		}
		return count;
	}
}
