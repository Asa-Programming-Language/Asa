
// ComparisonTests
// Tests for comparison and boolean operators.

@public:
ComparisonTests :: module {

	#use Tests.Testing;

	// runComparisonTests()
	// Runs all comparison and boolean operator tests.

	@public:
	runComparisonTests :: () {
		beginSection("Comparisons");

		// Equality
		test(1 == 1,   "1 == 1");
		test(0 == 0,   "0 == 0");

		// Inequality
		test(1 != 2,   "1 != 2");
		test(0 != 1,   "0 != 1");

		// Less / greater
		test(1 < 2,    "1 < 2");
		test(2 > 1,    "2 > 1");
		test(1 <= 1,   "1 <= 1");
		test(1 <= 2,   "1 <= 2");
		test(2 >= 2,   "2 >= 2");
		test(3 >= 2,   "3 >= 2");

		// Boolean literals
		test(true == true,   "true == true");
		test(false == false, "false == false");
		test(true != false,  "true != false");

		// Comparisons involving expressions
		test(2 + 2 == 4,   "2 + 2 == 4");
		test(3 * 3 == 9,   "3 * 3 == 9");
		test(10 / 2 == 5,  "10 / 2 == 5");
		test(10 % 3 != 0,  "10 % 3 != 0");

		///////////////////////////////
		// Mixed float/int comparisons
		///////////////////////////////

		// float (variable) compared to int literal
		pos : float = 1.5;
		neg : float = -1.5;
		zero_f : float = 0.0;

		test(pos > 0,         "float > int: 1.5 > 0");
		test(neg < 0,         "float < int: -1.5 < 0");
		test(zero_f == 0,     "float == int: 0.0 == 0");
		test(pos != 0,        "float != int: 1.5 != 0");
		test(neg <= 0,        "float <= int: -1.5 <= 0");
		test(pos >= 0,        "float >= int: 1.5 >= 0");
		test(!(neg > 0),      "float > int (false): -1.5 not > 0");
		test(!(pos < 0),      "float < int (false): 1.5 not < 0");

		// int literal compared to float variable
		test(0 < pos,         "int < float: 0 < 1.5");
		test(0 > neg,         "int > float: 0 > -1.5");
		test(0 == zero_f,     "int == float: 0 == 0.0");
		test(0 != pos,        "int != float: 0 != 1.5");

		// double vs int
		pos_d : double = 2.5;
		neg_d : double = -2.5;
		test(pos_d > 0,       "double > int: 2.5 > 0");
		test(neg_d < 0,       "double < int: -2.5 < 0");
		test(neg_d <= 0,      "double <= int: -2.5 <= 0");
		test(!(neg_d > 0),    "double > int (false): -2.5 not > 0");
	}
}
