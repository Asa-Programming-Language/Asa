
// DirectiveTests
// Tests for compile-time directives (#linenum, #line, #filepath, #linecol, #funcname, #modulename, #compiler, #counter).

@public:
DirectiveTests :: module {

    #import Tests.Testing;
    #import Builtin.String;
    #import Builtin.Print;

    directiveContextFunction :: () {}
    DirectiveContextStruct :: struct {}

    // runDirectiveTests()
    // Runs all compile-time directive tests.

    @public:
    runDirectiveTests :: () {
        beginSection("Compile-time Directives");

        // #linenum should expand to the integer line number of that token
        ln : int = #linenum;
        test(ln > 0, "#linenum should be a positive integer");

        // Two consecutive #linenum captures should differ by 1
        a : int = #linenum;
        b : int = #linenum;
        test(b == a + 1, "#linenum should increment by 1 on consecutive lines");

        // #linenum used inline in an expression
        test(#linenum > 0, "#linenum inline should be positive");

        // #line should expand to the source text of that line as a string
        lineStr : string = #line;
        test(lineStr.length > 0, "#line should produce a non-empty string");

        // #line captured inline then tested via string variable
        lineStr2 : string = #line;
        test(lineStr2.length > 0, "#line inline should have non-zero length");

        // #filepath should expand to the source file path as a string
        fname : string = #filepath;
        test(fname.length > 0, "#filepath should be a non-empty string");

        // #linecol should expand to the column number as a positive integer
        col : int = #linecol;
        test(col > 0, "#linecol should be a positive integer");

        // #funcname should expand to the enclosing function name
        fn : string = #funcname;
        test(fn.length > 0, "#funcname should be a non-empty string");

        // #modulename should expand to the enclosing module name
        mn : string = #modulename;
        test(mn.length > 0, "#modulename should be a non-empty string");

        // #asaversion should expand to the compiler version string
        comp : string = #asaversion;
        test(comp.length > 0, "#asaversion should be a non-empty string");

        // #counter should produce unique incrementing integers
        c0 : int = #counter;
        c1 : int = #counter;
        c2 : int = #counter;
        test(c1 == c0 + 1, "#counter should increment by 1");
        test(c2 == c1 + 1, "#counter should keep incrementing");

        // #nameof should return the simple name of a variable as a string
        someVar : int = 42;
        test(#nameof(someVar) == "someVar", "#nameof should return variable name");

        // #nameof on a dotted path should return just the last identifier
        test(#nameof(someVar) == #nameof(someVar), "#nameof result is consistent");

        // #typeof should return the type name of a variable as a string
        intVar : int = 0;
        test(#typeof(intVar) == "int", "#typeof(int var) should return \"int\"");
        floatVar : float = 0.0;
        test(#typeof(floatVar) == "float", "#typeof(float var) should return \"float\"");
        strVar : string = "hello";
        test(#typeof(strVar) == "string", "#typeof(string var) should return \"string\"");
        test(#typeof(int32) == "int32", "#typeof(type name) should return the type name");

        // #sizeof should return the byte size of a type
        test(#sizeof(int) == 4, "#sizeof(int) should be 4");
        test(#sizeof(uint) == 4, "#sizeof(uint) should be 4");
        test(#sizeof(int64) > 4, "#sizeof(int64) should be > 4");
        test(#sizeof(int32) == 4, "#sizeof(int32) should be 4");
        test(#sizeof(int16) == 2, "#sizeof(int16) should be 2");
        test(#sizeof(int8) == 1, "#sizeof(int8) should be 1");
        test(#sizeof(bool) == 1, "#sizeof(bool) should be 1");
        test(#sizeof(char) == 1, "#sizeof(char) should be 1");

        // #sizeof of a variable should use the variable's type
        sizeVar : int = 0;
        test(#sizeof(sizeVar) == 4, "#sizeof(int variable) should be 4");

        // #compiles should return true when the expression is valid
        test(#compiles(1 + 1), "#compiles(1 + 1) should be true");
        test(#compiles(intVar + 1), "#compiles(intVar + 1) should be true");
        test(#compiles("hello"), "#compiles(string literal) should be true");

        // #compiles should return false when the expression is invalid
        // (e.g. using an undeclared identifier)
        test(#compiles(undeclaredIdentifier) == false, "#compiles(undeclared) should be false");
        test(#compiles(#error("custom compile error", intVar)) == false, "#error should produce a compiler error");
        test(#compiles(#warning("custom compile warning", intVar)), "#warning should produce a compiler warning without failing");
        test(#compiles(printl(f"bad directive: {#typename int32}")) == false, "unimplemented directive in f-string does not compile");
        compileTimeContext :: 12;
        regularContext : int = 4;
        test(#compiles(#warning("compile-time definition warning", compileTimeContext)), "#warning can use a compile-time definition as context");
        test(#compiles(#error("compile-time definition error", compileTimeContext)) == false, "#error can use a compile-time definition as context");
        test(#compiles(#warning("compile-time parent warning", #parent(compileTimeContext))), "#parent can return the parent AST of a compile-time definition value");
        test(#compiles(#error("compile-time parent error", #parent(compileTimeContext))) == false, "#error can use #parent of a compile-time definition value");
        test(#compiles(#nameof(#parent())) == false, "#parent without an AST node does not compile");
        test(#compiles(#warning("missing context warning", #context)) == false, "#context outside a custom directive does not compile");
        test(#compiles(#warning("struct definition warning", DirectiveContextStruct)), "#warning can use a struct definition as context");
        test(#compiles(#warning("function definition warning", directiveContextFunction)), "#warning can use a function definition as context");
        test(#compiles(#warning("regular variable warning", regularContext)), "#warning keeps regular variables as usage context");
        test(#compiles(#warning("function call warning", directiveContextFunction())), "#warning keeps function calls as usage context");

        #setflag TEST_DIRECTIVE_FLAG true;
        test(#getflag(TEST_DIRECTIVE_FLAG), "#getflag reads a true flag set by #setflag");
        test(#stack_last("directive_calls") == "getflag", "directive_calls tracks #getflag after it resolves");
        #setflag TEST_DIRECTIVE_FLAG false;
        test(#stack_last("directive_calls") == "setflag", "directive_calls tracks #setflag after it runs");
        test(#getflag(TEST_DIRECTIVE_FLAG) == false, "#getflag reads updated false flag values");
        test(#getflag(MISSING_DIRECTIVE_FLAG) == false, "#getflag returns false for missing flags");

        ifValue : int = 0;
        #stack_push("control_flow_result", false);
        #if(true, { ifValue = 3; });
        test(ifValue == 3, "#if(true) includes its AST node");
        test(#stack_last("control_flow_result") == true, "control_flow_result tracks true #if conditions");
        test(#stack_last("directive_calls") == "stack_last", "directive_calls tracks #stack_last after it resolves");
        #if(false, { ifValue = 4; });
        test(ifValue == 3, "#if(false) skips its AST node");
        test(#stack_last("directive_calls") == "if", "directive_calls tracks #if after it runs");
        test(#stack_last("control_flow_result") == false, "control_flow_result tracks false #if conditions");
        #if(1 == 1, { ifValue = 5; });
        test(ifValue == 5, "#if supports compile-time comparison conditions");
        #if(1 == 2, { skippedUnknownIdentifier = 1; });
        test(ifValue == 5, "#if(false) does not compile skipped invalid AST");
        #stack_push("control_flow_result", false);
        #if(true, {
            test(#stack_last("control_flow_result") == false, "#if pushes control_flow_result after its body runs");
        });
        test(#stack_last("control_flow_result") == true, "control_flow_result updates after #if body finishes");
        IF_CONDITION :: 2 > 1;
        #if(IF_CONDITION, { ifValue = 7; });
        test(ifValue == 7, "#if supports compile-time definition conditions");
        #if(false, { #print("skipped compile-time print"); });
        #if(false, { #printl("skipped compile-time print line"); });
        test(#compiles(#if(false, { #print("skipped compile-time print in compiles"); })), "#print parses as a compiler directive");
        test(#compiles(#if(false, { #printl("skipped compile-time print line in compiles"); })), "#printl parses as a compiler directive");

        // #stack_push should push any AST node to the given stack
        x : int = 6;
        #stack_push("variables", x);
        test(#stack_last("variables") == 6, "#stack_last returns pushed variable value");
        test(#compiles(#warning("stack warning", #stack_last("variables"))), "#warning can use AST returned by #stack_last");
        test(#compiles(#warning("stack parent warning", #parent(#stack_last("variables")))), "#parent can use AST returned by #stack_last");
        test(#compiles(#error("stack error", #stack_last("variables"))) == false, "#error can use AST returned by #stack_last");

        // Stack names can be string literals or identifiers
        #stack_push(identifierStack, 11);
        test(#stack_last(identifierStack) == 11, "#stack_last works with identifier stack names");

        // Pushing a second value should make it the new top
        #stack_push("variables", 9);
        test(#stack_last("variables") == 9, "#stack_last returns most recent pushed value");

        // #stack_pop should restore the previous value
        #stack_pop("variables");
        test(#stack_last("variables") == 6, "#stack_pop restores previous stack value");

        // Separate stacks should not affect each other
        #stack_push("other", 99);
        test(#stack_last("other") == 99, "#stack_last reads from the requested stack");
        test(#stack_last("variables") == 6, "#stack_push on another stack does not affect this stack");

        // Stack entries can be expressions
        #stack_push("expressions", 2 + 3);
        test(#stack_last("expressions") == 5, "#stack_last can evaluate pushed expressions");
    }
}
