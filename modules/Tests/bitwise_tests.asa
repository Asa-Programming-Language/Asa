// BitwiseTests
// Tests for bitwise operators: &, |, ^, <<, >> and their compound forms.

@public:
BitwiseTests :: module {

	#use Tests.Testing;

	@public:
	runBitwiseTests :: () {
		beginSection("Bitwise Operators");

		anything : int = 42;
		x : int = 20;
		a : int = 7;
		b : int = 3;

		///////////////////////
		// Bitwise AND (&)   //
		///////////////////////

		test((5 & 3) == 1,        "5 & 3 == 1  (0101 & 0011 = 0001)");
		test((7 & 3) == 3,        "7 & 3 == 3  (0111 & 0011 = 0011)");
		test((15 & 7) == 7,       "15 & 7 == 7 (1111 & 0111 = 0111)");
		test((0 & anything) == 0, "0 & x == 0    (identity)");
		test((x & 0) == 0,        "x & 0 == 0    (identity)");
		test((x & x) == x,        "x & x == x    (idempotent)");

		///////////////////////
		// Bitwise OR (|)    //
		///////////////////////

		test((5 | 3) == 7,        "5 | 3 == 7  (0101 | 0011 = 0111)");
		test((7 | 1) == 7,        "7 | 1 == 7  (0111 | 0001 = 0111)");
		test((0 | x) == x,        "0 | x == x  (identity)");
		test((x | 0) == x,        "x | 0 == x  (identity)");
		test((x | x) == x,        "x | x == x  (idempotent)");

		///////////////////////
		// Bitwise XOR (^)   //
		///////////////////////

		test((5 ^ 3) == 6,        "5 ^ 3 == 6  (0101 ^ 0011 = 0110)");
		test((7 ^ 3) == 4,        "7 ^ 3 == 4  (0111 ^ 0011 = 0100)");
		test((x ^ 0) == x,        "x ^ 0 == x  (identity)");
		test((x ^ x) == 0,        "x ^ x == 0  (annihilator)");
		test((a ^ b) ^ b == a,    "(a ^ b) ^ b == a (double XOR cancels)");

		///////////////////////
		// Left Shift (<<)   //
		///////////////////////

		test((1 << 0) == 1,       "1 << 0 == 1");
		test((1 << 1) == 2,       "1 << 1 == 2");
		test((1 << 2) == 4,       "1 << 2 == 4");
		test((1 << 3) == 8,       "1 << 3 == 8");
		test((5 << 1) == 10,      "5 << 1 == 10 (multiply by 2)");
		test((5 << 2) == 20,      "5 << 2 == 20 (multiply by 4)");

		///////////////////////
		// Right Shift (>>)  //
		///////////////////////

		test((8 >> 0) == 8,       "8 >> 0 == 8");
		test((8 >> 1) == 4,       "8 >> 1 == 4 (divide by 2)");
		test((16 >> 2) == 4,      "16 >> 2 == 4 (divide by 4)");
		test((20 >> 2) == 5,      "20 >> 2 == 5 (divide by 4)");
		test((1 >> 1) == 0,       "1 >> 1 == 0 (underflow)");

		///////////////////////
		// Compound &=       //
		///////////////////////

		a = 7;
		a &= 3;
		test(a == 3,              "a=7; a&=3 -> 3");

		b = 15;
		b &= 7;
		test(b == 7,              "a=15; b&=7 -> 7");

		///////////////////////
		// Compound |=       //
		///////////////////////

		c : int = 5;
		c |= 3;
		test(c == 7,              "c=5; c|=3 -> 7");

		d : int = 8;
		d |= 4;
		test(d == 12,             "d=8; d|=4 -> 12");

		///////////////////////
		// Compound ^=       //
		///////////////////////

		e : int = 5;
		e ^= 3;
		test(e == 6,              "e=5; e^=3 -> 6");

		f : int = 7;
		f ^= 3;
		test(f == 4,              "f=7; f^=3 -> 4");

		///////////////////////
		// Compound <<=      //
		///////////////////////

		g : int = 5;
		g <<= 1;
		test(g == 10,             "g=5; g<<=1 -> 10");

		h : int = 3;
		h <<= 2;
		test(h == 12,             "h=3; h<<=2 -> 12");

		///////////////////////
		// Compound >>=      //
		///////////////////////

		i : int = 20;
		i >>= 1;
		test(i == 10,             "i=20; i>>=1 -> 10");

		j : int = 16;
		j >>= 2;
		test(j == 4,              "j=16; j>>=2 -> 4");

		///////////////////////
		// Combined operators //
		///////////////////////

		test((12 & 10) == 8,      "12 & 10 == 8  (1100 & 1010 = 1000)");
		test((12 | 10) == 14,     "12 | 10 == 14 (1100 | 1010 = 1110)");
		test((12 ^ 10) == 6,      "12 ^ 10 == 6  (1100 ^ 1010 = 0110)");

		///////////////////////
		// Negative numbers  //
		///////////////////////

		// Two's complement behavior
		test((-1 & 7) == 7,       "-1 & 7 == 7 (all bits set & 0111 = 0111)");
		test((-1 | 7) == -1,      "-1 | 7 == -1 (all bits set)");
		test((-1 ^ 7) == -8,      "-1 ^ 7 == -8 (flip low 3 bits)");

		///////////////////////
		// Power of 2 checks //
		///////////////////////

		// Check if bit n is set: (x & (1 << n)) != 0
		x = 20; // 10100
		test((x & (1 << 2)) != 0, "bit 2 is set in 20 (10100)");
		test((x & (1 << 4)) != 0, "bit 4 is set in 20 (10100)");
		test((x & (1 << 0)) == 0, "bit 0 is clear in 20 (10100)");
		test((x & (1 << 1)) == 0, "bit 1 is clear in 20 (10100)");

		// Set bit n: x | (1 << n)
		y : int = 16; // 10000
		y |= (1 << 2); // set bit 2
		test(y == 20,             "set bit 2 in 16 -> 20");

		// Clear bit n: x & ~(1 << n)
		z : int = 20; // 10100
		z &= ~(1 << 2); // clear bit 2
		test(z == 16,             "clear bit 2 in 20 -> 16");
	}
}
