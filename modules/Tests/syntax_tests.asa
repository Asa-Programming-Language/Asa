
// SyntaxTests
// Tests for unusual but valid syntax that might break a poorly implemented
// parser or codegen. Each section targets a different structural oddity.

@public:
SyntaxTests :: module {

	#use Tests.Testing;
	#use Builtin.Math;
	#use Builtin.String;
	#use Builtin.Casts;

	DERIVED_BASE_W :: 960;
	DERIVED_BASE_H :: 640;
	DERIVED_MARGIN :: 40;
	DERIVED_SCALE :: 12;
	DERIVED_W :: DERIVED_BASE_W / DERIVED_SCALE;
	DERIVED_H :: (DERIVED_BASE_H - DERIVED_MARGIN) / DERIVED_SCALE;
	DERIVED_COUNT :: DERIVED_W * DERIVED_H;
	DERIVED_PAREN :: (DERIVED_BASE_W - DERIVED_MARGIN);

	Vec3 :: struct { x : float; y : float; z : float; }
	Node :: struct { val : int; depth : int; }

	create :: Vec3(x : float, y : float, z : float) {
		v : Vec3 = Vec3();
		v.x = x; v.y = y; v.z = z;
		return v;
	}

	vec3_sum :: float(v : Vec3) { return v.x + v.y + v.z; }
	vec3_dot :: float(a : Vec3, b : Vec3) { return a.x*b.x + a.y*b.y + a.z*b.z; }

	Wrapper :: struct { inner : Vec3; }
	PtrContainer :: struct { ptr : *Vec3; }

	makeWrapper :: Wrapper(v : Vec3) { w : Wrapper = Wrapper(); w.inner = v; return w; }

	rect_width :: float(r : Rect) { return r.width; }
	take_two_rects :: float(a : Rect, b : Rect) { return a.width + b.width; }
	take_many :: float(w : Wrapper, a : Rect, b : Rect, o : Vec3, s : float) { return a.width + b.width + s; }
	take_many_f :: float(f : float, a : Rect, b : Rect, o : Vec3, s : float) { return f + a.width + b.width + s; }

	// Void helper for standalone-statement multiline call tests
	accumulate :: (total : ref int, a : int, b : int, c : int) { total = total + a + b + c; }

	multiline_arguments :: int(
		left : int,
		right : int
	) {
		return left + right;
	}

	GLOBAL_N : int = 10;

	@public:
	runSyntaxTests :: () {
		beginSection("Syntax");

		//////////////////////////////////
		// Derived constant expressions //
		//////////////////////////////////

		test(DERIVED_W == 80,                  "derived constant division");
		test(DERIVED_H == 50,                  "derived parenthesized constant division");
		test(DERIVED_COUNT == 4000,            "derived constant multiplication");
		test(DERIVED_PAREN == 920,             "fully parenthesized constant expression");
		test(multiline_arguments(20, 22) == 42, "function definition with multiline arguments");
		test(#compiles(#stack_push("syntaxTrailingSemicolonScope", { trailingSemiValue : int = 1; })), "semicolon before implicit scope end in directive argument");

		///////////////////////
		// Redundant parens  //
		///////////////////////

		test((((5))) == 5,                    "triple-paren literal");
		test((((1 + 2))) == 3,                "triple-paren expression");
		x : int = (((7)));
		test(x == 7,                          "assign from triple-paren");

		///////////////////////
		// Unary chains      //
		///////////////////////

		test(-(-1) == 1,                      "double negation");
		test(-(-(-1)) == -1,                  "triple negation");
		test(!!true,                          "double not");
		test(!!!false,                        "triple not");
		test(!(!(!true)) == false,            "triple not with parens");
		test(-(-(-(2))) == -2,               "deeply parened triple negation");

		///////////////////////
		// Self-assignment    //
		///////////////////////

		a : int = 10;
		a = a;
		test(a == 10,                         "a = a is identity");
		a += a;
		test(a == 20,                         "a += a doubles");
		a -= a;
		test(a == 0,                          "a -= a is zero");
		b : int = 3;
		b *= b;
		test(b == 9,                          "b *= b squares");

		///////////////////////
		// Complex for bounds //
		///////////////////////

		lo : int = 2;
		hi : int = 7;
		count : int = 0;
		for (i in lo..hi) { count += 1; }
		test(count == 5,                      "for with variable bounds");

		count = 0;
		for (i in 0..lo*hi) { count += 1; }
		test(count == 14,                     "for with expression upper bound");

		count = 0;
		for (i in (lo+1)..(hi-1)) { count += 1; }
		test(count == 3,                      "for with expression bounds both sides");

		///////////////////////
		// Nested loops       //
		///////////////////////

		total : int = 0;
		for (i in 0..3) {
			for (j in 0..3) {
				total += 1;
			}
		}
		test(total == 9,                      "nested for loops");

		///////////////////////
		// Break / continue   //
		///////////////////////

		sum : int = 0;
		for (i in 0..10) {
			if (i == 5) { break; }
			sum += i;
		}
		test(sum == 10,                       "break exits loop early (0+1+2+3+4)");

		sum = 0;
		for (i in 0..6) {
			if (i % 2 == 0) { continue; }
			sum += i;
		}
		test(sum == 9,                        "continue skips even indices (1+3+5)");

		sum = 0;
		n : int = 0;
		while (n < 10) {
			n += 1;
			if (n % 2 == 0) { continue; }
			sum += n;
		}
		test(sum == 25,                       "continue in while (1+3+5+7+9)");

		///////////////////////
		// Variable shadowing //
		///////////////////////

		outer : int = 100;
		{
			outer : int = 1;
			test(outer == 1,                  "inner shadow hides outer");
		}
		test(outer == 100,                    "outer survives inner scope");

		shadow : int = 5;
		for (shadow in 0..1) {
			test(shadow == 0,                 "for iterator shadows outer variable");
		}
		test(shadow == 5,                     "outer shadow restored after for");

		///////////////////////
		// Chained member     //
		///////////////////////

		v : Vec3 = Vec3();
		v.x = 1.0;
		v.y = 2.0;
		v.z = 3.0;
		test(v.x + v.y + v.z == 6.0,         "chained struct member access in expr");

		n2 : Node = Node();
		n2.val = 42;
		n2.depth = n2.val - 1;
		test(n2.depth == 41,                  "struct member used in its sibling's init");

		///////////////////////
		// Cast chains        //
		///////////////////////

		test(int(float(5)) == 5,              "int(float(x)) round-trips");
		test(float(int(3.9f)) == 3.0f,        "float(int(3.9)) truncates then restores");
		test(int(int(int(7))) == 7,           "int(int(int(x))) is identity");

		///////////////////////
		// Exprs as args      //
		///////////////////////

		test(abs(3 - 5) == 2,                 "abs of expression");
		test(abs(abs(-3) - abs(-5)) == 2,     "abs of abs(a) - abs(b)");
		test(clamp(2+3, 1, 10) == 5,          "clamp with expression arg");
		test(clamp(0*5, 1, 10) == 1,          "clamp with zero expression");
		test(clamp(3*5, 1, 10) == 10,         "clamp with over-max expression");

		///////////////////////
		// Multi-line expr    //
		///////////////////////

		big : int = 1 + 2
					+ 3 + 4
					+ 5;
		test(big == 15,                       "expression split across lines");

		// Arithmetic - operator at end of line
		ml_add : int = 3 +
		               4;
		test(ml_add == 7,                     "multiline +: op at end of line");

		ml_sub : int = 10 -
		               3;
		test(ml_sub == 7,                     "multiline -: op at end of line");

		ml_mul : int = 4 *
		               3;
		test(ml_mul == 12,                    "multiline *: op at end of line");

		ml_div : int = 20 /
		               4;
		test(ml_div == 5,                     "multiline /: op at end of line");

		ml_mod : int = 17 %
		               5;
		test(ml_mod == 2,                     "multiline %: op at end of line");

		// Arithmetic - operator at start of next line
		ml_add2 : int = 3
		                + 4;
		test(ml_add2 == 7,                    "multiline +: op at start of line");

		ml_sub2 : int = 10
		                - 3;
		test(ml_sub2 == 7,                    "multiline -: op at start of line");

		ml_mul2 : int = 4
		                * 3;
		test(ml_mul2 == 12,                   "multiline *: op at start of line");

		ml_div2 : int = 20
		                / 4;
		test(ml_div2 == 5,                    "multiline /: op at start of line");

		ml_mod2 : int = 17
		                % 5;
		test(ml_mod2 == 2,                    "multiline %: op at start of line");

		// Comparison operators
		ml_lt : bool = 3
		               < 5;
		test(ml_lt,                           "multiline <");

		ml_gt : bool = 5
		               > 3;
		test(ml_gt,                           "multiline >");

		ml_lte : bool = 3
		                <= 3;
		test(ml_lte,                          "multiline <=");

		ml_gte : bool = 5
		                >= 5;
		test(ml_gte,                          "multiline >=");

		ml_eq : bool = 7
		               == 7;
		test(ml_eq,                           "multiline ==");

		ml_ne : bool = 7
		               != 8;
		test(ml_ne,                           "multiline !=");

		// Logical operators
		ml_and : bool = true
		                && true;
		test(ml_and,                          "multiline &&");

		ml_and2 : bool = true &&
		                 true;
		test(ml_and2,                         "multiline &&: op at end of line");

		ml_or : bool = false
		               || true;
		test(ml_or,                           "multiline ||");

		ml_or2 : bool = false ||
		                true;
		test(ml_or2,                          "multiline ||: op at end of line");

		// Bitwise operators
		ml_band : int = 12
		                & 10;
		test(ml_band == 8,                    "multiline &");

		ml_bor : int = 12
		               | 10;
		test(ml_bor == 14,                    "multiline |");

		ml_bxor : int = 12
		                ^ 10;
		test(ml_bxor == 6,                    "multiline ^");

		ml_band2 : int = 12 &
		                 10;
		test(ml_band2 == 8,                   "multiline &: op at end of line");

		ml_bor2 : int = 12 |
		                10;
		test(ml_bor2 == 14,                   "multiline |: op at end of line");

		ml_bxor2 : int = 12 ^
		                 10;
		test(ml_bxor2 == 6,                   "multiline ^: op at end of line");

		// Assignment RHS on next line
		ml_asgn : int =
		          42;
		test(ml_asgn == 42,                   "multiline =: rhs on next line");

		ml_asgn2 : int = 0;
		ml_asgn2 =
		    99;
		test(ml_asgn2 == 99,                  "multiline =: standalone assignment");

		// Compound assignment operators
		ml_pe : int = 5;
		ml_pe +=
		    3;
		test(ml_pe == 8,                      "multiline +=");

		ml_me : int = 10;
		ml_me -=
		    4;
		test(ml_me == 6,                      "multiline -=");

		ml_te : int = 3;
		ml_te *=
		    4;
		test(ml_te == 12,                     "multiline *=");

		ml_de : int = 20;
		ml_de /=
		    5;
		test(ml_de == 4,                      "multiline /=");

		// Inside function call parens
		ml_call1 : int = add_one(
		                     5);
		test(ml_call1 == 6,                   "multiline: single arg on next line");

		ml_call2 : int = clamp(
		                     5,
		                     1,
		                     10);
		test(ml_call2 == 5,                   "multiline: multiple args on separate lines");

		ml_call3 : int = add_one(2 +
		                         3);
		test(ml_call3 == 6,                   "multiline: expr arg split across lines");

		// Struct constructor as function argument
		s3 : float = vec3_sum(Vec3(1.0, 2.0, 3.0));
		test(s3 == 6.0,                       "struct ctor as function arg");

		// Struct constructor as function argument, multiline
		s3ml : float = vec3_sum(
		                   Vec3(4.0, 5.0, 6.0));
		test(s3ml == 15.0,                    "struct ctor as function arg, multiline");

		// Function call as argument where line ends with comma
		s3mc : float = add_one(
		                   int(vec3_sum(Vec3(1.0, 2.0, 3.0))));
		test(s3mc == 7,                       "call-as-arg multiline: inner call on next line");

		s3mc2 : float = vec3_sum(Vec3(1.0, 2.0, 3.0)) +
		                vec3_sum(Vec3(4.0, 5.0, 6.0));
		test(s3mc2 == 21.0,                   "call-as-arg multiline: call expr continued on next line");

		mc_result : int = clamp(
		                      add_one(3),
		                      add_one(1),
		                      add_one(8));
		test(mc_result == 4,                  "call-as-arg multiline: each arg a call, lines end with comma");

		// Unary negation of variable in function call
		nv : int = 5;
		test(clamp(-nv, -10, 10) == -5,       "unary negation of variable as call arg");
		test(add_one(-nv) == -4,              "unary negation of variable as sole call arg");
		nf : float = 3.0;
		test(vec3_sum(Vec3(1.0, -nf, 1.0)) == -1.0, "unary negation of float var as struct ctor arg");
		test(clamp(-GLOBAL_N, -20, 20) == -10,  "unary negation of module-level var as call arg");
		test(add_one(-GLOBAL_N) == -9,           "unary negation of module-level var, sole arg");
		test(float(-GLOBAL_N) == -10.0,          "cast with unary negation of module-level var");
		test(float(-nv) == -5.0,                 "cast with unary negation of local var");

		// Struct constructor followed by comma in multiline call
		dot1 : float = vec3_dot(
		                   Vec3(1.0, 0.0, 0.0),
		                   Vec3(1.0, 0.0, 0.0));
		test(dot1 == 1.0,                        "struct ctor arg followed by comma in multiline call");

		// Mimic raycaster: Rect(0.0, 0.0, float(N), float(-N)) as arg, multiline, comma after
		tw : float = take_two_rects(
		                 Rect(0.0, 0.0, float(GLOBAL_N), float(-GLOBAL_N)),
		                 Rect(0.0, 0.0, float(GLOBAL_N), float(GLOBAL_N)));
		test(tw == 20.0,                         "raycaster mimic: Rect with float(-var) arg, multiline comma");

		// Full raycaster mimic: struct first arg, two Rects w/ float(-var), more args, multiline
		wr : Wrapper = makeWrapper(Vec3(1.0, 0.0, 0.0));
		tm : float = take_many(wr,
		                 Rect(0.0, 0.0, float(GLOBAL_N), float(-GLOBAL_N)),
		                 Rect(0.0, 0.0, float(GLOBAL_N), float(GLOBAL_N)),
		                 Vec3(float(0), float(0), float(0)), 1.0);
		test(tm == 21.0,                         "raycaster mimic: struct first arg then Rects with float(-var)");

		// Member access as first arg, then Rects w/ float(-var)
		tmf : float = take_many_f(vec3_sum(wr.inner),
		                 Rect(0.0, 0.0, float(GLOBAL_N), float(-GLOBAL_N)),
		                 Rect(0.0, 0.0, float(GLOBAL_N), float(GLOBAL_N)),
		                 Vec3(float(0), float(0), float(0)), 1.0);
		test(tmf == 22.0,                        "raycaster mimic: member-access first arg then Rects with float(-var)");

		test(1 == 1 &&
		     2 == 2,                          "multiline && inside test() args");

		///////////////////////////////
		// Standalone multiline calls //
		///////////////////////////////

		// test() itself is a standalone void call; verify it works multiline
		test(
		    1 == 1,
		    "standalone void call: single arg on next line");

		test(add_one(3) == 4 &&
		     add_one(4) == 5,                 "standalone void call: multiline condition");

		// Void function called as standalone statement, args on separate lines
		acc : int = 0;
		accumulate(acc,
		           1,
		           2,
		           3);
		test(acc == 6,                        "standalone void call: args on separate lines");

		accumulate(acc,
		           add_one(0),
		           add_one(1),
		           add_one(2));
		test(acc == 12,                       "standalone void call: call-expr args on separate lines");

		// Standalone call with struct args on separate lines (mimics raycaster DrawTexturePro pattern)
		accumulate(acc,
		           int(rect_width(Rect(0.0, 0.0, float(GLOBAL_N), float(-GLOBAL_N)))),
		           int(rect_width(Rect(0.0, 0.0, float(GLOBAL_N),  float(GLOBAL_N)))),
		           0);
		test(acc == 32,                       "standalone void call: struct ctor args on separate lines with float(-var)");

		// Closing paren on its own line (mimics DrawTexturePro raycaster pattern)
		accumulate(acc,
		           1,
		           2,
		           3
		);
		test(acc == 38,                       "standalone void call: closing paren on its own line");

		///////////////////////
		// Zero-effect ops    //
		///////////////////////

		q : int = 42;
		q += 0;
		test(q == 42,                         "+= 0 is identity");
		q -= 0;
		test(q == 42,                         "-= 0 is identity");
		q *= 1;
		test(q == 42,                         "*= 1 is identity");
		q /= 1;
		test(q == 42,                         "/= 1 is identity");

		///////////////////////
		// Chained string ops //
		///////////////////////

		s : string = "a" + "b" + "c" + "d";
		test(s.length == 4,                   "chained 4-way string concat length");
		test(s == "abcd",                     "chained 4-way string concat value");

		empty : string = "" + "" + "";
		test(empty.length == 0,               "concat of empty strings is empty");

		///////////////////////
		// Bool in expr       //
		///////////////////////

		t : bool = (1 < 2) && (3 > 1) && (5 != 6);
		test(t,                               "complex bool assigned to variable");

		f2 : bool = (1 > 2) || (3 < 1) || (5 == 6);
		test(!f2,                             "complex false bool assigned to variable");

		///////////////////////
		// Nested if/else     //
		///////////////////////

		rslt : int = 0;
		if (1 < 2) {
			if (2 < 3) {
				if (3 < 4) {
					rslt = 7;
				}
			}
		}
		test(rslt == 7,                       "triple nested if");

		rslt = 0;
		if (1 > 2) {
			rslt = 1;
		} else if (1 > 3) {
			rslt = 2;
		} else if (1 > 4) {
			rslt = 3;
		} else {
			rslt = 4;
		}
		test(rslt == 4,                       "long if/else if/else chain falls to else");

		///////////////////////
		// Modulo edge cases  //
		///////////////////////

		test(0 % 5 == 0,                      "0 % 5 == 0");
		test(5 % 5 == 0,                      "5 % 5 == 0");
		test(1 % 1 == 0,                      "1 % 1 == 0");
		test(7 % 1 == 0,                      "7 % 1 == 0");

		///////////////////////
		// Complex conditions  //
		///////////////////////

		p : int = 4;
		test(p > 0 && p < 10 && p % 2 == 0,  "compound condition with %");
		test(!(p < 0 || p > 10),              "negated compound condition");

		///////////////////////
		// Functions as exprs //
		///////////////////////

		test(double_val(double_val(2)) == 8,  "double(double(x))");
		test(add_one(add_one(add_one(0))) == 3, "chained add_one calls");

		///////////////////////
		// Return from inside //
		///////////////////////

		test(early_exit(5) == 1,              "return inside if");
		test(early_exit(-1) == 0,             "falls through to return 0");

		///////////////////////////////
		// Deref pointer struct field //
		///////////////////////////////

		// Declaration+init with deref of a pointer-to-struct field (always worked)
		va : Vec3 = Vec3(); va.x = 1.0; va.y = 2.0; va.z = 3.0;
		vb : Vec3 = Vec3(); vb.x = 4.0; vb.y = 5.0; vb.z = 6.0;
		pc : PtrContainer = PtrContainer();
		pc.ptr = &va;
		r1 : Vec3 = *pc.ptr;
		test(r1.x == 1.0,                     "deref ptr struct field: decl+init");

		// Plain assignment with deref of pointer-to-struct field
		// (was broken: compiler produced 'int32' instead of 'Vec3')
		pc.ptr = &vb;
		r1 = *pc.ptr;
		test(r1.x == 4.0,                     "deref ptr struct field: plain assignment");

		//////////////////////////////////////////////
		// Member access on parenthesized subscript //
		//////////////////////////////////////////////

		arr : *Vec3 = malloc(4 * #sizeof(Vec3));
		arr[0] = Vec3(); arr[0].x = 10.0; arr[0].y = 20.0; arr[0].z = 30.0;
		arr[1] = Vec3(); arr[1].x = 40.0;
		test((arr[0]).x == 10.0,              "member access on parenthesized subscript");
		test((arr[1]).x == 40.0,              "member access on parenthesized subscript, index 1");

		/////////////////////////////////////////////
		// Compound assignment on pointer subscript //
		/////////////////////////////////////////////

		floats : *float = malloc(4 * #sizeof(float));
		floats[0] = 1.0;
		floats[0] += 5.0;
		test(floats[0] == 6.0,                "compound += on pointer subscript");
		floats[1] = 10.0;
		floats[1] -= 3.0;
		test(floats[1] == 7.0,                "compound -= on pointer subscript");

		///////////////////////////////////////////
		// Multiline conditions                  //
		///////////////////////////////////////////

		// Operator at end of line
		ml_cond1 : bool = false;
		if (true ||
		    false)
		{
			ml_cond1 = true;
		}
		test(ml_cond1,                        "if: multiline condition, op at end of line");

		ml_cond2 : bool = false;
		if (true &&
		    true)
		{
			ml_cond2 = true;
		}
		test(ml_cond2,                        "if: multiline && condition");

		// Operator at start of next line
		ml_cond3 : bool = false;
		if (false
		    || true)
		{
			ml_cond3 = true;
		}
		test(ml_cond3,                        "if: multiline condition, op at start of line");

		// Multi-part condition spanning several lines
		ml_cond4 : int = 5;
		ml_cond5 : bool = false;
		if (ml_cond4 > 0
		    && ml_cond4 < 10
		    && ml_cond4 != 3)
		{
			ml_cond5 = true;
		}
		test(ml_cond5,                        "if: three-part condition across lines");

		// Multiline while condition
		ml_wcount : int = 0;
		ml_wn : int = 0;
		while (ml_wn < 3
		       && ml_wcount < 10)
		{
			ml_wn += 1;
			ml_wcount += 1;
		}
		test(ml_wcount == 3,                  "while: multiline condition");

		// Comment inside condition
		ml_cond6 : bool = false;
		if (true /* always */ || false)
		{
			ml_cond6 = true;
		}
		test(ml_cond6,                        "if: inline block comment inside condition");

		///////////////////////////////////////
		// Trailing comments before brace    //
		///////////////////////////////////////

		// Comment after while condition, brace on next line
		cmt_w : int = 0;
		while (cmt_w < 3) // increment until 3
		{
			cmt_w += 1;
		}
		test(cmt_w == 3,                      "while: trailing comment before brace");

		// Comment after if condition, brace on next line
		cmt_if : int = 0;
		if (cmt_w == 3) // should enter
		{
			cmt_if = 1;
		}
		test(cmt_if == 1,                     "if: trailing comment before brace");

		// Comment after else, brace on next line
		cmt_else : int = 0;
		if (cmt_w == 0) // false
		{
			cmt_else = 1;
		} else // should enter
		{
			cmt_else = 2;
		}
		test(cmt_else == 2,                   "else: trailing comment before brace");

		// Comment after for header, brace on next line
		cmt_for : int = 0;
		for (ci in 0..4) // four iterations
		{
			cmt_for += 1;
		}
		test(cmt_for == 4,                    "for: trailing comment before brace");

		// Block comment after condition, brace on next line
		cmt_block : int = 0;
		while (cmt_block < 2) /* block comment */
		{
			cmt_block += 1;
		}
		test(cmt_block == 2,                  "while: trailing block comment before brace");

		/////////////////////////////////////
		// void zero-initializer           //
		/////////////////////////////////////

		// Primitives
		zi : int = void;
		test(zi == 0,                         "void-init int is zero");

		zf : float = void;
		test(zf == 0.0,                       "void-init float is zero");

		zb : bool = void;
		test(zb == false,                     "void-init bool is false");

		// Pointer
		zp : *int = void;
		test(zp == void,                      "void-init pointer is null");

		// Struct: all fields zero
		zn : Node = void;
		test(zn.val == 0,                     "void-init struct field val is zero");
		test(zn.depth == 0,                   "void-init struct field depth is zero");

		// Assign after void-init
		za : int = void;
		za = 99;
		test(za == 99,                        "assign after void-init");

	}

	double_val :: int(x : int) {
		return x * 2;
	}

	add_one :: int(x : int) {
		return x + 1;
	}

	early_exit :: int(x : int) {
		if (x > 0) {
			return 1;
		}
		return 0;
	}
}
