
// StringTests
// Tests for string creation, concatenation, and length.

@public:
StringTests :: module {

	#import Tests.Testing;
	#import Builtin.String;

	// runStringTests()
	// Runs all string tests.

	@public:
	runStringTests :: () {
		beginSection("Strings");

		// String length from char* constructor
		s : string = string("hello");
		test(s.length == 5, "string(\"hello\") should have length 5");

		s2 : string = string("hello world");
		test(s2.length == 11, "string(\"hello world\") should have length 11");

		empty : string = string("");
		test(empty.length == 0, "empty string should have length 0");

		// String concatenation
		a : string = "foo" + "bar";
		test(a.length == 6, "\"foo\" + \"bar\" should have length 6");

		b : string = "hello" + " " + "world";
		test(b.length == 11, "triple concat should have length 11");

		// Concatenation with char
		c : string = "abc" + 'd';
		test(c.length == 4, "string + char should have length 4");

		// String literal length
		d : string = "testing";
		test(d.length == 7, "string literal \"testing\" should have length 7");

		///////////////////////
		// Empty string ""   //
		///////////////////////

		// Declaration and length
		e : string = "";
		test(e.length == 0,         "empty literal: length is 0");
		test(e.size()  == 0,        "empty literal: size() is 0");

		// Equality / inequality
		test("" == "",              "empty == empty is true");
		test(!("" == "hello"),      "empty == non-empty is false");
		test("" != "hello",         "empty != non-empty is true");
		test(!("" != ""),           "empty != empty is false");

		// Concatenation: empty + non-empty
		f : string = "" + "world";
		test(f.length == 5,         "empty + \"world\" has length 5");
		test(f == "world",          "empty + \"world\" equals \"world\"");

		// Concatenation: non-empty + empty
		g : string = "world" + "";
		test(g.length == 5,         "\"world\" + empty has length 5");
		test(g == "world",          "\"world\" + empty equals \"world\"");

		// Concatenation: empty + empty
		h : string = "" + "";
		test(h.length == 0,         "empty + empty has length 0");
		test(h == "",               "empty + empty equals empty");

		// Concatenation: empty + char
		i : string = "" + 'x';
		test(i.length == 1,         "empty + char has length 1");
		test(i == "x",              "empty + 'x' equals \"x\"");

		// Concatenation: empty + int
		j : string = "" + 42;
		test(j.length == 2,         "empty + 42 has length 2");
		test(j == "42",             "empty + 42 equals \"42\"");

		//////////////////////
		// f-strings        //
		//////////////////////

		sumString : string = f"sum: {5 + 1}";
		test(sumString == "sum: 6", "f-string formats arithmetic expression");

		value : int = 7;
		valueString : string = f"value: {value}";
		test(valueString == "value: 7", "f-string formats identifier expression");

		typeString : string = f"type: {#typeof int32}";
		test(typeString == "type: int32", "f-string formats compile-time directive expression");

		multiPart : string = f"{2}{3} apples";
		test(multiPart == "23 apples", "f-string supports multiple expressions and empty edge text");

		escapedBraces : string = f"\{not an expression\}";
		test(escapedBraces == "{not an expression}", "f-string supports escaped braces");

		//////////////////////
		// isEmpty()        //
		//////////////////////

		empty2 : string = string("");
		test(empty2.isEmpty(),                  "isEmpty(): empty string returns true");
		test(!s.isEmpty(),                      "isEmpty(): non-empty string returns false");

		//////////////////////
		// substr()         //
		//////////////////////

		str : string = string("hello world");

		test(str.substr(0, 5) == "hello",       "substr(0,5) == \"hello\"");
		test(str.substr(6, 5) == "world",       "substr(6,5) == \"world\"");
		test(str.substr(0, 11) == "hello world","substr(0,11) == full string");
		test(str.substr(0, 0) == "",            "substr(0,0) == empty");
		// clamping: len too long
		test(str.substr(6, 999) == "world",     "substr clamps len to remaining length");
		// clamping: start < 0
		test(str.substr(-3, 5) == "hello",      "substr clamps negative start to 0");
		// start out of bounds
		test(str.substr(99, 3) == "",           "substr out-of-bounds start == empty");

		//////////////////////
		// contains()       //
		//////////////////////

		test(str.contains("hello"),             "contains(\"hello\") true");
		test(str.contains("world"),             "contains(\"world\") true");
		test(str.contains("lo wo"),             "contains(\"lo wo\") true (spans boundary)");
		test(!str.contains("xyz"),              "contains(\"xyz\") false");
		test(!str.contains("HELLO"),            "contains case-sensitive: false");
		test(str.contains(""),                  "contains(\"\") always true");

		//////////////////////
		// indexOf()        //
		//////////////////////

		test(str.indexOf("hello") == 0,         "indexOf(\"hello\") == 0");
		test(str.indexOf("world") == 6,         "indexOf(\"world\") == 6");
		test(str.indexOf("o") == 4,             "indexOf(\"o\") == first occurrence");
		test(str.indexOf("xyz") == -1,          "indexOf(\"xyz\") == -1 not found");

		//////////////////////
		// startsWith()     //
		//////////////////////

		test(str.startsWith("hello"),           "startsWith(\"hello\") true");
		test(str.startsWith("hello world"),     "startsWith(full string) true");
		test(!str.startsWith("world"),          "startsWith(\"world\") false");
		test(!str.startsWith("Hello"),          "startsWith case-sensitive: false");
		test(str.startsWith(""),                "startsWith(\"\") always true");

		//////////////////////
		// endsWith()       //
		//////////////////////

		test(str.endsWith("world"),             "endsWith(\"world\") true");
		test(str.endsWith("hello world"),       "endsWith(full string) true");
		test(!str.endsWith("hello"),            "endsWith(\"hello\") false");
		test(!str.endsWith("World"),            "endsWith case-sensitive: false");
		test(str.endsWith(""),                  "endsWith(\"\") always true");

		//////////////////////
		// repeat()         //
		//////////////////////

		ab : string = string("ab");
		test(ab.repeat(3) == "ababab",          "repeat(3) == \"ababab\"");
		test(ab.repeat(1) == "ab",              "repeat(1) == self");
		test(ab.repeat(0) == "",                "repeat(0) == empty");
		test(ab.repeat(-1) == "",               "repeat(-1) == empty");
		x_str : string = string("x");
		test(x_str.repeat(5) == "xxxxx",        "repeat single char x5");
	}
}
