
// FileTests
// Tests for file I/O: open, read, write, close.

@public:
FileTests :: module {

	#import Tests.Testing;
	#import Builtin.File;
	#import Builtin.String;

	@public:
	runFileTests :: () {
		beginSection("File I/O");

		testPath : string = string("/tmp/asa_file_test.txt");

		// Write a file
		f : File = openFile(testPath, "w");
		test(f.isOpen, "open for write should succeed");
		writeLine(f, "hello");
		writeLine(f, "world");
		closeFile(f);

		// Read it back
		g : File = openFile(testPath, "r");
		test(g.isOpen, "open for read should succeed");
		contents : string = readAll(g);
		closeFile(g);

		test(contents.length > 0,                     "readAll should return non-empty string");
		test(contents == "hello\nworld\n",             "readAll contents should match what was written");

		// readLine
		h : File = openFile(testPath, "r");
		line1 : string = readLine(h);
		line2 : string = readLine(h);
		closeFile(h);

		test(line1 == "hello\n",                       "first readLine should be \"hello\\n\"");
		test(line2 == "world\n",                       "second readLine should be \"world\\n\"");

		// Append mode
		a : File = openFile(testPath, "a");
		test(a.isOpen, "open for append should succeed");
		writeLine(a, "appended");
		closeFile(a);

		b : File = openFile(testPath, "r");
		all : string = readAll(b);
		closeFile(b);
		test(all == "hello\nworld\nappended\n",        "appended line should appear in file");

		// Non-existent file
		bad : File = openFile(string("/tmp/asa_does_not_exist_xyz.txt"), "r");
		test(bad.isOpen == false,                      "open of missing file should fail");

		// Delete the test file
		test(deleteFile(testPath),                     "deleteFile should return true on success");
		gone : File = openFile(testPath, "r");
		test(gone.isOpen == false,                     "file should not exist after deleteFile");
	}
}
