
// BitcastTests
// Tests for the #bitcast directive: reinterpreting the raw bit pattern of a
// value as a different type without any numeric conversion.

@public:
BitcastTests :: module {

	#import Tests.Testing;
	#import Builtin.Memory;

	@public:
	runBitcastTests :: () {
		beginSection("Bitcast");

		///////////////////////
		// int -> float       //
		///////////////////////

		// IEEE 754: 0x3F800000 = 1065353216 represents 1.0f
		a : int = 1065353216;
		af : float = #bitcast(a, float);
		test(af == 1.0f,                      "bitcast 0x3F800000 -> float is 1.0");

		// 0x40000000 = 1073741824 represents 2.0f
		b : int = 1073741824;
		bf : float = #bitcast(b, float);
		test(bf == 2.0f,                      "bitcast 0x40000000 -> float is 2.0");

		// 0x00000000 = 0 represents 0.0f
		z : int = 0;
		zf : float = #bitcast(z, float);
		test(zf == 0.0f,                      "bitcast 0 -> float is 0.0");

		///////////////////////
		// float -> int       //
		///////////////////////

		// 1.0f has bit pattern 0x3F800000 = 1065353216
		c : float = 1.0f;
		ci : int = #bitcast(c, int);
		test(ci == 1065353216,                "bitcast float 1.0 -> int is 0x3F800000");

		// 2.0f has bit pattern 0x40000000 = 1073741824
		d : float = 2.0f;
		di : int = #bitcast(d, int);
		test(di == 1073741824,                "bitcast float 2.0 -> int is 0x40000000");

		// 0.0f has bit pattern 0x00000000 = 0
		e : float = 0.0f;
		ei : int = #bitcast(e, int);
		test(ei == 0,                         "bitcast float 0.0 -> int is 0");

		///////////////////////
		// Round-trip         //
		///////////////////////

		orig_i : int = 1065353216;
		rt_f : float = #bitcast(orig_i, float);
		rt_i : int = #bitcast(rt_f, int);
		test(rt_i == orig_i,                  "int->float->int round-trip preserves bits");

		orig_f : float = 1.5f;
		rt2_i : int = #bitcast(orig_f, int);
		rt2_f : float = #bitcast(rt2_i, float);
		test(rt2_f == orig_f,                 "float->int->float round-trip preserves bits");

		//////////////////////////
		// pointer <-> uint64   //
		//////////////////////////

		// Non-null pointer casts to non-zero
		heap_i : *int = malloc(#sizeof(int));
		p_as_int : uint64 = #bitcast(heap_i, uint64);
		test(p_as_int != 0,                   "bitcast non-null ptr -> uint64 is non-zero");

		// Null pointer casts to zero
		null_p : *int = void;
		null_as_int : uint64 = #bitcast(null_p, uint64);
		test(null_as_int == 0,                "bitcast null ptr -> uint64 is zero");

		// Round-trip: ptr -> uint64 -> ptr, dereference gives same value
		heap_j : *int = malloc(#sizeof(int));
		heap_j[0] = 42;
		j_as_int : uint64 = #bitcast(heap_j, uint64);
		j_back : *int = #bitcast(j_as_int, *int);
		test(j_back[0] == 42,                 "bitcast ptr->uint64->ptr round-trip, deref matches");

		// Two distinct heap allocations produce different uint64 values
		p1 : *int = malloc(#sizeof(int));
		p2 : *int = malloc(#sizeof(int));
		p1_i : uint64 = #bitcast(p1, uint64);
		p2_i : uint64 = #bitcast(p2, uint64);
		test(p1_i != p2_i,                    "bitcast distinct ptrs give distinct uint64 values");
	}
}
