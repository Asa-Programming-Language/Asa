
// LabeledLoopTests
// Tests for labeled loops with break and continue, including nested cases.

@public:
LabeledLoopTests :: module {

    #use Tests.Testing;

    @public:
    runLabeledLoopTests :: () {
        beginSection("Labeled Loops");

        // --- Labeled for: break ---
        count : int = 0;
        outer :: for (i in 0..10) {
            if (i == 5) {
                break outer;
            }
            count = count + 1;
        }
        test(count == 5, "labeled for: break outer exits at i==5");

        // --- Labeled while: break ---
        n : int = 0;
        wloop :: while (n < 100) {
            n = n + 1;
            if (n == 7) {
                break wloop;
            }
        }
        test(n == 7, "labeled while: break exits at n==7");

        // --- Labeled for: continue ---
        // Sum only even numbers 0..9 (0+2+4+6+8 == 20)
        sum : int = 0;
        evens :: for (i in 0..10) {
            if (i % 2 != 0) {
                continue evens;
            }
            sum = sum + i;
        }
        test(sum == 20, "labeled for: continue skips odds, sum of evens 0..9 == 20");

        // --- Labeled while: continue ---
        // Sum only odd numbers 1..9 (1+3+5+7+9 == 25)
        wsum : int = 0;
        k : int = 0;
        odds :: while (k < 10) {
            k = k + 1;
            if (k % 2 == 0) {
                continue odds;
            }
            wsum = wsum + k;
        }
        test(wsum == 25, "labeled while: continue skips evens, sum of odds 1..9 == 25");

        // --- Nested for: break outer from inner ---
        hit : int = 0;
        outer2 :: for (i in 0..5) {
            for (j in 0..5) {
                if (i == 2 && j == 3) {
                    hit = i * 10 + j;
                    break outer2;
                }
            }
        }
        test(hit == 23, "nested for: break outer from inner at i==2 j==3");

        // --- Nested for: continue outer from inner ---
        // Each inner loop hits j==2 and continues outer, so the code after the
        // inner loop never runs. outer iterations still complete via the for range.
        ocount : int = 0;
        outer3 :: for (i in 0..5) {
            for (j in 0..5) {
                if (j == 2) {
                    continue outer3;
                }
            }
            ocount = ocount + 1;
        }
        test(ocount == 0, "nested for: continue outer from inner skips post-inner code");

        // --- Nested while: break outer from inner ---
        wi : int = 0;
        wj : int = 0;
        outerW :: while (wi < 5) {
            wj = 0;
            while (wj < 5) {
                if (wi == 3 && wj == 1) {
                    break outerW;
                }
                wj = wj + 1;
            }
            wi = wi + 1;
        }
        test(wi == 3 && wj == 1, "nested while: break outer from inner at wi==3 wj==1");

        // --- Nested while: continue outer from inner ---
        // Inner loop runs at least once (wj2 starts at 1, not 0) so it always
        // terminates under its own condition; continue outer skips the wcount increment.
        wi2 : int = 0;
        wcount : int = 0;
        outerW2 :: while (wi2 < 5) {
            wj2 : int = 0;
            while (wj2 < 5) {
                wj2 = wj2 + 1;
                if (wj2 == 1) {
                    wi2 = wi2 + 1;
                    continue outerW2;
                }
            }
            wcount = wcount + 1;
        }
        test(wcount == 0, "nested while: continue outer from inner skips outer body");

        // --- Mixed: labeled for outer, while inner - break outer ---
        mval : int = 0;
        outerM :: for (i in 0..10) {
            mi : int = 0;
            while (mi < 10) {
                if (i == 4 && mi == 2) {
                    mval = i * 100 + mi;
                    break outerM;
                }
                mi = mi + 1;
            }
        }
        test(mval == 402, "mixed nested: break labeled for from while at i==4 mi==2");

        // --- Mixed: labeled while outer, for inner - continue outer ---
        // Inner for always hits j==1 and continues outer, so msum never increments.
        msum : int = 0;
        mi2 : int = 0;
        outerM2 :: while (mi2 < 5) {
            mi2 = mi2 + 1;
            for (j in 0..5) {
                if (j == 1) {
                    continue outerM2;
                }
            }
            msum = msum + 1;
        }
        test(msum == 0, "mixed nested: continue labeled while from inner for skips outer body");
    }
}
