
// BooleanTests
// Tests for logical operators: &&, ||, !

@public:
BooleanTests :: module {

	#use Tests.Testing;

	andEvalCount : int = 0;
	orEvalCount  : int = 0;

	markTrue :: bool() {
		andEvalCount++;
		return true;
	}

	markFalse :: bool() {
		orEvalCount++;
		return false;
	}

	// runBooleanTests()
	// Runs all logical operator tests.

	@public:
	runBooleanTests :: () {
		beginSection("Boolean Operators");

		// Logical AND
		test(true && true,          "true && true");
		test(!(true && false),      "true && false is false");
		test(!(false && true),      "false && true is false");
		test(!(false && false),     "false && false is false");

		// Logical OR
		test(true || false,         "true || false");
		test(false || true,         "false || true");
		test(true || true,          "true || true");
		test(!(false || false),     "false || false is false");

		// Logical NOT
		test(!false,                "!false is true");
		test(!(true) == false,      "!true is false");
		test(!0,                    "!0 is true");
		test(!(1) == false,         "!1 is false");

		// Combined expressions
		test(1 == 1 && 2 == 2,      "1==1 && 2==2");
		test(1 == 2 || 3 == 3,      "1==2 || 3==3");
		test(!(1 == 2 || 2 == 3),   "!(1==2 || 2==3)");

		// AND with integer operands (non-zero = true)
		test(1 && 1,                "1 && 1");
		test(!(0 && 1),             "0 && 1 is false");
		test(!(1 && 0),             "1 && 0 is false");

		// OR with integer operands
		test(0 || 1,                "0 || 1");
		test(1 || 0,                "1 || 0");
		test(!(0 || 0),             "0 || 0 is false");

		// Operator precedence: && binds tighter than ||
		test(false && false || true,  "false && false || true  (||  wins)");
		test(true || false && false,  "true || false && false  (&&  first)");

		// Short-circuit evaluation
		andEvalCount = 0;
		test(!(false && markTrue()), "false && rhs short-circuits");
		test(andEvalCount == 0,      "false && rhs was not evaluated");
		test(true && markTrue(),     "true && rhs still evaluates");
		test(andEvalCount == 1,      "true && rhs evaluated once");

		orEvalCount = 0;
		test(true || markFalse(),     "true || rhs short-circuits");
		test(orEvalCount == 0,        "true || rhs was not evaluated");
		test(!(false || markFalse()), "false || rhs still evaluates");
		test(orEvalCount == 1,        "false || rhs evaluated once");
	}
}
