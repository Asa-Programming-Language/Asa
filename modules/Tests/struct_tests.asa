
// StructTests
// Tests for struct definitions, member field access, and member functions.

@public:
StructTests :: module {

	#import Tests.Testing;
	#import Builtin.Memory;

	///////////////////////
	// Struct definitions //
	///////////////////////

	Point :: struct {
		x : int;
		y : int;
	}

	Box :: struct {
		x      : int;
		y      : int;
		width  : int;
		height : int;

		area :: int() {
			return this.width * this.height;
		}

		perimeter :: int() {
			return 2 * (this.width + this.height);
		}

		contains :: bool(px : int, py : int) {
			return px >= this.x && px < this.x + this.width &&
			       py >= this.y && py < this.y + this.height;
		}
	}

	Counter :: struct {
		value : int;

		increment :: () {
			this.value += 1;
		}

		add :: (n : int) {
			this.value += n;
		}

		reset :: () {
			this.value = 0;
		}

		get :: int() {
			return this.value;
		}
	}

	// Large struct: 5 x int32 = 20 bytes, exceeds 16-byte register limit
	BigStruct :: struct {
		a : int;
		b : int;
		c : int;
		d : int;
		e : int;
	}

	sumBigStruct :: int(s : BigStruct) {
		return s.a + s.b + s.c + s.d + s.e;
	}

	makeBigStruct :: BigStruct(a : int, b : int, c : int, d : int, e : int) {
		s : BigStruct = BigStruct();
		s.a = a; s.b = b; s.c = c; s.d = d; s.e = e;
		return s;
	}

	// Returns a mutated copy:original must be unaffected (pass-by-value semantics)
	mutatedCopy :: BigStruct(s : BigStruct) {
		s.a = 999;
		s.e = 999;
		return s;
	}

	IntPair :: struct {
		a : int;
		b : int;

		clone :: IntPair() {
			return this;
		}

		swapped :: IntPair() {
			res : IntPair = IntPair();
			res.a = this.b;
			res.b = this.a;
			return res;
		}

		withA :: IntPair(newA : int) {
			res : IntPair = IntPair();
			res.a = newA;
			res.b = this.b;
			return res;
		}
	}

	// Struct with a nested struct field, for chained array[i].field.subfield tests
	Nested :: struct {
		pos : IntPair;
		id  : int;
	}

	g_arr   : *IntPair = void;  // global array pointer for global arr[i].field test
	g_narr  : *Nested = void;  // global array for arr[i].structField in loop

	st_g_pair : IntPair = IntPair();

	makeIntPair :: IntPair(a : int, b : int) {
		p : IntPair = IntPair();
		p.a = a;
		p.b = b;
		return p;
	}

	getGlobalPairPtr :: *IntPair() {
		return &st_g_pair;
	}

	sumIntPair :: int(p : IntPair) {
		return p.a + p.b;
	}

	@public:
	runStructTests :: () {
		beginSection("Structs");

		///////////////////////////////
		// Basic field access        //
		///////////////////////////////

		p : Point = Point();
		p.x = 3;
		p.y = 7;
		test(p.x == 3,                        "struct: field write/read x");
		test(p.y == 7,                        "struct: field write/read y");

		p.x = p.x + p.y;
		test(p.x == 10,                       "struct: field update using other field");

		///////////////////////////////
		// Member function: return   //
		///////////////////////////////

		r : Box = Box();
		r.x = 0;
		r.y = 0;
		r.width = 5;
		r.height = 4;

		test(r.area()      == 20,             "member fn: area() == width*height");
		test(r.perimeter() == 18,             "member fn: perimeter() == 2*(w+h)");

		r.width = 3;
		r.height = 3;
		test(r.area()      == 9,              "member fn: area() after field change");
		test(r.perimeter() == 12,             "member fn: perimeter() after field change");

		///////////////////////////////
		// Member fn with params     //
		///////////////////////////////

		r2 : Box = Box();
		r2.x = 10;
		r2.y = 20;
		r2.width = 5;
		r2.height = 5;
		test(r2.contains(12, 22),             "member fn: contains() true for interior point");
		test(r2.contains(10, 20),             "member fn: contains() true for top-left corner");
		test(!r2.contains(15, 20),            "member fn: contains() false at right edge (exclusive)");
		test(!r2.contains(5, 22),             "member fn: contains() false left of rect");
		test(!r2.contains(12, 10),            "member fn: contains() false above rect");

		///////////////////////////////
		// Member fn mutates state   //
		///////////////////////////////

		c : Counter = Counter();
		c.value = 0;
		test(c.get() == 0,                    "member fn: get() returns initial value");

		c.increment();
		test(c.get() == 1,                    "member fn: increment() mutates this.value");

		c.increment();
		c.increment();
		test(c.get() == 3,                    "member fn: repeated increment() accumulates");

		c.add(10);
		test(c.get() == 13,                   "member fn: add(n) adds to this.value");

		c.reset();
		test(c.get() == 0,                    "member fn: reset() sets this.value to 0");

		///////////////////////////////
		// Two independent instances //
		///////////////////////////////

		c1 : Counter = Counter();
		c2 : Counter = Counter();
		c1.value = 0;
		c2.value = 0;

		c1.add(5);
		c2.add(99);
		test(c1.get() == 5,                   "two instances: c1 is independent from c2");
		test(c2.get() == 99,                  "two instances: c2 is independent from c1");

		c1.reset();
		test(c1.get() == 0,                   "two instances: reset c1 does not affect c2");
		test(c2.get() == 99,                  "two instances: c2 unchanged after c1.reset()");

		///////////////////////////////
		// Member fn returning struct //
		///////////////////////////////

		orig : IntPair = IntPair();
		orig.a = 3;
		orig.b = 7;

		copy : IntPair = orig.clone();
		test(copy.a == 3,                     "struct return: clone().a matches original");
		test(copy.b == 7,                     "struct return: clone().b matches original");

		// mutating copy must not affect orig
		copy.a = 99;
		test(orig.a == 3,                     "struct return: clone is independent (orig.a unchanged)");
		test(copy.a == 99,                    "struct return: clone mutation visible on copy");

		sw : IntPair = orig.swapped();
		test(sw.a == 7,                       "struct return: swapped().a == orig.b");
		test(sw.b == 3,                       "struct return: swapped().b == orig.a");
		test(orig.a == 3,                     "struct return: swapped() does not mutate orig.a");
		test(orig.b == 7,                     "struct return: swapped() does not mutate orig.b");

		wa : IntPair = orig.withA(42);
		test(wa.a == 42,                      "struct return: withA(42).a == 42");
		test(wa.b == 7,                       "struct return: withA(42).b == orig.b");
		test(orig.a == 3,                     "struct return: withA() does not mutate orig.a");

		///////////////////////////////
		// Large struct (> 16 bytes) //
		///////////////////////////////

		bs : BigStruct = BigStruct();
		bs.a = 1; bs.b = 2; bs.c = 3; bs.d = 4; bs.e = 5;
		test(sumBigStruct(bs) == 15,          "large struct: pass by value, sum all 5 fields");

		bs2 : BigStruct = makeBigStruct(10, 20, 30, 40, 50);
		test(bs2.a == 10,                     "large struct: return, field a");
		test(bs2.b == 20,                     "large struct: return, field b");
		test(bs2.c == 30,                     "large struct: return, field c");
		test(bs2.d == 40,                     "large struct: return, field d");
		test(bs2.e == 50,                     "large struct: return, field e");

		bs3 : BigStruct = BigStruct();
		bs3.a = 42; bs3.b = 7; bs3.c = 0; bs3.d = 0; bs3.e = 13;
		mc : BigStruct = mutatedCopy(bs3);
		test(bs3.a == 42,                     "large struct: original.a unchanged after mutatedCopy");
		test(bs3.e == 13,                     "large struct: original.e unchanged after mutatedCopy");
		test(mc.a  == 999,                    "large struct: copy.a mutated inside function");
		test(mc.e  == 999,                    "large struct: copy.e mutated inside function");
		test(mc.b  == 7,                      "large struct: copy.b unchanged field carried through");

		/////////////////////////////////////////
		// Function call result member access  //
		/////////////////////////////////////////

		// struct returned by value: functionCall(args).field
		test(makeIntPair(10, 20).a == 10,     "call result: by-value return .a");
		test(makeIntPair(10, 20).b == 20,     "call result: by-value return .b");
		test(makeIntPair(3, 7).a + makeIntPair(3, 7).b == 10, "call result: sum of fields");

		// struct returned by pointer: ptrReturningFn().field
		st_g_pair.a = 55;
		st_g_pair.b = 77;
		test(getGlobalPairPtr().a == 55,      "call result: ptr return .a");
		test(getGlobalPairPtr().b == 77,      "call result: ptr return .b");

		//////////////////////////////////////////////
		// Array element member access: arr[i].field //
		//////////////////////////////////////////////

		arr : *IntPair = malloc(4 * #sizeof(IntPair));
		arr[0] = makeIntPair(10, 20);
		arr[1] = makeIntPair(30, 40);
		arr[2] = makeIntPair(50, 60);

		test(arr[0].a == 10,                  "arr[i].field: arr[0].a");
		test(arr[0].b == 20,                  "arr[i].field: arr[0].b");
		test(arr[1].a == 30,                  "arr[i].field: arr[1].a");
		test(arr[1].b == 40,                  "arr[i].field: arr[1].b");
		test(arr[2].a == 50,                  "arr[i].field: arr[2].a");

		// Loop-variable index
		sum : int = 0;
		for (k : 0..3) {
			sum += arr[k].a;
		}
		test(sum == 90,                       "arr[i].field in loop: sum of .a");

		// Same pattern with a global pointer
		g_arr = malloc(2 * #sizeof(IntPair));
		g_arr[0] = makeIntPair(77, 88);
		g_arr[1] = makeIntPair(99, 11);
		test(g_arr[0].a == 77,                "global arr[i].field: g_arr[0].a");
		test(g_arr[0].b == 88,                "global arr[i].field: g_arr[0].b");
		test(g_arr[1].a == 99,                "global arr[i].field: g_arr[1].a");

		// Global array with a struct-type field, accessed in a loop
		g_narr = malloc(3 * #sizeof(Nested));
		for (m : 0..3) {
			g_narr[m] = Nested();
			g_narr[m].pos = makeIntPair(m*10, m*10+1);
			g_narr[m].id = m * 100;
		}
		sumIds : int = 0;
		for (m : 0..3) {
			sumIds += g_narr[m].id;
		}
		test(sumIds == 300,                   "global arr[i].structField in loop: sum ids");
		test(g_narr[0].pos.a == 0,            "global arr[i].structField.sub: narr[0].pos.a");
		test(g_narr[1].pos.a == 10,           "global arr[i].structField.sub: narr[1].pos.a");
		test(g_narr[2].pos.a == 20,           "global arr[i].structField.sub: narr[2].pos.a");

		//////////////////////////////////////////////////
		// Chained array[i].struct_field.subfield        //
		//////////////////////////////////////////////////

		narr : *Nested = malloc(2 * #sizeof(Nested));
		narr[0] = Nested();
		narr[0].pos = makeIntPair(7, 8);
		narr[0].id  = 100;
		narr[1] = Nested();
		narr[1].pos = makeIntPair(11, 22);
		narr[1].id  = 200;

		test(narr[0].pos.a == 7,              "arr[i].nested.field: narr[0].pos.a");
		test(narr[0].pos.b == 8,              "arr[i].nested.field: narr[0].pos.b");
		test(narr[0].id    == 100,            "arr[i].field: narr[0].id");
		test(narr[1].pos.a == 11,             "arr[i].nested.field: narr[1].pos.a");
		test(narr[1].pos.b == 22,             "arr[i].nested.field: narr[1].pos.b");
		test(narr[1].id    == 200,            "arr[i].field: narr[1].id");

		//////////////////////////////////////////////////
		// Single-arg fn call with arr[i].structField   //
		//////////////////////////////////////////////////

		pnarr : *Nested = malloc(2 * #sizeof(Nested));
		pnarr[0] = Nested();
		pnarr[0].pos = makeIntPair(3, 4);
		pnarr[1] = Nested();
		pnarr[1].pos = makeIntPair(5, 6);

		test(sumIntPair(pnarr[0].pos) == 7,   "single-arg fn(arr[i].structField): pnarr[0].pos");
		test(sumIntPair(pnarr[1].pos) == 11,  "single-arg fn(arr[i].structField): pnarr[1].pos");
	}
}
