
// AttributeTests
// Tests for attribute declaration and .@ attribute access.

@public:
AttributeTests :: module {

    #import Tests.Testing;

    // Subjects used by the tests below

    @public:
    @inline:
    @noast:
    publicInlineNoast :: () {}

    @public:
    publicOnly :: () {}

    @private:
    privateOnly :: () {}

    @inline:
    inlineOnly :: () {}

    @deprecated("old api"):
    deprecatedOnly :: () {}

    @removed("gone"):
    removedOnly :: () {}

    @noast:
    noastOnly :: () {}

    // Custom attributes (any name not already defined creates a new attribute)

    @color("red"):
    @priority(3):
    @enabled:
    customTagged :: () {}

    @color("blue"):
    @priority(1):
    otherCustom :: () {}

    @deprecated("old var"):
    deprecatedVar : int = 99;

    @removed("gone var"):
    removedVar : int = 0;

    @public:
    {
        scopePublic :: () {}
        @private:
        scopePrivateOverride :: () {}
    }

    @deprecated("scope old"):
    @inline:
    {
        scopeDeprecatedInline :: () {}
    }

    directiveRemoved :: () {}
    directiveNotRemoved :: () {}

    #set_attribute(directiveRemoved, "removed", true);
    #if(false, {
        #set_attribute(directiveNotRemoved, "removed", true);
    });

    @public:
    inheritedModuleAttrs :: module {
        inheritedPublic :: () {}
        @private:
        privateOverride :: () {}
    }

    // runAttributeTests()
    // Runs all attribute tests.

    @public:
    runAttributeTests :: () {
        beginSection("Attributes");

        // @public
        test(publicOnly.@public == true,             "@public present -> true");
        test(publicInlineNoast.@public == true,      "@public present alongside others -> true");
        test(inlineOnly.@public == false,            "@public absent -> false");
        test(privateOnly.@public == false,           "explicit @private does not imply @public");

        // @private
        test(privateOnly.@private == true,           "@private present -> true");
        test(publicOnly.@private == false,           "@private absent -> false");

        // @inline
        test(inlineOnly.@inline == true,             "@inline present -> true");
        test(publicInlineNoast.@inline == true,      "@inline present alongside others -> true");
        test(publicOnly.@inline == false,            "@inline absent -> false");

        // @noast
        test(noastOnly.@noast == true,               "@noast present -> true");
        test(publicInlineNoast.@noast == true,       "@noast present alongside others -> true");
        test(publicOnly.@noast == false,             "@noast absent -> false");

        // @deprecated - string argument
        test(deprecatedOnly.@deprecated == "old api", "@deprecated -> message string");
        test(publicOnly.@deprecated == false,         "@deprecated absent -> false");

        // @removed - string argument
        test(removedOnly.@removed == "gone",          "@removed -> message string");
        test(publicOnly.@removed == false,            "@removed absent -> false");

        // Custom attribute - no args -> true/false
        test(customTagged.@enabled == true,           "@enabled (custom, no args) present -> true");
        test(otherCustom.@enabled == false,           "@enabled absent -> false");

        // Custom attribute - string arg
        test(customTagged.@color == "red",            "@color on customTagged -> \"red\"");
        test(otherCustom.@color == "blue",            "@color on otherCustom -> \"blue\"");
        test(publicOnly.@color == false,              "@color absent -> false");

        // Custom attribute - integer arg
        p : int = customTagged.@priority;
        test(p == 3,                                  "@priority on customTagged -> 3");
        test(otherCustom.@priority == 1,              "@priority on otherCustom -> 1");
        test(publicOnly.@priority == false,           "@priority absent -> false");

        // Manual scope attribute inheritance
        test(scopePublic.@public == true,              "scope @public is inherited by child");
        test(scopePrivateOverride.@private == true,    "scope child keeps explicit @private");
        test(scopePrivateOverride.@public == false,    "scope child blocks incompatible inherited @public");
        test(scopeDeprecatedInline.@deprecated == "scope old", "scope string attribute is inherited by child");
        test(scopeDeprecatedInline.@inline == true,    "multiple scope attributes are inherited by child");

        // #set_attribute
        test(#compiles(directiveRemoved()) == false,  "#set_attribute applies during codegen");
        test(#compiles(directiveNotRemoved()),        "#set_attribute does not run inside false #if");

        // Module attributes are not manually inherited into children
        test(inheritedPublic.@public == false,  "module attributes are not copied to children");
        test(privateOverride.@private == true,  "explicit child attribute is kept");
        test(privateOverride.@public == false,  "module @public is not copied over explicit child attributes");

        // .@ result used in control flow
        x : int = 0;
        if (customTagged.@enabled) {
            x = 1;
        }
        test(x == 1, "custom .@enabled truthy in if condition");

        if (otherCustom.@enabled == false) {
            x = 2;
        }
        test(x == 2, "custom .@enabled absent - false branch taken");

        if (publicInlineNoast.@inline) {
            x = 3;
        }
        test(x == 3, ".@inline truthy in if condition");

        // @deprecated - calling a deprecated function should still compile (warning only)
        test(#compiles(deprecatedOnly()),              "@deprecated function call still compiles");

        // @removed - calling a removed function should not compile (error)
        test(#compiles(removedOnly()) == false,        "@removed function call does not compile");

        // @deprecated - reading a deprecated variable should still compile (warning only)
        test(#compiles(deprecatedVar + 0),             "@deprecated variable read still compiles");

        // @removed - reading a removed variable should not compile (error)
        test(#compiles(removedVar + 0) == false,       "@removed variable read does not compile");
    }
}
