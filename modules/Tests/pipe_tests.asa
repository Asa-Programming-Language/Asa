
// PipeTests
// Tests for the pipe operator (->) and the $ placeholder.

@public:
PipeTests :: module {

	#use Tests.Testing;
	#use Builtin.Math;

	addOne :: int(x : const int) {
		return x + 1;
	}

	timesTwo :: int(x : const int) {
		return x * 2;
	}

	sum :: int(a : const int, b : const int) {
		return a + b;
	}

	// runPipeTests()
	// Runs all pipe operator tests.

	@public:
	runPipeTests :: () {
		beginSection("Pipe");

		// Basic pipe: $ as first argument
		test((5 -> addOne($)) == 6,           "5 -> addOne($) == 6");

		// Basic pipe: $ as second argument
		test((3 -> sum(10, $)) == 13,         "3 -> sum(10, $) == 13");

		// Basic pipe: $ as first argument, two-param function
		test((7 -> sum($, 3)) == 10,          "7 -> sum($, 3) == 10");

		// Pipe with abs
		test((-4 -> abs($)) == 4,             "-4 -> abs($) == 4");

		// Pipe with clamp: $ as first arg
		test((5 -> clamp($, 0, 3)) == 3,      "5 -> clamp($, 0, 3) == 3");
		test((-1 -> clamp($, 0, 10)) == 0,    "-1 -> clamp($, 0, 10) == 0");
		test((5 -> clamp($, 0, 10)) == 5,     "5 -> clamp($, 0, 10) == 5");

		// Chained pipes
		test((3 -> addOne($) -> timesTwo($)) == 8,   "3 -> addOne($) -> timesTwo($) == 8");
		test((0 -> addOne($) -> addOne($)) == 2,   "0 -> addOne -> addOne chain == 2");

		// Pipe result stored in variable
		piped : int = 6 -> timesTwo($);
		test(piped == 12,                     "stored pipe result: 6 -> timesTwo($) == 12");

		// Pipe with expression on left
		test(((2 + 3) -> timesTwo($)) == 10,    "(2+3) -> timesTwo($) == 10");
	}
}
