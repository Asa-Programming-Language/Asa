
// Module: Raylib
// Description: |
//     Bindings for the raylib 5.0 game development library.
//
//     To compile a program that uses this module, make sure you have the raylib libraries installed in your `lib` folder.
//
//     Example:
//     ```asa
//     #import Rendering.Raylib;
//
//     main :: () {
//         InitWindow(800, 600, "Hello, raylib!");
//         SetTargetFPS(60);
//         while (WindowShouldClose() == false) {
//             BeginDrawing();
//                 ClearBackground(RAYWHITE);
//                 DrawText("Hello, World!", 10, 10, 20, RED);
//             EndDrawing();
//         }
//         CloseWindow();
//     }
//     ```
@public:
Raylib :: module {

	#import Builtin.Casts;
	#import Builtin.String;
	#import Builtin.Math;

	#library "raylib";

	///////////////////////
	// Structs           //
	///////////////////////

	// Struct: Color32
	// Description: RGBA color value (4 x uint8)
	@public:
	@packed:
	Color32 :: struct {
		// Variable: r
		// Description: The red color value
		r : uint8;
		// Variable: g
		// Description: The green color value
		g : uint8;
		// Variable: b
		// Description: The blue color value
		b : uint8;
		// Variable: a
		// Description: The alpha color value
		a : uint8;
	}

	// Constructor: Color32(r, g, b, a)
	// Description: Creates a Color32 from individual RGBA components (0-255 each)
	@public:
	@inline:
	create :: Color32(r : int, g : int, b : int, a : int = 255) {
		c : Color32 = Color32();
		c.r = uint8(r);
		c.g = uint8(g);
		c.b = uint8(b);
		c.a = uint8(a);
		return c;
	}

	// Constructor: Color32(l)
	// Description: Creates a grayscale Color32 from a single integer component (0-255)
	@public:
	@inline:
	create :: Color32(l : int) {
		c : Color32 = Color32();
		c.r = uint8(l);
		c.g = uint8(l);
		c.b = uint8(l);
		c.a = uint8(255);
		return c;
	}

	@public:
	@inline:
	operator== :: bool(l : Color32, r : Color32){
		return l.r == r.r && l.g == r.g && l.b == r.b && l.a == r.a;
	}

	@public:
	@inline:
	operator* :: Color32(l : float, r : Color32){
		r.r *= l;
		r.g *= l;
		r.b *= l;
		return r;
	}

	@public:
	{
		// Predefined color constants matching raylib's built-in palette
		LIGHTGRAY  : Color32 = Color32(200, 200, 200, 255);
		GRAY       : Color32 = Color32(130, 130, 130, 255);
		DARKGRAY   : Color32 = Color32(80,  80,  80,  255);
		YELLOW     : Color32 = Color32(253, 249, 0,   255);
		GOLD       : Color32 = Color32(255, 203, 0,   255);
		ORANGE     : Color32 = Color32(255, 161, 0,   255);
		PINK       : Color32 = Color32(255, 109, 194, 255);
		RED        : Color32 = Color32(230, 41,  55,  255);
		MAROON     : Color32 = Color32(190, 33,  55,  255);
		GREEN      : Color32 = Color32(0,   228, 48,  255);
		LIME       : Color32 = Color32(0,   158, 47,  255);
		DARKGREEN  : Color32 = Color32(0,   117, 44,  255);
		SKYBLUE    : Color32 = Color32(102, 191, 255, 255);
		BLUE       : Color32 = Color32(0,   121, 241, 255);
		DARKBLUE   : Color32 = Color32(0,   82,  172, 255);
		PURPLE     : Color32 = Color32(200, 122, 255, 255);
		VIOLET     : Color32 = Color32(135, 60,  190, 255);
		DARKPURPLE : Color32 = Color32(112, 31,  126, 255);
		BEIGE      : Color32 = Color32(211, 176, 131, 255);
		BROWN      : Color32 = Color32(127, 106, 79,  255);
		DARKBROWN  : Color32 = Color32(76,  63,  47,  255);
		WHITE      : Color32 = Color32(255, 255, 255, 255);
		BLACK      : Color32 = Color32(0,   0,   0,   255);
		BLANK      : Color32 = Color32(0,   0,   0,   0);
		MAGENTA    : Color32 = Color32(255, 0,   255, 255);
		RAYWHITE   : Color32 = Color32(245, 245, 245, 255);
	}

	// Struct: Vector4
	// Description: 4D vector with float components; also used as Quaternion
	@public:
	Vector4 :: struct {
		// Variable: x
		// Description: X component
		x : float;
		// Variable: y
		// Description: Y component
		y : float;
		// Variable: z
		// Description: Z component
		z : float;
		// Variable: w
		// Description: W component
		w : float;
	}

	// Struct: Matrix
	// Description: 4x4 matrix, column major, OpenGL style, right-handed
	@public:
	Matrix :: struct {
		m0  : float; m4  : float; m8  : float; m12 : float;
		m1  : float; m5  : float; m9  : float; m13 : float;
		m2  : float; m6  : float; m10 : float; m14 : float;
		m3  : float; m7  : float; m11 : float; m15 : float;
	}

	// Struct: Image
	// Description: Image pixel data stored in CPU memory (RAM)
	@public:
	Image :: struct {
		// Variable: data
		// Description: A pointer to the image pixel data
		data    : *uint8;
		// Variable: width
		// Description: The width of the image in pixels
		width   : int;
		// Variable: height
		// Description: The height of the image in pixels
		height  : int;
		// Variable: mipmaps
		// Description: The number of mipmaps of the image
		mipmaps : int;
		// Variable: format
		// Description: The format of the image
		format  : int;
	}

	// Struct: Texture2D
	// Description: Texture data stored in GPU memory (VRAM)
	@public:
	Texture2D :: struct {
		id      : uint32;
		// Variable: width
		// Description: The width of the image in pixels
		width   : int;
		// Variable: height
		// Description: The height of the image in pixels
		height  : int;
		// Variable: mipmaps
		// Description: The number of mipmaps of the image
		mipmaps : int;
		// Variable: format
		// Description: The format of the image
		format  : int;
	}

	// Struct: RenderTexture2D
	// Description: Framebuffer for off-screen rendering; contains colour and depth textures
	@public:
	RenderTexture2D :: struct {
		id      : uint32;
		// Variable: texture
		// Description: The texture value of the render texture
		texture : Texture2D;
		// Variable: depth
		// Description: The depth texture of the render texture
		depth   : Texture2D;
	}

	// Struct: NPatchInfo
	// Description: N-patch layout info for 9-slice / 3-slice textures
	@public:
	NPatchInfo :: struct {
		// Variable: source
		// Description: Texture source rectangle
		source : Rect;
		// Variable: left
		// Description: Left border offset
		left   : int;
		// Variable: top
		// Description: Top border offset
		top    : int;
		// Variable: right
		// Description: Right border offset
		right  : int;
		// Variable: bottom
		// Description: Bottom border offset
		bottom : int;
		// Variable: layout
		// Description: Layout type: 3x3, 1x3 or 3x1
		layout : int;
	}

	// Struct: GlyphInfo
	// Description: Font character glyph info
	@public:
	GlyphInfo :: struct {
		// Variable: value
		// Description: Character Unicode codepoint
		value    : int;
		// Variable: offsetX
		// Description: Character X offset when drawing
		offsetX  : int;
		// Variable: offsetY
		// Description: Character Y offset when drawing
		offsetY  : int;
		// Variable: advanceX
		// Description: Character advance X position
		advanceX : int;
		// Variable: image
		// Description: Character image data
		image    : Image;
	}

	// Struct: Font
	// Description: Font texture atlas and glyph data
	@public:
	Font :: struct {
		// Variable: baseSize
		// Description: Base size (default chars height)
		baseSize     : int;
		// Variable: glyphCount
		// Description: Number of glyph characters
		glyphCount   : int;
		// Variable: glyphPadding
		// Description: Padding around the glyphs
		glyphPadding : int;
		// Variable: texture
		// Description: Texture atlas containing the glyphs
		texture      : Texture2D;
		// Variable: recs
		// Description: Rectangles in texture for each glyph
		recs         : *Rect;
		// Variable: glyphs
		// Description: Glyph info array
		glyphs       : *GlyphInfo;
	}

	// Struct: Camera3D
	// Description: 3D camera definition
	@public:
	Camera3D :: struct {
		// Variable: position
		// Description: Camera position in world space
		position   : Vector3;
		// Variable: target
		// Description: Point the camera looks at
		target     : Vector3;
		// Variable: up
		// Description: Camera up vector
		up         : Vector3;
		// Variable: fovy
		// Description: Field-of-view Y in degrees (perspective) or near-plane width (orthographic)
		fovy       : float;
		// Variable: projection
		// Description: CAMERA_PERSPECTIVE or CAMERA_ORTHOGRAPHIC
		projection : int;
	}

	// Struct: Camera2D
	// Description: 2D camera definition
	@public:
	Camera2D :: struct {
		// Variable: offset
		// Description: Camera offset (displacement from target)
		offset   : Vector2;
		// Variable: target
		// Description: Camera target (rotation and zoom origin)
		target   : Vector2;
		// Variable: rotation
		// Description: Camera rotation in degrees
		rotation : float;
		// Variable: zoom
		// Description: Camera zoom factor (1.0 = default)
		zoom     : float;
	}

	// Struct: Shader
	// Description: GPU shader program
	@public:
	Shader :: struct {
		// Variable: id
		// Description: OpenGL shader program id
		id   : uint32;
		// Variable: locs
		// Description: Shader locations array
		locs : *int;
	}

	// Struct: MaterialMap
	// Description: Material texture map entry
	@public:
	MaterialMap :: struct {
		// Variable: texture
		// Description: Map texture
		texture : Texture2D;
		// Variable: color
		// Description: Map color tint
		color   : Color32;
		// Variable: value
		// Description: Map value (metalness, roughness, etc.)
		value   : float;
	}

	// Struct: Mesh
	// Description: Vertex data for a GPU mesh (matches C Mesh layout)
	@public:
	Mesh :: struct {
		vertexCount   : int;       // Number of vertices
		triangleCount : int;       // Number of triangles
		vertices      : *float;    // Vertex positions (XYZ)
		texcoords     : *float;    // UV coords (UV)
		texcoords2    : *float;    // Second UV coords
		normals       : *float;    // Vertex normals (XYZ)
		tangents      : *float;    // Vertex tangents (XYZW)
		colors        : *uint8;    // Vertex colors (RGBA)
		indices       : *uint16;   // Vertex indices
		animVertices  : *float;    // Animated vertex positions
		animNormals   : *float;    // Animated normals
		boneIds       : *uint8;    // Bone ids (skinning)
		boneWeights   : *float;    // Bone weights (skinning)
		vaoId         : uint32;    // OpenGL VAO id
		vboId         : *uint32;   // OpenGL VBO ids
	}

	// Struct: Material
	// Description: Material with shader, maps, and generic params
	@public:
	Material :: struct {
		shader  : Shader;       // Material shader
		maps    : *MaterialMap; // Material maps array
		param0  : float;        // Generic param 0
		param1  : float;        // Generic param 1
		param2  : float;        // Generic param 2
		param3  : float;        // Generic param 3
	}

	// Struct: Model
	// Description: 3D model with meshes, materials, and optional animation data
	@public:
	Model :: struct {
		transform     : Matrix;    // Local transform matrix
		meshCount     : int;       // Number of meshes
		materialCount : int;       // Number of materials
		meshes        : *Mesh;     // Meshes array
		materials     : *Material; // Materials array
		meshMaterial  : *int;      // Mesh material index per mesh
		boneCount     : int;       // Number of bones
		bones         : *uint8;    // Bones (BoneInfo*, opaque)
		bindPose      : *uint8;    // Bind pose (Transform*, opaque)
	}

	// Struct: ModelAnimation
	// Description: Model animation keyframe data
	@public:
	ModelAnimation :: struct {
		boneCount  : int;    // Number of bones
		frameCount : int;    // Number of frames
		bones      : *uint8; // Bones info (BoneInfo*, opaque)
		framePoses : *uint8; // Frame poses (Transform**, opaque)
		name0      : uint32; // Animation name (32 bytes, 8 x uint32)
		name1      : uint32;
		name2      : uint32;
		name3      : uint32;
		name4      : uint32;
		name5      : uint32;
		name6      : uint32;
		name7      : uint32;
	}

	// Struct: FilePathList
	// Description: List of file paths (returned by LoadDroppedFiles, etc.)
	@public:
	FilePathList :: struct {
		capacity : uint32; // Max entries
		count    : uint32; // Number of entries
		paths    : **char; // Array of file path strings
	}

	// Struct: Ray
	// Description: Ray for raycasting (position + direction)
	@public:
	Ray :: struct {
		// Variable: position
		// Description: Ray origin
		position  : Vector3;
		// Variable: direction
		// Description: Ray direction (should be normalized)
		direction : Vector3;
	}

	// Struct: RayCollision
	// Description: Hit information from a raycast
	@public:
	RayCollision :: struct {
		// Variable: hit
		// Description: Whether the ray hit something
		hit      : bool;
		// Variable: distance
		// Description: Distance to the nearest hit
		distance : float;
		// Variable: point
		// Description: World position of the hit
		point    : Vector3;
		// Variable: normal
		// Description: Surface normal at the hit point
		normal   : Vector3;
	}

	// Struct: BoundingBox
	// Description: Axis-aligned bounding box
	@public:
	BoundingBox :: struct {
		// Variable: min
		// Description: Minimum vertex corner
		min : Vector3;
		// Variable: max
		// Description: Maximum vertex corner
		max : Vector3;
	}

	// Struct: Wave
	// Description: Audio wave data (CPU memory)
	@public:
	Wave :: struct {
		// Variable: frameCount
		// Description: Total number of frames (samples / channels)
		frameCount : uint32;
		// Variable: sampleRate
		// Description: Frequency in samples per second
		sampleRate : uint32;
		// Variable: sampleSize
		// Description: Bit depth (8, 16, or 32)
		sampleSize : uint32;
		// Variable: channels
		// Description: Number of channels (1 = mono, 2 = stereo)
		channels   : uint32;
		// Variable: data
		// Description: Raw sample data pointer
		data       : *uint8;
	}

	// Struct: AudioStream
	// Description: Raw audio stream for custom audio
	@public:
	AudioStream :: struct {
		// Variable: buffer
		// Description: Internal audio system buffer (opaque)
		buffer     : *uint8;
		// Variable: processor
		// Description: Internal audio processor (opaque)
		processor  : *uint8;
		// Variable: sampleRate
		// Description: Frequency in samples per second
		sampleRate : uint32;
		// Variable: sampleSize
		// Description: Bit depth (8, 16, or 32)
		sampleSize : uint32;
		// Variable: channels
		// Description: Number of channels
		channels   : uint32;
	}

	// Struct: Sound
	// Description: Audio sound (loaded into memory)
	@public:
	Sound :: struct {
		// Variable: stream
		// Description: Underlying audio stream
		stream     : AudioStream;
		// Variable: frameCount
		// Description: Total number of frames
		frameCount : uint32;
	}

	// Struct: Music
	// Description: Music stream (streamed from file)
	@public:
	Music :: struct {
		// Variable: stream
		// Description: Underlying audio stream
		stream     : AudioStream;
		// Variable: frameCount
		// Description: Total number of frames
		frameCount : uint32;
		// Variable: looping
		// Description: Whether the music loops
		looping    : bool;
		// Variable: ctxType
		// Description: Audio context type (file format)
		ctxType    : int;
		// Variable: ctxData
		// Description: Audio context data (opaque pointer)
		ctxData    : *uint8;
	}

	///////////////////////
	// Window            //
	///////////////////////

	@public:
	{
		// Function: InitWindow(width, height, title)
		// Description: Initialises the window and OpenGL context
		#extern InitWindow :: (width : int, height : int, title : *char);

		// Function: CloseWindow()
		// Description: Closes the window and unloads the OpenGL context
		#extern CloseWindow :: ();

		// Function: WindowShouldClose()
		// Description: Returns true when the user presses Escape or clicks the close button
		#extern WindowShouldClose :: bool();

		// Function: IsWindowReady()
		// Description: Returns true if the window has been initialized successfully
		#extern IsWindowReady :: bool();

		// Function: IsWindowFullscreen()
		// Description: Returns true if the window is currently in fullscreen mode
		#extern IsWindowFullscreen :: bool();

		// Function: IsWindowHidden()
		// Description: Returns true if the window is currently hidden
		#extern IsWindowHidden :: bool();

		// Function: IsWindowMinimized()
		// Description: Returns true if the window is currently minimized
		#extern IsWindowMinimized :: bool();

		// Function: IsWindowMaximized()
		// Description: Returns true if the window is currently maximized
		#extern IsWindowMaximized :: bool();

		// Function: IsWindowFocused()
		// Description: Returns true if the window is currently focused
		#extern IsWindowFocused :: bool();

		// Function: IsWindowResized()
		// Description: Returns true if the window was resized this frame
		#extern IsWindowResized :: bool();

		// Function: IsWindowState(flag)
		// Description: Returns true if a specific window config flag is enabled
		#extern IsWindowState :: bool(flag : uint32);

		// Function: SetWindowState(flags)
		// Description: Sets window configuration state flags
		#extern SetWindowState :: (flags : uint32);

		// Function: ClearWindowState(flags)
		// Description: Clears window configuration state flags
		#extern ClearWindowState :: (flags : uint32);

		// Function: ToggleFullscreen()
		// Description: Toggles between fullscreen and windowed mode
		#extern ToggleFullscreen :: ();

		// Function: ToggleBorderlessWindowed()
		// Description: Toggles borderless windowed mode
		#extern ToggleBorderlessWindowed :: ();

		// Function: MaximizeWindow()
		// Description: Maximizes the window if it is resizable
		#extern MaximizeWindow :: ();

		// Function: MinimizeWindow()
		// Description: Minimizes the window if it is resizable
		#extern MinimizeWindow :: ();

		// Function: RestoreWindow()
		// Description: Restores the window from minimized or maximized state
		#extern RestoreWindow :: ();

		// Function: SetWindowIcon(image)
		// Description: Sets the window icon from a single RGBA Image
		#extern SetWindowIcon :: (image : Image);

		// Function: SetWindowTitle(title)
		// Description: Sets the window title
		#extern SetWindowTitle :: (title : *char);

		// Function: SetWindowPosition(x, y)
		// Description: Sets the window position on screen
		#extern SetWindowPosition :: (x : int, y : int);

		// Function: SetWindowMonitor(monitor)
		// Description: Moves the window to the specified monitor
		#extern SetWindowMonitor :: (monitor : int);

		// Function: SetWindowMinSize(width, height)
		// Description: Sets the minimum window dimensions (requires FLAG_WINDOW_RESIZABLE)
		#extern SetWindowMinSize :: (width : int, height : int);

		// Function: SetWindowMaxSize(width, height)
		// Description: Sets the maximum window dimensions (requires FLAG_WINDOW_RESIZABLE)
		#extern SetWindowMaxSize :: (width : int, height : int);

		// Function: SetWindowSize(width, height)
		// Description: Sets the window dimensions
		#extern SetWindowSize :: (width : int, height : int);

		// Function: SetWindowOpacity(opacity)
		// Description: Sets window opacity [0.0 .. 1.0]
		#extern SetWindowOpacity :: (opacity : float);

		// Function: SetWindowFocused()
		// Description: Brings the window to focus
		#extern SetWindowFocused :: ();

		// Function: GetScreenWidth()
		// Description: Returns the current screen width in pixels
		#extern GetScreenWidth :: int();

		// Function: GetScreenHeight()
		// Description: Returns the current screen height in pixels
		#extern GetScreenHeight :: int();

		// Function: GetRenderWidth()
		// Description: Returns the current render width (accounts for HiDPI)
		#extern GetRenderWidth :: int();

		// Function: GetRenderHeight()
		// Description: Returns the current render height (accounts for HiDPI)
		#extern GetRenderHeight :: int();

		// Function: GetMonitorCount()
		// Description: Returns the number of connected monitors
		#extern GetMonitorCount :: int();

		// Function: GetCurrentMonitor()
		// Description: Returns the index of the monitor the window is on
		#extern GetCurrentMonitor :: int();

		// Function: GetMonitorPosition(monitor)
		// Description: Returns the position of the specified monitor
		#extern GetMonitorPosition :: Vector2(monitor : int);

		// Function: GetMonitorWidth(monitor)
		// Description: Returns the width of the specified monitor in pixels
		#extern GetMonitorWidth :: int(monitor : int);

		// Function: GetMonitorHeight(monitor)
		// Description: Returns the height of the specified monitor in pixels
		#extern GetMonitorHeight :: int(monitor : int);

		// Function: GetMonitorPhysicalWidth(monitor)
		// Description: Returns the physical width of the monitor in millimetres
		#extern GetMonitorPhysicalWidth :: int(monitor : int);

		// Function: GetMonitorPhysicalHeight(monitor)
		// Description: Returns the physical height of the monitor in millimetres
		#extern GetMonitorPhysicalHeight :: int(monitor : int);

		// Function: GetMonitorRefreshRate(monitor)
		// Description: Returns the refresh rate of the specified monitor
		#extern GetMonitorRefreshRate :: int(monitor : int);

		// Function: GetWindowPosition()
		// Description: Returns the window position as a Vector2
		#extern GetWindowPosition :: Vector2();

		// Function: GetWindowScaleDPI()
		// Description: Returns the window DPI scale factor
		#extern GetWindowScaleDPI :: Vector2();

		// Function: GetMonitorName(monitor)
		// Description: Returns the UTF-8 encoded name of the specified monitor
		#extern GetMonitorName :: *char(monitor : int);

		// Function: SetClipboardText(text)
		// Description: Sets the clipboard text content
		#extern SetClipboardText :: (text : *char);

		// Function: GetClipboardText()
		// Description: Returns the clipboard text content
		#extern GetClipboardText :: *char();

		// Function: EnableEventWaiting()
		// Description: Enables waiting for events on EndDrawing() (no auto polling)
		#extern EnableEventWaiting :: ();

		// Function: DisableEventWaiting()
		// Description: Disables waiting for events (restores automatic polling)
		#extern DisableEventWaiting :: ();

		///////////////////////
		// Cursor            //
		///////////////////////

		// Function: ShowCursor()
		// Description: Shows the mouse cursor
		#extern ShowCursor :: ();

		// Function: HideCursor()
		// Description: Hides the mouse cursor
		#extern HideCursor :: ();

		// Function: IsCursorHidden()
		// Description: Returns true if the cursor is not visible
		#extern IsCursorHidden :: bool();

		// Function: EnableCursor()
		// Description: Unlocks and enables the cursor
		#extern EnableCursor :: ();

		// Function: DisableCursor()
		// Description: Locks and disables the cursor
		#extern DisableCursor :: ();

		// Function: IsCursorOnScreen()
		// Description: Returns true if the cursor is within the window
		#extern IsCursorOnScreen :: bool();

		///////////////////////
		// Drawing           //
		///////////////////////

		// Function: BeginDrawing()
		// Description: Sets up the canvas to start drawing
		#extern BeginDrawing :: ();

		// Function: EndDrawing()
		// Description: Ends canvas drawing and swaps buffers
		#extern EndDrawing :: ();

		// Function: ClearBackground(color)
		// Description: Sets the background colour for this frame
		#extern ClearBackground :: (color : Color32);

		// Function: BeginMode2D(camera)
		// Description: Begins 2D mode with a custom Camera2D
		#extern BeginMode2D :: (camera : Camera2D);

		// Function: EndMode2D()
		// Description: Ends 2D camera mode
		#extern EndMode2D :: ();

		// Function: BeginMode3D(camera)
		// Description: Begins 3D mode with a custom Camera3D
		#extern BeginMode3D :: (camera : Camera3D);

		// Function: EndMode3D()
		// Description: Ends 3D camera mode and returns to 2D orthographic
		#extern EndMode3D :: ();

		// Function: BeginTextureMode(target)
		// Description: Begins drawing to an off-screen render texture
		#extern BeginTextureMode :: (target : RenderTexture2D);

		// Function: EndTextureMode()
		// Description: Ends drawing to the render texture
		#extern EndTextureMode :: ();

		// Function: BeginShaderMode(shader)
		// Description: Begins drawing with a custom shader
		#extern BeginShaderMode :: (shader : Shader);

		// Function: EndShaderMode()
		// Description: Ends custom shader drawing (reverts to default shader)
		#extern EndShaderMode :: ();

		// Function: BeginBlendMode(mode)
		// Description: Begins blending mode (alpha, additive, multiplied, etc.)
		#extern BeginBlendMode :: (mode : int);

		// Function: EndBlendMode()
		// Description: Ends blending mode (resets to alpha blending)
		#extern EndBlendMode :: ();

		// Function: BeginScissorMode(x, y, width, height)
		// Description: Begins scissor mode -- restricts drawing to a screen rectangle
		#extern BeginScissorMode :: (x : int, y : int, width : int, height : int);

		// Function: EndScissorMode()
		// Description: Ends scissor mode
		#extern EndScissorMode :: ();

		///////////////////////
		// Shaders           //
		///////////////////////

		// Function: LoadShader(vsFileName, fsFileName)
		// Description: Loads a shader from vertex and fragment source files
		#extern LoadShader :: Shader(vsFileName : *char, fsFileName : *char);

		// Function: LoadShaderFromMemory(vsCode, fsCode)
		// Description: Loads a shader from vertex and fragment code strings
		#extern LoadShaderFromMemory :: Shader(vsCode : *char, fsCode : *char);

		// Function: IsShaderReady(shader)
		// Description: Returns true if the shader program is ready to use
		#extern IsShaderReady :: bool(shader : Shader);

		// Function: GetShaderLocation(shader, uniformName)
		// Description: Returns the location index of a shader uniform variable
		#extern GetShaderLocation :: int(shader : Shader, uniformName : *char);

		// Function: GetShaderLocationAttrib(shader, attribName)
		// Description: Returns the location index of a shader attribute variable
		#extern GetShaderLocationAttrib :: int(shader : Shader, attribName : *char);

		// Function: SetShaderValue(shader, locIndex, value, uniformType)
		// Description: Sets a shader uniform value (pointer to data)
		#extern SetShaderValue :: (shader : Shader, locIndex : int, value : *uint8, uniformType : int);

		// Function: SetShaderValueV(shader, locIndex, value, uniformType, count)
		// Description: Sets a shader uniform value vector (pointer to data, count elements)
		#extern SetShaderValueV :: (shader : Shader, locIndex : int, value : *uint8, uniformType : int, count : int);

		// Function: SetShaderValueMatrix(shader, locIndex, mat)
		// Description: Sets a shader uniform value of type mat4
		#extern SetShaderValueMatrix :: (shader : Shader, locIndex : int, mat : Matrix);

		// Function: SetShaderValueTexture(shader, locIndex, texture)
		// Description: Sets a shader sampler2d uniform to the given texture
		#extern SetShaderValueTexture :: (shader : Shader, locIndex : int, texture : Texture2D);

		// Function: UnloadShader(shader)
		// Description: Unloads a shader from GPU memory
		#extern UnloadShader :: (shader : Shader);

		///////////////////////
		// Screen-space      //
		///////////////////////

		// Function: GetCameraMatrix2D(camera)
		// Description: Returns the 2D camera transform matrix
		#extern GetCameraMatrix2D :: Matrix(camera : Camera2D);

		// Function: GetScreenToWorld2D(position, camera)
		// Description: Converts a 2D screen-space position to world-space
		#extern GetScreenToWorld2D :: Vector2(position : Vector2, camera : Camera2D);

		// Function: GetWorldToScreen2D(position, camera)
		// Description: Converts a 2D world-space position to screen-space
		#extern GetWorldToScreen2D :: Vector2(position : Vector2, camera : Camera2D);

		// Function: GetWorldToScreen(position, camera)
		// Description: Returns screen-space position for a 3D world-space point
		#extern GetWorldToScreen :: Vector2(position : Vector3, camera : Camera3D);

		// Function: GetWorldToScreenEx(position, camera, width, height)
		// Description: Returns screen-space position for a 3D world-space point with explicit viewport size
		#extern GetWorldToScreenEx :: Vector2(position : Vector3, camera : Camera3D, width : int, height : int);

		// Function: GetCameraMatrix(camera)
		// Description: Returns the 3D camera view matrix
		#extern GetCameraMatrix :: Matrix(camera : Camera3D);

		// Function: GetMouseRay(mousePosition, camera)
		// Description: Returns a ray from the mouse position into 3D world space (deprecated: use GetScreenToWorldRay)
		#extern GetMouseRay :: Ray(mousePosition : Vector2, camera : Camera3D);

		// Function: GetScreenToWorldRay(position, camera)
		// Description: Get a ray trace from the screen position within a camera field-of-view
		#extern GetScreenToWorldRay :: Ray(position : Vector2, camera : Camera3D);

		// Function: GetScreenToWorldRayEx(position, camera, width, height)
		// Description: Get a ray trace from screen position with explicit viewport size
		#extern GetScreenToWorldRayEx :: Ray(position : Vector2, camera : Camera3D, width : int, height : int);

		///////////////////////
		// Timing            //
		///////////////////////

		// Function: SetTargetFPS(fps)
		// Description: Sets the target frames-per-second
		#extern SetTargetFPS :: (fps : int);

		// Function: GetFPS()
		// Description: Returns the current frames-per-second
		#extern GetFPS :: int();

		// Function: GetFrameTime()
		// Description: Returns time in seconds for the last frame drawn (delta time)
		#extern GetFrameTime :: float();

		// Function: GetTime()
		// Description: Returns elapsed time in seconds since InitWindow()
		#extern GetTime :: double();

		// Function: WaitTime(seconds)
		// Description: Halts program execution for the given number of seconds
		#extern WaitTime :: (seconds : double);

		// Function: SwapScreenBuffer()
		// Description: Swaps the back and front screen buffers manually
		#extern SwapScreenBuffer :: ();

		// Function: PollInputEvents()
		// Description: Registers all input events (use with manual frame control)
		#extern PollInputEvents :: ();

		///////////////////////
		// Random            //
		///////////////////////

		// Function: SetRandomSeed(seed)
		// Description: Sets the seed for the random number generator
		#extern SetRandomSeed :: (seed : uint32);

		// Function: GetRandomValue(min, max)
		// Description: Returns a random integer in [min, max] inclusive
		#extern GetRandomValue :: int(min : int, max : int);

		///////////////////////
		// Misc              //
		///////////////////////

		// Function: TakeScreenshot(fileName)
		// Description: Saves a screenshot of the current frame to file
		#extern TakeScreenshot :: (fileName : *char);

		// Function: SetConfigFlags(flags)
		// Description: Sets init configuration flags before InitWindow()
		#extern SetConfigFlags :: (flags : uint32);

		// Function: OpenURL(url)
		// Description: Opens the given URL in the system browser
		#extern OpenURL :: (url : *char);

		// Function: SetTraceLogLevel(logLevel)
		// Description: Sets the minimum log level threshold
		#extern SetTraceLogLevel :: (logLevel : int);

		// Function: MemAlloc(size)
		// Description: Allocates memory (raylib internal allocator)
		#extern MemAlloc :: *uint8(size : uint32);

		// Function: MemRealloc(ptr, size)
		// Description: Reallocates memory (raylib internal allocator)
		#extern MemRealloc :: *uint8(ptr : *uint8, size : uint32);

		// Function: MemFree(ptr)
		// Description: Frees memory allocated by MemAlloc/MemRealloc
		#extern MemFree :: (ptr : *uint8);

		///////////////////////
		// File management   //
		///////////////////////

		// Function: FileExists(fileName)
		// Description: Returns true if the file exists on disk
		#extern FileExists :: bool(fileName : *char);

		// Function: DirectoryExists(dirPath)
		// Description: Returns true if the directory path exists
		#extern DirectoryExists :: bool(dirPath : *char);

		// Function: IsFileExtension(fileName, ext)
		// Description: Returns true if the file has the given extension (e.g. ".png")
		#extern IsFileExtension :: bool(fileName : *char, ext : *char);

		// Function: GetFileLength(fileName)
		// Description: Returns the file size in bytes
		#extern GetFileLength :: int(fileName : *char);

		// Function: GetFileExtension(fileName)
		// Description: Returns a pointer to the extension part of the filename (e.g. ".png")
		#extern GetFileExtension :: *char(fileName : *char);

		// Function: GetFileName(filePath)
		// Description: Returns a pointer to the filename portion of a path
		#extern GetFileName :: *char(filePath : *char);

		// Function: GetFileNameWithoutExt(filePath)
		// Description: Returns the filename without extension (static string)
		#extern GetFileNameWithoutExt :: *char(filePath : *char);

		// Function: GetDirectoryPath(filePath)
		// Description: Returns the directory portion of a path (static string)
		#extern GetDirectoryPath :: *char(filePath : *char);

		// Function: GetPrevDirectoryPath(dirPath)
		// Description: Returns the parent directory of the given path (static string)
		#extern GetPrevDirectoryPath :: *char(dirPath : *char);

		// Function: GetWorkingDirectory()
		// Description: Returns the current working directory (static string)
		#extern GetWorkingDirectory :: *char();

		// Function: GetApplicationDirectory()
		// Description: Returns the directory where the executable resides (static string)
		#extern GetApplicationDirectory :: *char();

		// Function: ChangeDirectory(dir)
		// Description: Changes the working directory; returns true on success
		#extern ChangeDirectory :: bool(dir : *char);

		// Function: IsPathFile(path)
		// Description: Returns true if the path points to a file (false = directory)
		#extern IsPathFile :: bool(path : *char);

		// Function: IsFileDropped()
		// Description: Returns true if files have been dropped onto the window this frame
		#extern IsFileDropped :: bool();

		// Function: LoadDroppedFiles()
		// Description: Load dropped filepaths (call IsFileDropped first)
		#extern LoadDroppedFiles :: FilePathList();

		// Function: UnloadDroppedFiles(files)
		// Description: Unload dropped filepaths
		#extern UnloadDroppedFiles :: (files : FilePathList);

		// Function: LoadDirectoryFiles(dirPath)
		// Description: Load all filepaths in a directory
		#extern LoadDirectoryFiles :: FilePathList(dirPath : *char);

		// Function: LoadDirectoryFilesEx(basePath, filter, scanSubdirs)
		// Description: Load filepaths with filter and optional recursion
		#extern LoadDirectoryFilesEx :: FilePathList(basePath : *char, filter : *char, scanSubdirs : bool);

		// Function: UnloadDirectoryFiles(files)
		// Description: Unload directory filepaths
		#extern UnloadDirectoryFiles :: (files : FilePathList);

		// Function: GetFileModTime(fileName)
		// Description: Returns the last-modified time of the file (Unix timestamp)
		#extern GetFileModTime :: int(fileName : *char);

		// Function: LoadFileData(fileName, dataSize)
		// Description: Loads file contents as a byte array; dataSize is set to the number of bytes
		#extern LoadFileData :: *uint8(fileName : *char, dataSize : *int);

		// Function: UnloadFileData(data)
		// Description: Unloads data loaded by LoadFileData
		#extern UnloadFileData :: (data : *uint8);

		// Function: SaveFileData(fileName, data, dataSize)
		// Description: Saves a byte array to file; returns true on success
		#extern SaveFileData :: bool(fileName : *char, data : *uint8, dataSize : int);

		// Function: LoadFileText(fileName)
		// Description: Loads a text file as a null-terminated string
		#extern LoadFileText :: *char(fileName : *char);

		// Function: UnloadFileText(text)
		// Description: Unloads text loaded by LoadFileText
		#extern UnloadFileText :: (text : *char);

		// Function: SaveFileText(fileName, text)
		// Description: Saves a null-terminated string to a text file; returns true on success
		#extern SaveFileText :: bool(fileName : *char, text : *char);

		// Function: CompressData(data, dataSize, compDataSize)
		// Description: Compresses data using DEFLATE; compDataSize receives the output size
		#extern CompressData :: *uint8(data : *uint8, dataSize : int, compDataSize : *int);

		// Function: DecompressData(compData, compDataSize, dataSize)
		// Description: Decompresses DEFLATE data; dataSize receives the output size
		#extern DecompressData :: *uint8(compData : *uint8, compDataSize : int, dataSize : *int);

		// Function: EncodeDataBase64(data, dataSize, outputSize)
		// Description: Encodes data to a Base64 string; outputSize receives the string length
		#extern EncodeDataBase64 :: *char(data : *uint8, dataSize : int, outputSize : *int);

		// Function: DecodeDataBase64(data, outputSize)
		// Description: Decodes a Base64 string to bytes; outputSize receives the output size
		#extern DecodeDataBase64 :: *uint8(data : *uint8, outputSize : *int);

