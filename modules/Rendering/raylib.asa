		#extern DrawPolyLines :: (center : Vector2, sides : int, radius : float, rotation : float, color : Color32);

		// Function: DrawPolyLinesEx(center, sides, radius, rotation, lineThick, color)
		// Description: Draws the outline of a regular polygon with a given line thickness
		#extern DrawPolyLinesEx :: (center : Vector2, sides : int, radius : float, rotation : float, lineThick : float, color : Color32);

		///////////////////////
		// Collision (2D)    //
		///////////////////////

		// Function: CheckCollisionRecs(rec1, rec2)
		// Description: Returns true if two rectangles overlap
		#extern CheckCollisionRecs :: bool(rec1 : Rect, rec2 : Rect);

		// Function: CheckCollisionCircles(center1, radius1, center2, radius2)
		// Description: Returns true if two circles overlap
		#extern CheckCollisionCircles :: bool(center1 : Vector2, radius1 : float, center2 : Vector2, radius2 : float);

		// Function: CheckCollisionCircleRec(center, radius, rec)
		// Description: Returns true if a circle and rectangle overlap
		#extern CheckCollisionCircleRec :: bool(center : Vector2, radius : float, rec : Rect);

		// Function: CheckCollisionPointRec(point, rec)
		// Description: Returns true if the point is inside the rectangle
		#extern CheckCollisionPointRec :: bool(point : Vector2, rec : Rect);

		// Function: CheckCollisionPointCircle(point, center, radius)
		// Description: Returns true if the point is inside the circle
		#extern CheckCollisionPointCircle :: bool(point : Vector2, center : Vector2, radius : float);

		// Function: CheckCollisionPointTriangle(point, p1, p2, p3)
		// Description: Returns true if the point is inside the triangle
		#extern CheckCollisionPointTriangle :: bool(point : Vector2, p1 : Vector2, p2 : Vector2, p3 : Vector2);

		// Function: GetCollisionRec(rec1, rec2)
		// Description: Returns the overlapping rectangle of two colliding rectangles
		#extern GetCollisionRec :: Rect(rec1 : Rect, rec2 : Rect);

		///////////////////////
		// Text              //
		///////////////////////

		// Function: DrawFPS(posX, posY)
		// Description: Draws the current FPS counter at the given position
		#extern DrawFPS :: (posX : int, posY : int);

		// Function: DrawText(text, posX, posY, fontSize, color)
		// Description: Draws text using the default font
		#extern DrawText :: (text : *char, posX : int, posY : int, fontSize : int, color : Color32);

		// Function: DrawTextEx(font, text, position, fontSize, spacing, tint)
		// Description: Draws text using a custom Font with extra parameters
		#extern DrawTextEx :: (font : Font, text : *char, position : Vector2, fontSize : float, spacing : float, tint : Color32);

		// Function: DrawTextPro(font, text, position, origin, rotation, fontSize, spacing, tint)
		// Description: Draws text with rotation around an origin point
		#extern DrawTextPro :: (font : Font, text : *char, position : Vector2, origin : Vector2, rotation : float, fontSize : float, spacing : float, tint : Color32);

		// Function: MeasureText(text, fontSize)
		// Description: Returns the width in pixels of the given text at the given font size
		#extern MeasureText :: int(text : *char, fontSize : int);

		// Function: MeasureTextEx(font, text, fontSize, spacing)
		// Description: Returns the size of the text rendered with a custom font
		#extern MeasureTextEx :: Vector2(font : Font, text : *char, fontSize : float, spacing : float);

		// Function: SetTextLineSpacing(spacing)
		// Description: Sets the vertical line spacing when drawing multi-line text
		#extern SetTextLineSpacing :: (spacing : int);

		// Function: GetGlyphIndex(font, codepoint)
		// Description: Returns the glyph index for a codepoint in the given font
		#extern GetGlyphIndex :: int(font : Font, codepoint : int);

		// Function: GetGlyphInfo(font, codepoint)
		// Description: Returns glyph data for a codepoint
		#extern GetGlyphInfo :: GlyphInfo(font : Font, codepoint : int);

		// Function: GetGlyphAtlasRec(font, codepoint)
		// Description: Returns the atlas rectangle for a glyph codepoint
		#extern GetGlyphAtlasRec :: Rect(font : Font, codepoint : int);

		///////////////////////
		// Input: Keyboard   //
		///////////////////////

		// Function: IsKeyPressed(key)
		// Description: Returns true if the key was pressed this frame (once)
		#extern IsKeyPressed :: bool(key : int);

		// Function: IsKeyPressedRepeat(key)
		// Description: Returns true if the key is pressed and the OS repeat fires
		#extern IsKeyPressedRepeat :: bool(key : int);

		// Function: IsKeyDown(key)
		// Description: Returns true while the key is held down
		#extern IsKeyDown :: bool(key : int);

		// Function: IsKeyReleased(key)
		// Description: Returns true if the key was released this frame
		#extern IsKeyReleased :: bool(key : int);

		// Function: IsKeyUp(key)
		// Description: Returns true while the key is not held
		#extern IsKeyUp :: bool(key : int);

		// Function: GetKeyPressed()
		// Description: Returns the keycode of the next key in the input queue, or 0
		#extern GetKeyPressed :: int();

		// Function: GetCharPressed()
		// Description: Returns the unicode codepoint of the next queued character, or 0
		#extern GetCharPressed :: int();

		// Function: SetExitKey(key)
		// Description: Sets the key that triggers WindowShouldClose (default: KEY_ESCAPE)
		#extern SetExitKey :: (key : int);

		///////////////////////
		// Input: Gamepad    //
		///////////////////////

		// Function: IsGamepadAvailable(gamepad)
		// Description: Returns true if the gamepad is connected and ready
		#extern IsGamepadAvailable :: bool(gamepad : int);

		// Function: GetGamepadName(gamepad)
		// Description: Returns the internal name of the gamepad
		#extern GetGamepadName :: *char(gamepad : int);

		// Function: IsGamepadButtonPressed(gamepad, button)
		// Description: Returns true if a gamepad button was pressed this frame
		#extern IsGamepadButtonPressed :: bool(gamepad : int, button : int);

		// Function: IsGamepadButtonDown(gamepad, button)
		// Description: Returns true while a gamepad button is held
		#extern IsGamepadButtonDown :: bool(gamepad : int, button : int);

		// Function: IsGamepadButtonReleased(gamepad, button)
		// Description: Returns true if a gamepad button was released this frame
		#extern IsGamepadButtonReleased :: bool(gamepad : int, button : int);

		// Function: IsGamepadButtonUp(gamepad, button)
		// Description: Returns true while a gamepad button is not held
		#extern IsGamepadButtonUp :: bool(gamepad : int, button : int);

		// Function: GetGamepadButtonPressed()
		// Description: Returns the last gamepad button pressed
		#extern GetGamepadButtonPressed :: int();

		// Function: GetGamepadAxisCount(gamepad)
		// Description: Returns the number of axes on the gamepad
		#extern GetGamepadAxisCount :: int(gamepad : int);

		// Function: GetGamepadAxisMovement(gamepad, axis)
		// Description: Returns the axis movement value [-1.0 .. 1.0]
		#extern GetGamepadAxisMovement :: float(gamepad : int, axis : int);

		///////////////////////
		// Input: Mouse      //
		///////////////////////

		// Function: IsMouseButtonPressed(button)
		// Description: Returns true if the mouse button was pressed this frame
		#extern IsMouseButtonPressed :: bool(button : int);

		// Function: IsMouseButtonDown(button)
		// Description: Returns true while the mouse button is held
		#extern IsMouseButtonDown :: bool(button : int);

		// Function: IsMouseButtonReleased(button)
		// Description: Returns true if the mouse button was released this frame
		#extern IsMouseButtonReleased :: bool(button : int);

		// Function: IsMouseButtonUp(button)
		// Description: Returns true while the mouse button is not held
		#extern IsMouseButtonUp :: bool(button : int);

		// Function: GetMouseX()
		// Description: Returns the current mouse X position in pixels
		#extern GetMouseX :: int();

		// Function: GetMouseY()
		// Description: Returns the current mouse Y position in pixels
		#extern GetMouseY :: int();

		// Function: GetMousePosition()
		// Description: Returns the current mouse position as a Vector2
		#extern GetMousePosition :: Vector2();

		// Function: GetMouseDelta()
		// Description: Returns the mouse movement delta since the last frame
		#extern GetMouseDelta :: Vector2();

		// Function: SetMousePosition(x, y)
		// Description: Sets the mouse cursor position
		#extern SetMousePosition :: (x : int, y : int);

		// Function: SetMouseOffset(offsetX, offsetY)
		// Description: Sets an offset applied to all mouse position queries
		#extern SetMouseOffset :: (offsetX : int, offsetY : int);

		// Function: SetMouseScale(scaleX, scaleY)
		// Description: Sets a scale factor applied to all mouse position queries
		#extern SetMouseScale :: (scaleX : float, scaleY : float);

		// Function: GetMouseWheelMove()
		// Description: Returns the mouse wheel scroll delta for this frame
		#extern GetMouseWheelMove :: float();

		// Function: GetMouseWheelMoveV()
		// Description: Returns the mouse wheel scroll delta as a Vector2 (X and Y)
		#extern GetMouseWheelMoveV :: Vector2();

		// Function: SetMouseCursor(cursor)
		// Description: Sets the mouse cursor shape
		#extern SetMouseCursor :: (cursor : int);

		///////////////////////
		// Input: Touch      //
		///////////////////////

		// Function: GetTouchX()
		// Description: Returns the X position of touch point 0
		#extern GetTouchX :: int();

		// Function: GetTouchY()
		// Description: Returns the Y position of touch point 0
		#extern GetTouchY :: int();

		// Function: GetTouchPosition(index)
		// Description: Returns the position of a touch point at the given index
		#extern GetTouchPosition :: Vector2(index : int);

		// Function: GetTouchPointId(index)
		// Description: Returns the identifier of a touch point
		#extern GetTouchPointId :: int(index : int);

		// Function: GetTouchPointCount()
		// Description: Returns the number of active touch points
		#extern GetTouchPointCount :: int();

		///////////////////////
		// Gestures          //
		///////////////////////

		// Function: SetGesturesEnabled(flags)
		// Description: Enables a set of gestures using bit flags
		#extern SetGesturesEnabled :: (flags : uint32);

		// Function: IsGestureDetected(gesture)
		// Description: Returns true if the given gesture was detected this frame
		#extern IsGestureDetected :: bool(gesture : uint32);

		// Function: GetGestureDetected()
		// Description: Returns the latest detected gesture type
		#extern GetGestureDetected :: int();

		// Function: GetGestureHoldDuration()
		// Description: Returns the duration of the current hold gesture in milliseconds
		#extern GetGestureHoldDuration :: float();

		// Function: GetGestureDragVector()
		// Description: Returns the drag gesture vector
		#extern GetGestureDragVector :: Vector2();

		// Function: GetGestureDragAngle()
		// Description: Returns the drag gesture angle in degrees
		#extern GetGestureDragAngle :: float();

		// Function: GetGesturePinchVector()
		// Description: Returns the pinch gesture delta vector
		#extern GetGesturePinchVector :: Vector2();

		// Function: GetGesturePinchAngle()
		// Description: Returns the pinch gesture rotation angle in degrees
		#extern GetGesturePinchAngle :: float();

		///////////////////////
		// Camera update     //
		///////////////////////

		// Function: UpdateCamera(camera, mode)
		// Description: Updates the 3D camera position for the selected mode
		#extern UpdateCamera :: (camera : *Camera3D, mode : int);

		// Function: UpdateCameraPro(camera, movement, rotation, zoom)
		// Description: Updates the 3D camera with explicit movement, rotation, and zoom
		#extern UpdateCameraPro :: (camera : *Camera3D, movement : Vector3, rotation : Vector3, zoom : float);

	}

