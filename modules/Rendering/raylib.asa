		SHADER_UNIFORM_IVEC3     : const uint16 = 6;
		SHADER_UNIFORM_IVEC4     : const uint16 = 7;
		SHADER_UNIFORM_SAMPLER2D : const uint16 = 8;

		// Material map indices
		MATERIAL_MAP_ALBEDO     : const uint16 = 0;
		MATERIAL_MAP_METALNESS  : const uint16 = 1;
		MATERIAL_MAP_NORMAL     : const uint16 = 2;
		MATERIAL_MAP_ROUGHNESS  : const uint16 = 3;
		MATERIAL_MAP_OCCLUSION  : const uint16 = 4;
		MATERIAL_MAP_EMISSION   : const uint16 = 5;
		MATERIAL_MAP_HEIGHT     : const uint16 = 6;
