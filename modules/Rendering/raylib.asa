		#extern DrawRectangleRec as DrawRectangleRect :: (rect : Rect, color : Color32);

		// Function: DrawRectanglePro(rec, origin, rotation, color)
		// Description: Draws a rectangle with rotation around an origin point
		#extern DrawRectanglePro :: (rec : Rect, origin : Vector2, rotation : float, color : Color32);

		// Function: DrawRectangleGradientV(posX, posY, width, height, color1, color2)
		// Description: Draws a vertical-gradient-filled rectangle
		#extern DrawRectangleGradientV :: (posX : int, posY : int, width : int, height : int, color1 : Color32, color2 : Color32);

		// Function: DrawRectangleGradientH(posX, posY, width, height, color1, color2)
		// Description: Draws a horizontal-gradient-filled rectangle
		#extern DrawRectangleGradientH :: (posX : int, posY : int, width : int, height : int, color1 : Color32, color2 : Color32);

		// Function: DrawRectangleGradientEx(rec, col1, col2, col3, col4)
		// Description: Draws a gradient-filled rectangle with custom per-vertex colors
		#extern DrawRectangleGradientEx :: (rec : Rect, col1 : Color32, col2 : Color32, col3 : Color32, col4 : Color32);

		// Function: DrawRectangleOutline(posX, posY, width, height, color)
		// Description: Draws the outline of a rectangle
		#extern DrawRectangleLines as DrawRectangleOutline :: (posX : int, posY : int, width : int, height : int, color : Color32);

