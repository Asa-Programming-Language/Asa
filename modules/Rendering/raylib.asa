		MATERIAL_MAP_IRRADIANCE : const uint16 = 8;
		MATERIAL_MAP_PREFILTER  : const uint16 = 9;
		MATERIAL_MAP_BRDF       : const uint16 = 10;
		// Legacy aliases
		MATERIAL_MAP_DIFFUSE    : const uint16 = 0;
		MATERIAL_MAP_SPECULAR   : const uint16 = 1;
	}

	///////////////////////
	// Font loading      //
	///////////////////////

	// Function: GetFontDefault()
	// Description: Returns the default built-in font
	@public:
	#extern GetFontDefault :: Font();

	// Function: LoadFont(fileName)
	// Description: Loads a font from file into GPU memory
	@public:
	#extern LoadFont :: Font(fileName : *char);

	// Function: LoadFontEx(fileName, fontSize, codepoints, codepointCount)
	// Description: Loads a font with extended parameters; pass null/0 for default charset
	@public:
	#extern LoadFontEx :: Font(fileName : *char, fontSize : int, codepoints : *int, codepointCount : int);

	// Function: LoadFontFromImage(image, key, firstChar)
	// Description: Loads a font from an Image (XNA-style sprite font)
	@public:
	#extern LoadFontFromImage :: Font(image : Image, key : Color32, firstChar : int);

	// Function: IsFontReady(font)
	// Description: Returns true if the font is loaded and ready to use
	@public:
	#extern IsFontReady :: bool(font : Font);

	// Function: UnloadFont(font)
	// Description: Unloads a font from GPU memory
	@public:
	#extern UnloadFont :: (font : Font);

	///////////////////////
	// Images            //
	///////////////////////

	// Function: LoadImage(fileName)
	// Description: Loads an image from file into CPU memory (RAM)
	@public:
	#extern LoadImage :: Image(fileName : *char);

	// Function: LoadImageRaw(fileName, width, height, format, headerSize)
	// Description: Loads an image from a raw file with explicit dimensions and format
	@public:
	#extern LoadImageRaw :: Image(fileName : *char, width : int, height : int, format : int, headerSize : int);

	// Function: LoadImageFromMemory(fileType, fileData, dataSize)
	// Description: Loads an image from a memory buffer; fileType is the extension e.g. ".png"
	@public:
	#extern LoadImageFromMemory :: Image(fileType : *char, fileData : *uint8, dataSize : int);

	// Function: LoadImageFromTexture(texture)
	// Description: Loads an image from GPU texture data (slow, copies VRAM to RAM)
	@public:
	#extern LoadImageFromTexture :: Image(texture : Texture2D);

	// Function: LoadImageFromScreen()
	// Description: Loads an image from the current screen buffer (screenshot)
	@public:
	#extern LoadImageFromScreen :: Image();

	// Function: IsImageReady(image)
	// Description: Returns true if the image is loaded and has valid pixel data
	@public:
	#extern IsImageReady :: bool(image : Image);

	// Function: UnloadImage(image)
	// Description: Unloads image data from CPU memory (RAM)
	@public:
	#extern UnloadImage :: (image : Image);

	// Function: ExportImage(image, fileName)
	// Description: Exports image data to file; returns true on success
	@public:
	#extern ExportImage :: bool(image : Image, fileName : *char);

	// Function: GetImageColor(image, x, y)
	// Description: Returns the pixel color at (x, y) in the image
	@public:
	#extern GetImageColor :: Color32(image : Image, x : int, y : int);

	// Function: GenImageColor(width, height, color)
	// Description: Generates an image filled with a solid color
	@public:
	#extern GenImageColor :: Image(width : int, height : int, color : Color32);

	// Function: GenImageGradientLinear(width, height, direction, start, end)
	// Description: Generates a linear-gradient image; direction is in degrees [0..360]
	@public:
	#extern GenImageGradientLinear :: Image(width : int, height : int, direction : int, start : Color32, end : Color32);

	// Function: GenImageGradientRadial(width, height, density, inner, outer)
	// Description: Generates a radial-gradient image
	@public:
	#extern GenImageGradientRadial :: Image(width : int, height : int, density : float, inner : Color32, outer : Color32);

	// Function: GenImageChecked(width, height, checksX, checksY, col1, col2)
	// Description: Generates a checkerboard image
	@public:
	#extern GenImageChecked :: Image(width : int, height : int, checksX : int, checksY : int, col1 : Color32, col2 : Color32);

	// Function: GenImageWhiteNoise(width, height, factor)
	// Description: Generates a white-noise image
	@public:
	#extern GenImageWhiteNoise :: Image(width : int, height : int, factor : float);

	// Function: GenImagePerlinNoise(width, height, offsetX, offsetY, scale)
	// Description: Generates a Perlin noise image
	@public:
	#extern GenImagePerlinNoise :: Image(width : int, height : int, offsetX : int, offsetY : int, scale : float);

	// Function: GenImageCellular(width, height, tileSize)
	// Description: Generates a cellular automaton noise image
	@public:
	#extern GenImageCellular :: Image(width : int, height : int, tileSize : int);

	// Function: ImageCopy(image)
	// Description: Creates a copy of an image
	@public:
	#extern ImageCopy :: Image(image : Image);

	// Function: ImageFromImage(image, rec)
	// Description: Creates a sub-image from a rectangular region of another image
	@public:
	#extern ImageFromImage :: Image(image : Image, rec : Rect);

	// Function: ImageFormat(image, newFormat)
	// Description: Converts the image pixel data to a new format in-place
	@public:
	#extern ImageFormat :: (image : *Image, newFormat : int);

	// Function: ImageToPOT(image, fill)
	// Description: Pads the image to power-of-two dimensions, filling new pixels with fill
	@public:
	#extern ImageToPOT :: (image : *Image, fill : Color32);

	// Function: ImageCrop(image, crop)
	// Description: Crops the image to the given rectangle in-place
	@public:
	#extern ImageCrop :: (image : *Image, crop : Rect);

	// Function: ImageAlphaCrop(image, threshold)
	// Description: Crops the image removing alpha-transparent borders
	@public:
	#extern ImageAlphaCrop :: (image : *Image, threshold : float);

	// Function: ImageAlphaClear(image, color, threshold)
	// Description: Clears pixels with alpha below threshold to the given color
	@public:
	#extern ImageAlphaClear :: (image : *Image, color : Color32, threshold : float);

	// Function: ImageAlphaMask(image, alphaMask)
	// Description: Applies an alpha mask image to the image
	@public:
	#extern ImageAlphaMask :: (image : *Image, alphaMask : Image);

	// Function: ImageAlphaPremultiply(image)
	// Description: Pre-multiplies the alpha channel into RGB
	@public:
	#extern ImageAlphaPremultiply :: (image : *Image);

	// Function: ImageBlurGaussian(image, blurSize)
	// Description: Applies a Gaussian blur approximation
	@public:
	#extern ImageBlurGaussian :: (image : *Image, blurSize : int);

	// Function: ImageResize(image, newWidth, newHeight)
	// Description: Resizes an image in-place using bicubic scaling
	@public:
	#extern ImageResize :: (image : *Image, newWidth : int, newHeight : int);

	// Function: ImageResizeNN(image, newWidth, newHeight)
	// Description: Resizes an image in-place using nearest-neighbour scaling
	@public:
	#extern ImageResizeNN :: (image : *Image, newWidth : int, newHeight : int);

	// Function: ImageResizeCanvas(image, newWidth, newHeight, offsetX, offsetY, fill)
	// Description: Resizes the canvas, filling new space with fill color
	@public:
	#extern ImageResizeCanvas :: (image : *Image, newWidth : int, newHeight : int, offsetX : int, offsetY : int, fill : Color32);

	// Function: ImageMipmaps(image)
	// Description: Computes all mipmap levels for the image
	@public:
	#extern ImageMipmaps :: (image : *Image);

	// Function: ImageDither(image, rBpp, gBpp, bBpp, aBpp)
	// Description: Dithers the image to a lower bit depth using Floyd-Steinberg
	@public:
	#extern ImageDither :: (image : *Image, rBpp : int, gBpp : int, bBpp : int, aBpp : int);

	// Function: ImageFlipVertical(image)
	// Description: Flips the image vertically in-place
	@public:
	#extern ImageFlipVertical :: (image : *Image);

	// Function: ImageFlipHorizontal(image)
	// Description: Flips the image horizontally in-place
	@public:
	#extern ImageFlipHorizontal :: (image : *Image);

	// Function: ImageRotate(image, degrees)
	// Description: Rotates the image by the given angle in degrees
	@public:
	#extern ImageRotate :: (image : *Image, degrees : int);

	// Function: ImageRotateCW(image)
	// Description: Rotates the image 90 degrees clockwise
	@public:
	#extern ImageRotateCW :: (image : *Image);

	// Function: ImageRotateCCW(image)
	// Description: Rotates the image 90 degrees counter-clockwise
	@public:
	#extern ImageRotateCCW :: (image : *Image);

	// Function: ImageColorTint(image, color)
	// Description: Tints all pixels of the image by multiplying with color
	@public:
	#extern ImageColorTint :: (image : *Image, color : Color32);

	// Function: ImageColorInvert(image)
	// Description: Inverts all colors in the image
	@public:
	#extern ImageColorInvert :: (image : *Image);

	// Function: ImageColorGrayscale(image)
	// Description: Converts the image to grayscale
	@public:
	#extern ImageColorGrayscale :: (image : *Image);

	// Function: ImageColorContrast(image, contrast)
	// Description: Adjusts image contrast (-100 to 100)
	@public:
	#extern ImageColorContrast :: (image : *Image, contrast : float);

	// Function: ImageColorBrightness(image, brightness)
	// Description: Adjusts image brightness (-255 to 255)
	@public:
	#extern ImageColorBrightness :: (image : *Image, brightness : int);

	// Function: ImageColorReplace(image, color, replace)
	// Description: Replaces all pixels of one color with another
	@public:
	#extern ImageColorReplace :: (image : *Image, color : Color32, replace : Color32);

	// Function: ImageClearBackground(dst, color)
	// Description: Clears the entire image with the given color
	@public:
	#extern ImageClearBackground :: (dst : *Image, color : Color32);

	// Function: ImageDrawPixel(dst, posX, posY, color)
	// Description: Draws a pixel onto an image (CPU-side)
	@public:
	#extern ImageDrawPixel :: (image : *Image, posX : int, posY : int, color : Color32);

	// Function: ImageDrawLine(dst, startPosX, startPosY, endPosX, endPosY, color)
	// Description: Draws a line onto an image (CPU-side)
	@public:
	#extern ImageDrawLine :: (dst : *Image, startPosX : int, startPosY : int, endPosX : int, endPosY : int, color : Color32);

	// Function: ImageDrawCircle(dst, centerX, centerY, radius, color)
	// Description: Draws a filled circle onto an image (CPU-side)
	@public:
	#extern ImageDrawCircle :: (dst : *Image, centerX : int, centerY : int, radius : int, color : Color32);

	// Function: ImageDrawCircleLines(dst, centerX, centerY, radius, color)
	// Description: Draws a circle outline onto an image (CPU-side)
	@public:
	#extern ImageDrawCircleLines :: (dst : *Image, centerX : int, centerY : int, radius : int, color : Color32);

	// Function: ImageDrawRectangle(dst, posX, posY, width, height, color)
	// Description: Draws a filled rectangle onto an image (CPU-side)
	@public:
	#extern ImageDrawRectangle :: (dst : *Image, posX : int, posY : int, width : int, height : int, color : Color32);

	// Function: ImageDrawRectangleRec(dst, rec, color)
	// Description: Draws a filled rectangle (Rect) onto an image
	@public:
	#extern ImageDrawRectangleRec :: (dst : *Image, rec : Rect, color : Color32);

	// Function: ImageDrawRectangleLines(dst, rec, thick, color)
	// Description: Draws a rectangle outline onto an image
	@public:
	#extern ImageDrawRectangleLines :: (dst : *Image, rec : Rect, thick : int, color : Color32);

	// Function: ImageDraw(dst, src, srcRec, dstRec, tint)
	// Description: Draws a source image region onto a destination image with tint
	@public:
	#extern ImageDraw :: (dst : *Image, src : Image, srcRec : Rect, dstRec : Rect, tint : Color32);

	// Function: ImageDrawText(dst, text, posX, posY, fontSize, color)
	// Description: Draws text onto an image using the default font (CPU-side)
	@public:
	#extern ImageDrawText :: (dst : *Image, text : *char, posX : int, posY : int, fontSize : int, color : Color32);

	///////////////////////
	// Textures          //
	///////////////////////

	// Function: LoadRenderTexture(width, height)
	// Description: Loads a render texture (framebuffer) of the given size
	@public:
	#extern LoadRenderTexture :: RenderTexture2D(width : int, height : int);

	// Function: UnloadRenderTexture(target)
	// Description: Unloads a render texture from GPU memory
	@public:
	#extern UnloadRenderTexture :: (target : RenderTexture2D);

	// Function: LoadTexture(fileName)
	// Description: Loads a texture from file into GPU memory (VRAM)
	@public:
	#extern LoadTexture :: Texture2D(fileName : *char);

	// Function: LoadTextureFromImage(image)
	// Description: Loads a texture from an Image struct
	@public:
	#extern LoadTextureFromImage :: Texture2D(image : Image);

	// Function: IsTextureReady(texture)
	// Description: Returns true if the texture is loaded and valid
	@public:
	#extern IsTextureReady :: bool(texture : Texture2D);

	// Function: UnloadTexture(texture)
	// Description: Unloads texture from GPU memory (VRAM)
	@public:
	#extern UnloadTexture :: (texture : Texture2D);

	// Function: IsRenderTextureReady(target)
	// Description: Returns true if the render texture is valid
	@public:
	#extern IsRenderTextureReady :: bool(target : RenderTexture2D);

	// Function: UpdateTexture(texture, pixels)
	// Description: Updates the GPU texture with new pixel data
	@public:
	#extern UpdateTexture :: (texture : Texture2D, pixels : *uint8);

	// Function: UpdateTextureRec(texture, rec, pixels)
	// Description: Updates a rectangular region of the GPU texture with new pixel data
	@public:
	#extern UpdateTextureRec :: (texture : Texture2D, rec : Rect, pixels : *uint8);

	// Function: GenTextureMipmaps(texture)
	// Description: Generates GPU mipmaps for a texture
	@public:
	#extern GenTextureMipmaps :: (texture : *Texture2D);

	// Function: SetTextureFilter(texture, filter)
	// Description: Sets the texture scaling filter mode
	@public:
	#extern SetTextureFilter :: (texture : Texture2D, filter : int);

	// Function: SetTextureWrap(texture, wrap)
	// Description: Sets the texture wrapping mode
	@public:
	#extern SetTextureWrap :: (texture : Texture2D, wrap : int);

	// Function: DrawTexture(texture, posX, posY, tint)
	// Description: Draws a Texture2D at the given position
	@public:
	#extern DrawTexture :: (texture : Texture2D, posX : int, posY : int, tint : Color32);

	// Function: DrawTextureV(texture, position, tint)
	// Description: Draws a Texture2D at a Vector2 position
	@public:
	#extern DrawTextureV :: (texture : Texture2D, position : Vector2, tint : Color32);

	// Function: DrawTextureEx(texture, position, rotation, scale, tint)
	// Description: Draws a Texture2D with extended transform parameters
	@public:
	#extern DrawTextureEx :: (texture : Texture2D, position : Vector2, rotation : float, scale : float, tint : Color32);

	// Function: DrawTextureRec(texture, source, position, tint)
	// Description: Draws a sub-rectangle of a texture
	@public:
	#extern DrawTextureRec :: (texture : Texture2D, source : Rect, position : Vector2, tint : Color32);

	// Function: DrawTexturePro(texture, source, dest, origin, rotation, tint)
	// Description: Draws a texture with full source/dest rectangle and rotation control
	@public:
	#extern DrawTexturePro :: (texture : Texture2D, source : Rect, dest : Rect, origin : Vector2, rotation : float, tint : Color32);

	// Function: DrawTextureNPatch(texture, nPatchInfo, dest, origin, rotation, tint)
	// Description: Draws a texture (or part of it) that stretches or shrinks using n-patch info
	@public:
	#extern DrawTextureNPatch :: (texture : Texture2D, nPatchInfo : NPatchInfo, dest : Rect, origin : Vector2, rotation : float, tint : Color32);

	///////////////////////
	// Color utilities   //
	///////////////////////

	// Function: Fade(color, alpha)
	// Description: Returns the color with the given alpha (0.0 to 1.0)
	@public:
	#extern Fade :: Color32(color : Color32, alpha : float);

	// Function: ColorToInt(color)
	// Description: Returns the hexadecimal integer value for a Color32
	@public:
	#extern ColorToInt :: int(color : Color32);

	// Function: ColorNormalize(color)
	// Description: Returns the color components normalized to [0.0 .. 1.0] as a Vector4
	@public:
	#extern ColorNormalize :: Vector4(color : Color32);

	// Function: ColorFromNormalized(normalized)
	// Description: Returns a Color32 from normalized [0.0 .. 1.0] Vector4 components
	@public:
	#extern ColorFromNormalized :: Color32(normalized : Vector4);

	// Function: ColorToHSV(color)
	// Description: Returns HSV values (hue 0..360, saturation/value 0..1) as a Vector3
	@public:
	#extern ColorToHSV :: Vector3(color : Color32);

	// Function: ColorFromHSV(hue, saturation, value)
	// Description: Returns a Color32 from HSV values
	@public:
	#extern ColorFromHSV :: Color32(hue : float, saturation : float, value : float);

	// Function: ColorTint(color, tint)
	// Description: Returns a color multiplied with another (tint)
	@public:
	#extern ColorTint :: Color32(color : Color32, tint : Color32);

	// Function: ColorBrightness(color, factor)
	// Description: Adjusts color brightness by factor (-1.0 to 1.0)
	@public:
	#extern ColorBrightness :: Color32(color : Color32, factor : float);

	// Function: ColorContrast(color, contrast)
	// Description: Adjusts color contrast by factor (-1.0 to 1.0)
	@public:
	#extern ColorContrast :: Color32(color : Color32, contrast : float);

	// Function: ColorAlpha(color, alpha)
	// Description: Returns the color with the alpha channel set to the given value (0.0 to 1.0)
	@public:
	#extern ColorAlpha :: Color32(color : Color32, alpha : float);

	// Function: ColorAlphaBlend(dst, src, tint)
	// Description: Blends src alpha into dst color with tint
	@public:
	#extern ColorAlphaBlend :: Color32(dst : Color32, src : Color32, tint : Color32);

	// Function: GetColor(hexValue)
	// Description: Returns a Color32 from a hexadecimal RGBA value (e.g. 0xFF00FFFF)
	@public:
	#extern GetColor :: Color32(hexValue : uint32);

	// Function: GetPixelDataSize(width, height, format)
	// Description: Returns the byte size of pixel data for the given dimensions and format
	@public:
	#extern GetPixelDataSize :: int(width : int, height : int, format : int);

	///////////////////////
	// 3D Drawing        //
	///////////////////////

	@public:
	{
		// Function: DrawLine3D(startPos, endPos, color)
		// Description: Draws a line in 3D world space
		#extern DrawLine3D :: (startPos : Vector3, endPos : Vector3, color : Color32);

		// Function: DrawPoint3D(position, color)
		// Description: Draws a point (small line) in 3D space
		#extern DrawPoint3D :: (position : Vector3, color : Color32);

		// Function: DrawCircle3D(center, radius, rotationAxis, rotationAngle, color)
		// Description: Draws a circle in 3D world space
		#extern DrawCircle3D :: (center : Vector3, radius : float, rotationAxis : Vector3, rotationAngle : float, color : Color32);

		// Function: DrawTriangle3D(v1, v2, v3, color)
		// Description: Draws a filled triangle in 3D (vertices in counter-clockwise order)
		#extern DrawTriangle3D :: (v1 : Vector3, v2 : Vector3, v3 : Vector3, color : Color32);

		// Function: DrawCube(position, width, height, length, color)
		// Description: Draws a solid cube
		#extern DrawCube :: (position : Vector3, width : float, height : float, length : float, color : Color32);

		// Function: DrawCubeV(position, size, color)
		// Description: Draws a solid cube with Vector3 size
		#extern DrawCubeV :: (position : Vector3, size : Vector3, color : Color32);

		// Function: DrawCubeWires(position, width, height, length, color)
		// Description: Draws a wireframe cube
		#extern DrawCubeWires :: (position : Vector3, width : float, height : float, length : float, color : Color32);

		// Function: DrawCubeWiresV(position, size, color)
		// Description: Draws a wireframe cube with Vector3 size
		#extern DrawCubeWiresV :: (position : Vector3, size : Vector3, color : Color32);

		// Function: DrawSphere(centerPos, radius, color)
		// Description: Draws a solid sphere
		#extern DrawSphere :: (centerPos : Vector3, radius : float, color : Color32);

		// Function: DrawSphereEx(centerPos, radius, rings, slices, color)
		// Description: Draws a solid sphere with subdivision control
		#extern DrawSphereEx :: (centerPos : Vector3, radius : float, rings : int, slices : int, color : Color32);

		// Function: DrawSphereWires(centerPos, radius, rings, slices, color)
		// Description: Draws a wireframe sphere
		#extern DrawSphereWires :: (centerPos : Vector3, radius : float, rings : int, slices : int, color : Color32);

		// Function: DrawCylinder(position, radiusTop, radiusBottom, height, slices, color)
		// Description: Draws a solid cylinder (or cone if one radius is 0)
		#extern DrawCylinder :: (position : Vector3, radiusTop : float, radiusBottom : float, height : float, slices : int, color : Color32);

		// Function: DrawCylinderEx(startPos, endPos, startRadius, endRadius, sides, color)
		// Description: Draws a cylinder with endpoints and radius control
		#extern DrawCylinderEx :: (startPos : Vector3, endPos : Vector3, startRadius : float, endRadius : float, sides : int, color : Color32);

		// Function: DrawCylinderWires(position, radiusTop, radiusBottom, height, slices, color)
		// Description: Draws a wireframe cylinder
		#extern DrawCylinderWires :: (position : Vector3, radiusTop : float, radiusBottom : float, height : float, slices : int, color : Color32);

		// Function: DrawCylinderWiresEx(startPos, endPos, startRadius, endRadius, sides, color)
		// Description: Draws a wireframe cylinder with endpoint control
		#extern DrawCylinderWiresEx :: (startPos : Vector3, endPos : Vector3, startRadius : float, endRadius : float, sides : int, color : Color32);

		// Function: DrawCapsule(startPos, endPos, radius, slices, rings, color)
		// Description: Draws a solid capsule (cylinder with hemispherical caps)
		#extern DrawCapsule :: (startPos : Vector3, endPos : Vector3, radius : float, slices : int, rings : int, color : Color32);

		// Function: DrawCapsuleWires(startPos, endPos, radius, slices, rings, color)
		// Description: Draws a wireframe capsule
		#extern DrawCapsuleWires :: (startPos : Vector3, endPos : Vector3, radius : float, slices : int, rings : int, color : Color32);

		// Function: DrawPlane(centerPos, size, color)
		// Description: Draws a flat XZ plane
		#extern DrawPlane :: (centerPos : Vector3, size : Vector2, color : Color32);

		// Function: DrawRay(ray, color)
		// Description: Draws a ray as a line
		#extern DrawRay :: (ray : Ray, color : Color32);

		// Function: DrawGrid(slices, spacing)
		// Description: Draws a grid centered at (0,0,0)
		#extern DrawGrid :: (slices : int, spacing : float);

		// Function: DrawBoundingBox(box, color)
		// Description: Draw bounding box as wireframe lines
		#extern DrawBoundingBox :: (box : BoundingBox, color : Color32);

		///////////////////////
		// 3D Collision      //
		///////////////////////

		// Function: CheckCollisionSpheres(center1, radius1, center2, radius2)
		// Description: Returns true if two spheres overlap
		#extern CheckCollisionSpheres :: bool(center1 : Vector3, radius1 : float, center2 : Vector3, radius2 : float);

		// Function: CheckCollisionBoxes(box1, box2)
		// Description: Returns true if two bounding boxes overlap
		#extern CheckCollisionBoxes :: bool(box1 : BoundingBox, box2 : BoundingBox);

		// Function: CheckCollisionBoxSphere(box, center, radius)
		// Description: Returns true if a bounding box and sphere overlap
		#extern CheckCollisionBoxSphere :: bool(box : BoundingBox, center : Vector3, radius : float);

		// Function: GetRayCollisionSphere(ray, center, radius)
		// Description: Returns ray-sphere hit info
		#extern GetRayCollisionSphere :: RayCollision(ray : Ray, center : Vector3, radius : float);

		// Function: GetRayCollisionBox(ray, box)
		// Description: Returns ray-box hit info
		#extern GetRayCollisionBox :: RayCollision(ray : Ray, box : BoundingBox);

		// Function: GetRayCollisionTriangle(ray, p1, p2, p3)
		// Description: Returns ray-triangle hit info
		#extern GetRayCollisionTriangle :: RayCollision(ray : Ray, p1 : Vector3, p2 : Vector3, p3 : Vector3);

		// Function: GetRayCollisionQuad(ray, p1, p2, p3, p4)
		// Description: Returns ray-quad hit info
		#extern GetRayCollisionQuad :: RayCollision(ray : Ray, p1 : Vector3, p2 : Vector3, p3 : Vector3, p4 : Vector3);

		// Function: GetRayCollisionMesh(ray, mesh, transform)
		// Description: Returns ray-mesh hit info
		#extern GetRayCollisionMesh :: RayCollision(ray : Ray, mesh : Mesh, transform : Matrix);
	}

	///////////////////////
	// Models            //
	///////////////////////

	@public:
	{
		///////////////////////
		// Model management  //
		///////////////////////

		// Function: LoadModel(fileName)
		// Description: Load a model from a file (OBJ, GLTF, GLB, VOX, IQM, M3D)
		#extern LoadModel :: Model(fileName : *char);

		// Function: LoadModelFromMesh(mesh)
		// Description: Load model from a generated mesh (uses default material)
		#extern LoadModelFromMesh :: Model(mesh : Mesh);

		// Function: IsModelReady(model)
		// Description: Check if a model is ready (loaded into GPU)
		#extern IsModelReady :: bool(model : Model);

		// Function: UnloadModel(model)
		// Description: Unload model (including meshes) from memory
		#extern UnloadModel :: (model : Model);

		// Function: GetModelBoundingBox(model)
		// Description: Compute model bounding box (considers all meshes)
		#extern GetModelBoundingBox :: BoundingBox(model : Model);

		///////////////////////
		// Model drawing     //
		///////////////////////

		// Function: DrawModel(model, position, scale, tint)
		// Description: Draw a model with texture if set
		#extern DrawModel :: (model : Model, position : Vector3, scale : float, tint : Color32);

		// Function: DrawModelEx(model, position, rotationAxis, rotationAngle, scale, tint)
		// Description: Draw a model with extended parameters
		#extern DrawModelEx :: (model : Model, position : Vector3, rotationAxis : Vector3, rotationAngle : float, scale : Vector3, tint : Color32);

		// Function: DrawModelWires(model, position, scale, tint)
		// Description: Draw a model as wireframe
		#extern DrawModelWires :: (model : Model, position : Vector3, scale : float, tint : Color32);

		// Function: DrawModelWiresEx(model, position, rotationAxis, rotationAngle, scale, tint)
		// Description: Draw a model as wireframe with extended parameters
		#extern DrawModelWiresEx :: (model : Model, position : Vector3, rotationAxis : Vector3, rotationAngle : float, scale : Vector3, tint : Color32);

		///////////////////////
		// Mesh management   //
		///////////////////////

		// Function: UploadMesh(mesh, dynamic)
		// Description: Upload mesh vertex data to GPU
		#extern UploadMesh :: (mesh : *Mesh, dynamic : bool);

		// Function: UnloadMesh(mesh)
		// Description: Unload mesh data from CPU and GPU
		#extern UnloadMesh :: (mesh : Mesh);

		// Function: DrawMesh(mesh, material, transform)
		// Description: Draw a 3D mesh with a material and transform
		#extern DrawMesh :: (mesh : Mesh, material : Material, transform : Matrix);

		// Function: ExportMesh(mesh, fileName)
		// Description: Export mesh data to file; returns true on success
		#extern ExportMesh :: bool(mesh : Mesh, fileName : *char);

		// Function: GetMeshBoundingBox(mesh)
		// Description: Compute mesh bounding box limits
		#extern GetMeshBoundingBox :: BoundingBox(mesh : Mesh);

		// Function: GenMeshTangents(mesh)
		// Description: Compute and set mesh tangents
		#extern GenMeshTangents :: (mesh : *Mesh);

		///////////////////////
		// Mesh generation   //
		///////////////////////

		// Function: GenMeshPoly(sides, radius)
		// Description: Generate a regular polygon mesh
		#extern GenMeshPoly :: Mesh(sides : int, radius : float);

		// Function: GenMeshPlane(width, length, resX, resZ)
		// Description: Generate a plane mesh with subdivisions
		#extern GenMeshPlane :: Mesh(width : float, length : float, resX : int, resZ : int);

		// Function: GenMeshCube(width, height, length)
		// Description: Generate a cuboid mesh
		#extern GenMeshCube :: Mesh(width : float, height : float, length : float);

		// Function: GenMeshSphere(radius, rings, slices)
		// Description: Generate a sphere mesh
		#extern GenMeshSphere :: Mesh(radius : float, rings : int, slices : int);

		// Function: GenMeshHemiSphere(radius, rings, slices)
		// Description: Generate a hemisphere mesh (no bottom cap)
		#extern GenMeshHemiSphere :: Mesh(radius : float, rings : int, slices : int);

		// Function: GenMeshCylinder(radius, height, slices)
		// Description: Generate a cylinder mesh
		#extern GenMeshCylinder :: Mesh(radius : float, height : float, slices : int);

		// Function: GenMeshCone(radius, height, slices)
		// Description: Generate a cone/pyramid mesh
		#extern GenMeshCone :: Mesh(radius : float, height : float, slices : int);

		// Function: GenMeshTorus(radius, size, radSeg, sides)
		// Description: Generate a torus mesh
		#extern GenMeshTorus :: Mesh(radius : float, size : float, radSeg : int, sides : int);

		// Function: GenMeshKnot(radius, size, radSeg, sides)
		// Description: Generate a trefoil knot mesh
		#extern GenMeshKnot :: Mesh(radius : float, size : float, radSeg : int, sides : int);

		// Function: GenMeshHeightmap(heightmap, size)
		// Description: Generate a heightmap mesh from image data
		#extern GenMeshHeightmap :: Mesh(heightmap : Image, size : Vector3);

		// Function: GenMeshCubicmap(cubicmap, cubeSize)
		// Description: Generate a cubes-based map mesh from image data
		#extern GenMeshCubicmap :: Mesh(cubicmap : Image, cubeSize : Vector3);

		///////////////////////
		// Materials         //
		///////////////////////

		// Function: LoadMaterialDefault()
		// Description: Load the default material (supports DIFFUSE, SPECULAR, NORMAL maps)
		#extern LoadMaterialDefault :: Material();

		// Function: IsMaterialReady(material)
		// Description: Check if a material is ready (shader assigned)
		#extern IsMaterialReady :: bool(material : Material);

		// Function: UnloadMaterial(material)
		// Description: Unload material from GPU memory
		#extern UnloadMaterial :: (material : Material);

		// Function: SetMaterialTexture(material, mapType, texture)
		// Description: Set a texture for a material map type
		#extern SetMaterialTexture :: (material : *Material, mapType : int, texture : Texture2D);

		// Function: SetModelMeshMaterial(model, meshId, materialId)
		// Description: Set material for a specific mesh in the model
		#extern SetModelMeshMaterial :: (model : *Model, meshId : int, materialId : int);

		///////////////////////
		// Model animation   //
		///////////////////////

		// Function: LoadModelAnimations(fileName, animCount)
		// Description: Load model animations from file; returns pointer to array, sets animCount
		#extern LoadModelAnimations :: *ModelAnimation(fileName : *char, animCount : *int);

		// Function: UpdateModelAnimation(model, anim, frame)
		// Description: Update model animation pose for the given frame
		#extern UpdateModelAnimation :: (model : Model, anim : ModelAnimation, frame : int);

		// Function: UnloadModelAnimation(anim)
		// Description: Unload a single animation
		#extern UnloadModelAnimation :: (anim : ModelAnimation);

		// Function: UnloadModelAnimations(animations, animCount)
		// Description: Unload an array of animations
		#extern UnloadModelAnimations :: (animations : *ModelAnimation, animCount : int);

		// Function: IsModelAnimationValid(model, anim)
		// Description: Check if animation skeleton matches the model
		#extern IsModelAnimationValid :: bool(model : Model, anim : ModelAnimation);
	}

	///////////////////////
	// Audio             //
	///////////////////////

	@public:
	{
		// Function: InitAudioDevice()
		// Description: Initializes the audio device and context
		#extern InitAudioDevice :: ();

		// Function: CloseAudioDevice()
		// Description: Closes the audio device and context
		#extern CloseAudioDevice :: ();

		// Function: IsAudioDeviceReady()
		// Description: Returns true if the audio device is initialized
		#extern IsAudioDeviceReady :: bool();

		// Function: SetMasterVolume(volume)
		// Description: Sets the master volume (0.0 to 1.0)
		#extern SetMasterVolume :: (volume : float);

		// Function: GetMasterVolume()
		// Description: Returns the current master volume
		#extern GetMasterVolume :: float();

		// Function: LoadWave(fileName)
		// Description: Loads wave data from file into CPU memory
		#extern LoadWave :: Wave(fileName : *char);

		// Function: IsWaveReady(wave)
		// Description: Returns true if the wave is loaded and ready
		#extern IsWaveReady :: bool(wave : Wave);

		// Function: LoadSound(fileName)
		// Description: Loads a sound from file into audio buffer (RAM)
		#extern LoadSound :: Sound(fileName : *char);

		// Function: LoadSoundFromWave(wave)
		// Description: Loads a sound from wave data
		#extern LoadSoundFromWave :: Sound(wave : Wave);

		// Function: IsSoundReady(sound)
		// Description: Returns true if the sound is ready to play
		#extern IsSoundReady :: bool(sound : Sound);

		// Function: UnloadWave(wave)
		// Description: Unloads wave data from CPU memory
		#extern UnloadWave :: (wave : Wave);

		// Function: UnloadSound(sound)
		// Description: Unloads a sound from memory
		#extern UnloadSound :: (sound : Sound);

		// Function: ExportWave(wave, fileName)
		// Description: Exports wave data to a file; returns true on success
		#extern ExportWave :: bool(wave : Wave, fileName : *char);

		// Function: PlaySound(sound)
		// Description: Plays a sound
		#extern PlaySound :: (sound : Sound);

		// Function: StopSound(sound)
		// Description: Stops playing a sound
		#extern StopSound :: (sound : Sound);

		// Function: PauseSound(sound)
		// Description: Pauses a sound
		#extern PauseSound :: (sound : Sound);

		// Function: ResumeSound(sound)
		// Description: Resumes a paused sound
		#extern ResumeSound :: (sound : Sound);

		// Function: IsSoundPlaying(sound)
		// Description: Returns true if the sound is currently playing
		#extern IsSoundPlaying :: bool(sound : Sound);

		// Function: SetSoundVolume(sound, volume)
		// Description: Sets the volume for a sound (1.0 is max)
		#extern SetSoundVolume :: (sound : Sound, volume : float);

		// Function: SetSoundPitch(sound, pitch)
		// Description: Sets the pitch for a sound (1.0 is base)
		#extern SetSoundPitch :: (sound : Sound, pitch : float);

		// Function: SetSoundPan(sound, pan)
		// Description: Sets the pan for a sound (0.5 is center)
		#extern SetSoundPan :: (sound : Sound, pan : float);

		// Function: WaveCopy(wave)
		// Description: Copies a wave to a new wave
		#extern WaveCopy :: Wave(wave : Wave);

		// Function: WaveCrop(wave, initSample, finalSample)
		// Description: Crops a wave to the specified sample range
		#extern WaveCrop :: (wave : *Wave, initSample : int, finalSample : int);

		// Function: WaveFormat(wave, sampleRate, sampleSize, channels)
		// Description: Converts wave data to the desired sample rate, bit depth, and channels
		#extern WaveFormat :: (wave : *Wave, sampleRate : int, sampleSize : int, channels : int);

		// Function: LoadWaveSamples(wave)
		// Description: Loads wave sample data as a 32-bit float array
		#extern LoadWaveSamples :: *float(wave : Wave);

		// Function: UnloadWaveSamples(samples)
		// Description: Unloads sample data loaded by LoadWaveSamples
		#extern UnloadWaveSamples :: (samples : *float);

		// Function: LoadMusicStream(fileName)
		// Description: Loads a music stream from file
		#extern LoadMusicStream :: Music(fileName : *char);

		// Function: IsMusicReady(music)
		// Description: Returns true if the music stream is ready to play
		#extern IsMusicReady :: bool(music : Music);

		// Function: UnloadMusicStream(music)
		// Description: Unloads a music stream
		#extern UnloadMusicStream :: (music : Music);

		// Function: PlayMusicStream(music)
		// Description: Starts playing a music stream
		#extern PlayMusicStream :: (music : Music);

		// Function: IsMusicStreamPlaying(music)
		// Description: Returns true if the music stream is playing
		#extern IsMusicStreamPlaying :: bool(music : Music);

		// Function: UpdateMusicStream(music)
		// Description: Refills streaming music buffers; call each frame
		#extern UpdateMusicStream :: (music : Music);

		// Function: StopMusicStream(music)
		// Description: Stops music playback
		#extern StopMusicStream :: (music : Music);

		// Function: PauseMusicStream(music)
		// Description: Pauses music playback
		#extern PauseMusicStream :: (music : Music);

		// Function: ResumeMusicStream(music)
		// Description: Resumes paused music playback
		#extern ResumeMusicStream :: (music : Music);

		// Function: SeekMusicStream(music, position)
		// Description: Seeks the music stream to the given position in seconds
		#extern SeekMusicStream :: (music : Music, position : float);

		// Function: SetMusicVolume(music, volume)
		// Description: Sets the volume for a music stream (1.0 is max)
		#extern SetMusicVolume :: (music : Music, volume : float);

		// Function: SetMusicPitch(music, pitch)
		// Description: Sets the pitch for a music stream (1.0 is base)
		#extern SetMusicPitch :: (music : Music, pitch : float);

		// Function: SetMusicPan(music, pan)
		// Description: Sets the pan for a music stream (0.5 is center)
		#extern SetMusicPan :: (music : Music, pan : float);

		// Function: GetMusicTimeLength(music)
		// Description: Returns the total duration of the music in seconds
		#extern GetMusicTimeLength :: float(music : Music);

		// Function: GetMusicTimePlayed(music)
		// Description: Returns the current playback position in seconds
		#extern GetMusicTimePlayed :: float(music : Music);

		// Function: LoadAudioStream(sampleRate, sampleSize, channels)
		// Description: Loads an audio stream for raw PCM streaming
		#extern LoadAudioStream :: AudioStream(sampleRate : uint32, sampleSize : uint32, channels : uint32);

		// Function: IsAudioStreamReady(stream)
		// Description: Returns true if the audio stream is ready
		#extern IsAudioStreamReady :: bool(stream : AudioStream);

		// Function: UnloadAudioStream(stream)
		// Description: Unloads an audio stream and frees buffers
		#extern UnloadAudioStream :: (stream : AudioStream);

		// Function: UpdateAudioStream(stream, data, frameCount)
		// Description: Pushes raw PCM data to the audio stream
		#extern UpdateAudioStream :: (stream : AudioStream, data : *uint8, frameCount : int);

		// Function: IsAudioStreamProcessed(stream)
		// Description: Returns true if any audio stream buffer needs refilling
		#extern IsAudioStreamProcessed :: bool(stream : AudioStream);

		// Function: PlayAudioStream(stream)
		// Description: Plays an audio stream
		#extern PlayAudioStream :: (stream : AudioStream);

		// Function: PauseAudioStream(stream)
		// Description: Pauses an audio stream
		#extern PauseAudioStream :: (stream : AudioStream);

		// Function: ResumeAudioStream(stream)
		// Description: Resumes a paused audio stream
		#extern ResumeAudioStream :: (stream : AudioStream);

		// Function: IsAudioStreamPlaying(stream)
		// Description: Returns true if the audio stream is currently playing
		#extern IsAudioStreamPlaying :: bool(stream : AudioStream);

		// Function: StopAudioStream(stream)
		// Description: Stops an audio stream
		#extern StopAudioStream :: (stream : AudioStream);

		// Function: SetAudioStreamVolume(stream, volume)
		// Description: Sets the volume for an audio stream (1.0 is max)
		#extern SetAudioStreamVolume :: (stream : AudioStream, volume : float);

		// Function: SetAudioStreamPitch(stream, pitch)
		// Description: Sets the pitch for an audio stream (1.0 is base)
		#extern SetAudioStreamPitch :: (stream : AudioStream, pitch : float);

		// Function: SetAudioStreamPan(stream, pan)
		// Description: Sets the pan for an audio stream (0.5 is centered)
		#extern SetAudioStreamPan :: (stream : AudioStream, pan : float);

		// Function: SetAudioStreamBufferSizeDefault(size)
		// Description: Sets the default buffer size for new audio streams
		#extern SetAudioStreamBufferSizeDefault :: (size : int);
	}
}
