		// Description: Draws the outline of a circle sector
		#extern DrawCircleSectorLines :: (center : Vector2, radius : float, startAngle : float, endAngle : float, segments : int, color : Color32);

		// Function: DrawCircleGradient(centerX, centerY, radius, color1, color2)
		// Description: Draws a gradient-filled circle (inner color1, outer color2)
		#extern DrawCircleGradient :: (centerX : int, centerY : int, radius : float, color1 : Color32, color2 : Color32);

		// Function: DrawEllipse(centerX, centerY, radiusH, radiusV, color)
		// Description: Draws a filled ellipse
		#extern DrawEllipse :: (centerX : int, centerY : int, radiusH : float, radiusV : float, color : Color32);

		// Function: DrawEllipseLines(centerX, centerY, radiusH, radiusV, color)
		// Description: Draws the outline of an ellipse
		#extern DrawEllipseLines :: (centerX : int, centerY : int, radiusH : float, radiusV : float, color : Color32);

		// Function: DrawRing(center, innerRadius, outerRadius, startAngle, endAngle, segments, color)
		// Description: Draws a filled ring (annulus sector)
		#extern DrawRing :: (center : Vector2, innerRadius : float, outerRadius : float, startAngle : float, endAngle : float, segments : int, color : Color32);

		// Function: DrawRingLines(center, innerRadius, outerRadius, startAngle, endAngle, segments, color)
		// Description: Draws the outline of a ring
		#extern DrawRingLines :: (center : Vector2, innerRadius : float, outerRadius : float, startAngle : float, endAngle : float, segments : int, color : Color32);

		// Function: DrawRectangle(posX, posY, width, height, color)
		// Description: Draws a filled rectangle
		#extern DrawRectangle :: (posX : int, posY : int, width : int, height : int, color : Color32);

		// Function: DrawRectangleV(position, size, color)
