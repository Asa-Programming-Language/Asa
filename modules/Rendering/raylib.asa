		#extern DrawCircleLinesV :: (center : Vector2, radius : float, color : Color32);

		// Function: DrawCircleSector(center, radius, startAngle, endAngle, segments, color)
		// Description: Draws a filled circle sector (pie slice)
		#extern DrawCircleSector :: (center : Vector2, radius : float, startAngle : float, endAngle : float, segments : int, color : Color32);

