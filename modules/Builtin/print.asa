	//            // Print "2147483648" directly
	//            putchar('2');
	//            n = 147483648;
	//        } 
	//		else 
	//            n = 0-n;
	//    }
	//
	//    if (n >= 10)
	//        printint(n / 10);
	//
	//    putchar((n % 10) + '0');
	//}
}

