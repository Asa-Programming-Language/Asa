	create :: string() #inline; #replaceable; {
		return *(#new string);
	}
	create :: string(c : *char) {
		s : string = string();
	
		len : uint32 = 0;
		for(i : 0..65535){
			if(c[i] == 0){
				len = i;
				break;
			}
		}
		s.address = malloc(len*2);
		s.length = len;
		for(i : 0..(len)){
			s.address[i] = c[i];
		}
		return s;
	}

	//cast :: string(c : *char){
