// Module: Memory
// Description: A builtin module adding useful memory management tools
Memory :: module{
	// Function: malloc(int)
	// Description: | 
	//     Allocates a block of memory
	//
	// Arguments:
	//     b: int64 The number of bytes to allocate
	//
	// Returns: A pointer to the allocated memory block
	#extern malloc::*int(b : int64);

	// Function: free(pointer)
	// Description: |
	//     Frees a block of memory previously allocated by malloc
	//
	// Arguments:
	//     p: Pointer to the memory block to free
	#extern free::(p : *int);
}

// Module: String
// Description: |
//     A builtin module defining the string type
//     See Also: <string>
String :: module{
	//#import Builtin.Operators;

	#import Builtin:Print;
	#import Builtin:Memory;

	// Struct: string
	// Description: |
	//     The string data type
	//
	//     You can declare a string using double quotes:
	//     ```asa
	//     s : string = "Hello, World!";
	//     ```
	string :: struct {
		address : *char;
		length : uint32;
		//tS : testStruct;
		
		// Function: size()
		// Returns: The length in characters of the string
		size :: uint32() {
			return this.length;
		}
		// Function: dump()
		// Description: Prints all of the info related to the string instance to the terminal
		dump :: () {
			print("string: {\"value\":\"");
			print(this.address);
			print("\", length:");
			printint(this.length);
			print("}\n");
		}
		//set::(s : *char){
		//	this.address = s;
		//	for(i : 0..4096){
		//		if(s[i] == 0){
		//			this.length = i;
		//			break;
		//		}
		//	}
		//}

		//operator+ :: string(s : ref string, c : char) #inline {
		//	s.length += 1;
		//	newAddress : *char = malloc(s.length);
		//	for(i : 0..s.length-1){
		//		newAddress[i] = s.address[i];
		//	}
		//	free(s.address);
		//	newAddress[s.length-1] = c;
		//	s.address = newAddress;
		//	return s;
		//}

		//operator+ :: string(s : ref string, otherStr : string) #inline {
		//	oldLength = s.length;
		//	s.length += otherStr.length;
		//	newAddress : *char = malloc(s.length);
		//	for(i : 0..oldLength){
		//		newAddress[i] = s.address[i];
		//	}
		//	free(s.address);
		//	for(i : oldLength..otherStr.length){
		//		newAddress[i] = otherStr.address[i-oldLength];
		//	}
		//	s.address = newAddress;
		//	return s;
		//}

		//operator[] :: char(s : ref string, i : int) #inline {
		//	return s.address[i];
		//}
	}

	// Constructor: string()
	// Description: Creates an empty string
	//
	// Returns: A new empty string instance
	create :: string() #inline; #replaceable; {
		return *(#new string);
	}

	// Constructor: string(*char)
	// Description: Creates a string from a null-terminated character array
	//
	// Arguments:
	//     c: Pointer to a null-terminated character array
	//
	// Returns: A new string containing the characters from the array
	create :: string(c : exact *char) {
		s : string = string();
	
		len : uint32 = 0;
		for(i : 0..65535){
			if(c[i] == 0){
				len = i;
				break;
			}
		}
		s.address = malloc(len*2);
		s.length = len;
		for(i : 0..(len)){
			s.address[i] = c[i];
		}
		return s;
	}

	// Operator: +(string, string)
	// Description: Concatenates two strings together
	//
	// Arguments:
	//     thisStr: The first string
	//     otherStr: The second string
	//
	// Returns: A new string containing the concatenation of both strings
	operator+ :: string(thisStr : exact string, otherStr : exact string){
		newStr : string = string();
	
		len : uint32 = thisStr.length + otherStr.length;
		newStr.address = malloc(len*2);
		newStr.length = len;
		for(i : 0..thisStr.length){
			newStr.address[i] = thisStr[i];
		}
		for(i : 0..otherStr.length){
			// TODO: Currently having an expression within access operator doesnt work,
			//       like: newStr.address[i + thisStr.length]  // Gives error
			newAddr = i + thisStr.length;
			newStr.address[newAddr] = otherStr[i];
		}
		return newStr;
	}

	// Operator: +(string, char)
	// Description: Concatenates a string with a character
	//
	// Arguments:
	//     thisStr: The string
	//     ch: The character to be added
	//
	// Returns: A new string containing the concatenation of the string and character
	operator+ :: string(thisStr : exact string, ch : exact char){
		newStr : string = string();
	
		len : uint32 = thisStr.length + 1;
		newStr.address = malloc(len*2);
		newStr.length = len;
		for(i : 0..thisStr.length){
			newStr.address[i] = thisStr[i];
		}
		newStr.address[thisStr.length] = ch;
		return newStr;
	}

	// Operator: +(*char, *char)
	// Description: Concatenates two null-terminated character arrays
	//
	// Arguments:
	//     thisStr: The first character array
	//     otherStr: The second character array
	//
	// Returns: A pointer to a new character array containing the concatenation
	operator+ :: *char(thisStr : exact *char, otherStr : exact *char){
		newStr : *char = void;
	
		lenA : uint32 = 0;
		lenB : uint32 = 0;
		len : uint32 = 0;
		for(i : 0..65535){
			if(thisStr[i] == 0){
				lenA = i-1;
				break;
			}
		}
		for(i : 0..65535){
			if(otherStr[i] == 0){
				lenB = i;
				break;
			}
		}
		len : uint32 = lenA + lenB;

		newStr = malloc(len*2);
		for(i : 0..lenA){
			newStr[i] = thisStr[i];
		}
		for(i : 0..lenB){
			newStr[i] = otherStr[i];
		}
		return newStr;
	}


	//cast :: *char(s : const ref string){
	//	return s.address;
	//}

	//create :: string(n : int){
	//	s : string = string();
	//    if (n < 0) {
	//		s = s + '-';
	//        // Handle the corner case of INT_MIN
	//        if (n == -2147483648){
	//            // Print "2147483648" directly
	//			s = s + '2';
	//            n = 147483648;
	//        } 
	//		else 
	//            n = 0-n;
	//    }
	//
	//    if (n >= 10){
	//		s = s + string(n/10);
	//	}
	//
	//	s = s + string(n % 10 + '0');
	//}

	// Function: printl(string)
	// Description: A function to overload <printl(*char)> for strings
	printl :: (s : exact string) #hideast {
		printl(s.address);
		return;
	}
}

