
// Module: Casts
// Description: A builtin module defining casts between all of the builtin types
@public:
Casts :: module {
	
	@public:
	@inline:
	{
		// Group: Float Casts
		// Description: Cast operators for converting various types to float

		// Function: float(int)
		// Description: Converts an int to float
		cast:: float(x : const int) {
			return #cast(x, float);
		}
		// Function: float(char)
		// Description: Converts a char to float
		cast:: float(x : const char) {
			return #cast(x, float);
		}
		// Function: float(float)
		// Description: Identity cast for float
		cast:: float(x : const float) {
			return #cast(x, float);
		}
		// Function: float(double)
		// Description: Converts a double to float
		cast:: float(x : const double) {
			return #cast(x, float);
		}
		// Function: float(bool)
		// Description: Converts a bool to float
		cast:: float(x : const bool) {
			return #cast(x, float);
		}

		// Group: Double Casts
		// Description: Cast operators for converting various types to double

		// Function: double(int)
		// Description: Converts an int to double
		cast:: double(x : const int) {
			return #cast(x, double);
		}
		// Function: double(char)
		// Description: Converts a char to double
		cast:: double(x : const char) {
			return #cast(x, double);
		}
		// Function: double(float)
		// Description: Converts a float to double
		cast:: double(x : const float) {
			return #cast(x, double);
		}
		// Function: double(double)
		// Description: Identity cast for double
		cast:: double(x : const double) {
			return #cast(x, double);
		}
		// Function: double(bool)
		// Description: Converts a bool to double
		cast:: double(x : const bool) {
			return #cast(x, double);
		}

		// Group: Int Casts
		// Description: Cast operators for converting various types to signed integers

		// Function: int(float)
		// Description: Converts a float to int, truncating decimal portion
		cast:: int(x : const float) {
			return #cast(x, int);
		}
		// Function: int(double)
		// Description: Converts a double to int, truncating decimal portion
		cast:: int(x : const double) {
			return #cast(x, int);
		}
		// Function: int(int)
		// Description: Identity cast for int
		cast:: int(x : const int) {
			return #cast(x, int);
		}
		// Function: int(uint)
		// Description: Converts an unsigned int to signed int
		cast:: int(x : const uint) {
			return #cast(x, int);
		}
		// Function: int(bool)
		// Description: Converts a bool to int
		cast:: int(x : const bool) {
			return #cast(x, int);
		}

		// Function: uint(float)
		// Description: Converts a float to unsigned int, truncating decimal portion
		cast:: uint(x : const float) {
			return #cast(x, uint);
		}
		// Function: uint(double)
		// Description: Converts a double to unsigned int, truncating decimal portion
		cast:: uint(x : const double) {
			return #cast(x, uint);
		}
		// Function: uint(int)
		// Description: Converts a signed int to unsigned int
		cast:: uint(x : const int) {
			return #cast(x, uint);
		}
		// Function: uint(uint)
		// Identity cast for uint
		cast:: uint(x : const uint) {
			return #cast(x, uint);
		}
		// Function: uint(bool)
		// Description: Converts a bool to unsigned int
		cast:: uint(x : const bool) {
			return #cast(x, uint);
		}

		// Function: uint64(float)
		// Description: Converts a float to 64-bit unsigned int
		cast:: uint64(x : const float) {
			return #cast(x, uint64);
		}
		// Function: uint64(double)
		// Description: Converts a double to 64-bit unsigned int
		cast:: uint64(x : const double) {
			return #cast(x, uint64);
		}
		// Function: uint64(int)
		// Description: Converts an int to 64-bit unsigned int
		cast:: uint64(x : const int) {
			return #cast(x, uint64);
		}
		// Function: uint64(uint)
		// Description: Converts an unsigned int to 64-bit unsigned int
		cast:: uint64(x : const uint) {
			return #cast(x, uint64);
		}
		// Function: uint64(bool)
		// Description: Converts a bool to 64-bit unsigned int
		cast:: uint64(x : const bool) {
			return #cast(x, uint64);
		}

		// Function: int64(float)
		// Description: Converts a float to 64-bit signed int
		cast:: int64(x : const float) {
			return #cast(x, int64);
		}
		// Function: int64(double)
		// Description: Converts a double to 64-bit signed int
		cast:: int64(x : const double) {
			return #cast(x, int64);
		}
		// Function: int64(int)
		// Description: Converts an int to 64-bit signed int
		cast:: int64(x : const int) {
			return #cast(x, int64);
		}
		// Function: int64(uint)
		// Description: Converts an unsigned int to 64-bit signed int
		cast:: int64(x : const uint) {
			return #cast(x, int64);
		}
		// Function: int64(bool)
		// Description: Converts a bool to 64-bit signed int
		cast:: int64(x : const bool) {
			return #cast(x, int64);
		}

		// Function: uint16(float)
		// Description: Converts a float to 16-bit unsigned int
		cast:: uint16(x : const float) {
			return #cast(x, uint16);
		}
		// Function: uint16(double)
		// Description: Converts a double to 16-bit unsigned int
		cast:: uint16(x : const double) {
			return #cast(x, uint16);
		}
		// Function: uint16(int)
		// Description: Converts an int to 16-bit unsigned int
		cast:: uint16(x : const int) {
			return #cast(x, uint16);
		}
		// Function: uint16(uint)
		// Description: Converts an unsigned int to 16-bit unsigned int
		cast:: uint16(x : const uint) {
			return #cast(x, uint16);
		}
		// Function: uint16(bool)
		// Description: Converts a bool to 16-bit unsigned int
		cast:: uint16(x : const bool) {
			return #cast(x, uint16);
		}

		// Function: uint8(float)
		// Description: Converts a float to 8-bit unsigned int
		cast:: uint8(x : const float) {
			return #cast(x, uint8);
		}
		// Function: uint8(double)
		// Description: Converts a double to 8-bit unsigned int
		cast:: uint8(x : const double) {
			return #cast(x, uint8);
		}
		// Function: uint8(int)
		// Description: Converts an int to 8-bit unsigned int
		cast:: uint8(x : const int) {
			return #cast(x, uint8);
		}
		// Function: uint8(uint)
		// Description: Converts an unsigned int to 8-bit unsigned int
		cast:: uint8(x : const uint) {
			return #cast(x, uint8);
		}
		// Function: uint8(bool)
		// Description: Converts a bool to 8-bit unsigned int
		cast:: uint8(x : const bool) {
			return #cast(x, uint8);
		}

		// Group: Char Casts
		// Description: Cast operators for converting integer types to char

		// Function: char(int)
		// Description: Converts an int to char (truncates to 8 bits)
		cast:: char(x : const int) {
			return #cast(x, char);
		}
		// Function: char(int64)
		// Description: Converts an int64 to char (truncates to 8 bits)
		cast:: char(x : const int64) {
			return #cast(x, char);
		}
		// Function: char(int16)
		// Description: Converts an int16 to char (truncates to 8 bits)
		cast:: char(x : const int16) {
			return #cast(x, char);
		}
		// Function: char(uint)
		// Description: Converts a uint to char (truncates to 8 bits)
		cast:: char(x : const uint) {
			return #cast(x, char);
		}

		// Function: int(int64)
		// Description: Converts an int64 to int (truncates to 32 bits)
		cast:: int(x : const int64) {
			return #cast(x, int);
		}

		// Function: uint64(int64)
		// Description: Reinterprets an int64 as uint64
		cast:: uint64(x : const int64) {
			return #cast(x, uint64);
		}

		// Function: int64(uint64)
		// Description: Reinterprets a uint64 as int64
		cast:: int64(x : const uint64) {
			return #cast(x, int64);
		}

		// Group: Pointer Casts
		// Description: Cast operators for converting pointers to integer types

		// Function: int64(*char)
		// Description: Converts a *char pointer to int64
		cast:: int64(x : const *char) {
			return #cast(x, int64);
		}
	}
}
