
// Module: Array
// Description: Contains the <array> and <static_array> data type
@hideast:
@public:
Array :: module{

    #if (#getflag(COMPILERDEBUG), {
        #set_attribute(Array, "hideast", false);
    });

    #import Builtin.CompilerDirectives;
    #import Builtin.Memory;

    // Struct: array
    // Description: A generic array type
    array<T : type> :: struct{
        address : *T = ?;
        length : int = 0;
        elementSize : const int = #sizeof(T);
    }

    // Constructor: array<T, N>()
    // Description: Creates an instance of an array of the specified type `T` and given length `N`
    create<T : type, N : uint32> :: array<T>(){
        o : array<T> = default;
        o.address = malloc(#sizeof(T) * N);
        o.length = N;
        return o;
    }

    // Operator: [](array, int)
    // Description: Indexes the item of the array at the given index
    //
    // Arguments:
    //     a: The array
    //     i: The index of the item
    //
    // Returns: A reference to the item at the given index
    @tracked_caller:
    array<T : type>.operator([]) :: ref T(a : const ref array<T>, i : int){
        
        #if(#getflag(NO_RUNTIME_SAFETY_CHECKS), {
            #set_attribute(#func_ast, "tracked_caller", false);
        });
        #else({
            if(i >= a.length){
                throw_caller "Array index out of range";
            }
        });

        return a.address[i];
    }


    // Struct: static_array
    // Description: A generic constant array type
    static_array<T : type, N : uint32> :: struct{
        address : *T;
        length : int;
    }

    // Function: static_array<T, N>()
    // Description: Creates an instance of a static array of the specified type `T` and given length `N`
    create<T : type, N : uint32> :: static_array<T, N>(){
        o : static_array<T, N> = default;
        o.address = malloc(#sizeof(T) * N);
        o.length = N;
        return o;
    }

}
