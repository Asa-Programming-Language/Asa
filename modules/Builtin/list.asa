// Module: List
// Description: Contains the <list> data type
@hideast:
@public:
List :: module{

    #if (#getflag(COMPILERDEBUG), {
        #set_attribute(List, "hideast", false);
    });

    #import Builtin.Print;
    #import Builtin.Memory;

    // Struct: list
    // Description: A dynamically allocated list structure
    @public:
    list<T : type> :: struct{

        address : *T = ?;
        length : uint32 = 0;
        allocatedMemory : uint32 = 1;
        
        // Function: size()
        // Description: Returns the number of elements in the list
        // Returns: An integer representing the number of elements in the list
        @inline:
        size :: uint32() {
            return this.length;
        }

        // Function: append(x)
        // Description: |
        //     Append an element to the end of the list like:
        //     ```asa
        //     list.append(element)
        //     ```
        // Returns: The element that was just added
        append :: ref T(val : T){
            this.length += 1;
            requiredBytes = this.length * #sizeof(T);
            // Reallocate memory, doubling amount each time so it isn't copied and re-allocated
            // every time an operation occurs. This is like vector in C++
            if (requiredBytes >= this.allocatedMemory){
                this.allocatedMemory *= 2;
                newAddress = malloc(requiredBytes);
                for(i in 0..this.length-1){
                    newAddress[i] = this.address[i];
                    //newAddress[i] = T(this.address[i]);
                }
                this.address = newAddress;
            }
            this.address[this.length-1] = val;
            return this.address[this.length-1];
        }

        // Function: at(i)
        // Description: |
        //     Get an element of the list at the given index
        // Returns: The element that was just added
        @tracked_caller:
        @inline:
        at :: ref T(i : int){
            #if(#getflag(NO_RUNTIME_SAFETY_CHECKS), {
                #set_attribute(#func_ast, "tracked_caller", false);
            });
            #else({
                if(i >= this.length){
                    throw_caller "List index out of range";
                }
            });

            return this.address[i];
        }

        // Operator: [](list, int)
        // Description: Indexes the item of the list at the given index
        //
        // Arguments:
        //     l: The list
        //     i: The index of the item
        //
        // Returns: A reference to the item at the given index
        @tracked_caller:
        @inline:
        operator([]) :: ref T(l : const ref list<T>, i : int){
            #if(#getflag(NO_RUNTIME_SAFETY_CHECKS), {
                #set_attribute(#func_ast, "tracked_caller", false);
            });
            #else({
                if(i >= l.length){
                    throw_caller "List index out of range";
                }
            });

            return l.address[i];
        }
    }

    // Constructor: list<T>()
    // Description: Creates a new empty list of the specified type `T`
    @inline:
    create<T : type> :: list<T>(){
        l : list<T> = default;
        return l;
    }

    // Constructor: list<T>(array)
    // Description: Creates a new list of the specified type `T` from an array of the same type
    create<T : type> :: list<T>(a : array<T>){
        l : list<T> = default;
        for(i in 0..a.length){
            l.append(a[i]);
        }
        return l;
    }

    //// Constructor: range(list)
    //// Description: |
    ////     Gets the <range> object representing the list at the time of calling
    ////     Example:
    ////     ```asa
    ////     x : list = list<int>(1, 2, 3, 4);
    ////     range(x);
    ////     ```
    //// Returns: A range object
    //@public:
    //create :: range(l : list){
    //  newRange = range<l.TYPE>();
    //  //newRange = range<itemType = l.TYPE>();
    //  iter : iterator = iterator();
    //  newRange.min = {return startVal;};
    //  newRange.max = {return endVal;};
    //  newRange.next = iter.next;
    //}

    //operator(:) :: iterator(item ref : ELEMENT_TYPE, l : list)
    //  #mod ELEMENT_TYPE = #run(typeof(l));
    //{
    //  newIter : iterator = iterator<ELEMENT_TYPE = ELEMENT_TYPE>(0, l.length);
    //  return newIter;
    //}

    range :: struct{
        start : int = 0;
        end   : int = 0;
    }

    operator(..) :: range(l : int, r : int){
        o : range = range();
        o.start = l;
        o.end = r;
        return o;
    }
}
