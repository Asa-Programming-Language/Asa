    //  return l;
    //}

    //// Function: range(list)
    //// Description: |
    ////     Gets the <range> object representing the list at the time of calling
    ////     Example:
    ////     ```asa
    ////     x : list = list<int>(1, 2, 3, 4);
    ////     range(x);
    ////     ```
    //// Returns: A range object
    //@public:
    //create :: range(l : list){
    //  newRange = range<l.TYPE>();
    //  //newRange = range<itemType = l.TYPE>();
    //  iter : iterator = iterator();
    //  newRange.min = {return startVal;};
    //  newRange.max = {return endVal;};
    //  newRange.next = iter.next;
    //}

    //operator: :: iterator(item ref : ELEMENT_TYPE, l : list)
    //  #mod ELEMENT_TYPE = #run(typeof(l));
    //{
    //  newIter : iterator = iterator<ELEMENT_TYPE = ELEMENT_TYPE>(0, l.length);
    //  return newIter;
    //}

    range :: struct{
        start : int = 0;
        end   : int = 0;
    }

    operator.. :: range(l : int, r : int){
        o : range = range();
        o.start = l;
        o.end = r;
        return o;
    }
}
